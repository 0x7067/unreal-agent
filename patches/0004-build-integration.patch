@@ -54,16 +60,33 @@ dockers_v2:
 
 release:
   github:
-    owner: unreallabsai
+    owner: 0x7067
     name: unreal-agent
   name_template: '{{ .Tag }}'
+  # Prepended to the GitHub release body for the next fork tag.
+  header: |
+    `unreal-agent-runner review` is the review command. The separate `unreal-review` binary is gone.
+
+    Review uses the runner's provider selection. An empty `UNREAL_HARNESS_LLM_PROVIDER` defaults to `openai`.
+    If you only have `OPENROUTER_API_KEY`, set `UNREAL_HARNESS_LLM_PROVIDER=openrouter`.
 
 homebrew_casks:
+  # Fork: generate the cask locally but do not push unreallabsai/homebrew-tap
+  # (that needs HOMEBREW_TAP_DEPLOY_KEY). Casks have no disable field.
   - name: unreal-agent
+    skip_upload: true
     ids: [unreal-agent]
     binaries: [unreal-agent-runner, unreal-agent-tui]
     homepage: https://github.com/unreallabsai/unreal-agent
-    description: Unreal Agent terminal interface and headless runner
+    description: Unreal Agent terminal interface and headless runner with a review command
+    caveats: |
+      This cask installs unreal-agent-runner and unreal-agent-tui.
+      unreal-agent-runner review reviews a git diff; run unreal-agent-runner review help.
+      Review uses the runner's provider selection. An empty UNREAL_HARNESS_LLM_PROVIDER defaults to openai.
+      If you only have OPENROUTER_API_KEY, set UNREAL_HARNESS_LLM_PROVIDER=openrouter.
+      A missing key says "UNREAL_HARNESS_LLM_API_KEY or OPENAI_API_KEY must be set" for that default,
+      or UNREAL_HARNESS_LLM_API_KEY and the selected provider's own variable.
+      ollama needs no API key. openai-codex reports its own credential errors.
     # Install the TUI aliases and clear quarantine only for this unsigned package.
     custom_block: |
       binary "unreal-agent-tui", target: "unreal-agent"
