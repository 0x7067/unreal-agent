index ca4c3f6..d622126 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -5,6 +5,7 @@ RUN go mod download
 COPY cmd/ cmd/
 COPY harness/ harness/
 COPY internal/ internal/
