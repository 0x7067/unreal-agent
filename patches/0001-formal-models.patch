--- /dev/null
+++ b/tools/formal/apienums/check.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""Check 476 actual Go ASTs against frozen declaration policy; refresh SOURCE only."""
+import argparse
+import difflib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+DEST = Path('tools/formal/models/implementation/api-enums')
+COUNTS = {'internal/openaiapi/types.gen.go': 279,
+          'internal/anthropicapi/types.gen.go': 197}
+
+
+def safe(root, rel):
+    path = root / rel
+    if path.resolve() != path.absolute():
+        raise RuntimeError(f'symlink/escape not admitted: {path}')
+    return path
+
+
+def check_environment(root):
+    # Share the same canonical module/workspace/overlay policy as gosource.
+    # Import trusted checker code from this checkout, never from --root fixtures.
+    path = ROOT / 'tools/formal/gosource/check.py'
+    spec = importlib.util.spec_from_file_location('apienums_gosource_environment', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    metadata = module.check_environment(root)
+    module.check_source_context(root, list(COUNTS))
+    for relative in ('internal/go.mod', 'internal/openaiapi/go.mod',
+                     'internal/anthropicapi/go.mod'):
+        nested = root / relative
+        if nested.exists() or nested.is_symlink():
+            raise RuntimeError(f'nested module not admitted for API enum sources: {relative}')
+    return metadata
+
+
+def byte_list(values):
+    return '[' + ', '.join(f'{n}n' for n in values) + ']'
+
+
+def expression(node):
+    kind = node['kind']
+    if kind == 'bool':
+        return 'M.Truth{' + ('True{}' if node.get('value') else 'False{}') + '}'
+    if kind == 'eq':
+        return f'M.Same{{M.First{{}}, {byte_list(node.get("bytes", []))}}}'
+    names = {'or': 'Either', 'if': 'Branch'}
+    return 'M.' + names[kind] + '{' + ', '.join(map(expression, node['args'])) + '}'
+
+
+def source_text(records):
+    text = ('# Actual restricted Go AST. Generated; explicit --refresh updates SOURCE only.\n'
+            'import Base\nimport ../enums/semantics.bend as M\n\n')
+    for r in records:
+        text += f'# {r["file"]}: ({r["receiver"]}).Valid\n'
+        text += f'def {r["id"]}_ast() -> M.Expr:\n  {expression(r["ast"])}\n\n'
+        text += (f'def {r["id"]}(+x: List<&2, Nat>) -> Bool:\n'
+                 f'  M.eval({r["id"]}_ast(), x, [])\n\n')
+    return text
+
+
+def policy_text(policies):
+    text = ('# FROZEN declaration-derived policy. Independent of Valid method bodies.\n'
+            '# Policy edits require explicit human review; --refresh NEVER changes this file.\n'
+            'import Base\nimport ./helpers.bend as H\n\n')
+    for p in policies:
+        values = '[' + ', '.join(byte_list(c['bytes']) for c in p['constants']) + ']'
+        text += (f'def {p["id"]}_constants() -> List<&2, List<&2, Nat>>:\n  {values}\n\n'
+                 f'def {p["id"]}(+x: List<&2, Nat>) -> Bool:\n'
+                 f'  H.members({p["id"]}_constants(), x)\n\n')
+    return text
+
+
+def extract(root):
+    env = dict(os.environ, GOTOOLCHAIN='local', GOWORK='off', GOFLAGS='',
+               GOPROXY='off', GOSUMDB='off')
+    run = subprocess.run(['go', 'run', 'tools/formal/apienums/extract.go', str(root)],
+                         cwd=ROOT, env=env, capture_output=True, text=True, timeout=120)
+    if run.returncode:
+        raise RuntimeError(run.stderr.strip() or 'Go AST extraction failed')
+    return json.loads(run.stdout)
+
+
+def check(root, refresh=False):
+    root = root.absolute()
+    if root.resolve() != root:
+        raise RuntimeError('symlink root not admitted')
+    module_metadata = check_environment(root)
+    data = extract(root)
+    records = data['records']
+    for record in records:
+        record['module_metadata_sha256'] = module_metadata
+    counts = {file: sum(r['file'] == file for r in records) for file in COUNTS}
+    if counts != COUNTS or len(records) != sum(COUNTS.values()):
+        raise RuntimeError(f'explicit inventory mismatch: expected {COUNTS}, found {counts}, total {len(records)}')
+    if len({r['id'] for r in records}) != len(records):
+        raise RuntimeError('duplicate method IDs')
+    frozen = json.loads(safe(root, DEST / 'policy.json').read_text())
+    if data['policy'] != frozen:
+        raise RuntimeError('DECLARATION POLICY MISMATCH: enum types/constants changed; '
+                           '--refresh cannot change independent policy; explicit human policy review required')
+    if safe(root, DEST / 'POLICY.bend').read_text() != policy_text(frozen):
+        raise RuntimeError('POLICY.bend does not match frozen independent policy.json')
+    outputs = {'SOURCE.bend': source_text(records),
+               'source_ast.json': json.dumps(records, indent=2) + '\n'}
+    drift = []
+    for name, expected in outputs.items():
+        path = safe(root, DEST / name)
+        actual = path.read_text() if path.exists() else ''
+        if actual == expected:
+            continue
+        if refresh:
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(expected)
+        else:
+            drift.append(name)
+            # Avoid megabytes of diagnostic output from whole-file source digests.
+            delta = ''.join(difflib.unified_diff(actual.splitlines(True), expected.splitlines(True),
+                            fromfile=str(path), tofile='fresh actual Go AST'))
+            print(delta[:12000], file=sys.stderr)
+    if drift:
+        raise RuntimeError('source extraction drift: ' + ', '.join(drift) +
+                           '; review changes then --refresh (SOURCE only); Bend must still prove frozen laws')
+    return len(records)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--root', type=Path, default=ROOT)
+    ap.add_argument('--refresh', action='store_true', help='update SOURCE artifacts only, never policy/laws/proofs')
+    args = ap.parse_args()
+    try:
+        count = check(args.root, args.refresh)
+    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as exc:
+        print(f'apienums: {exc}', file=sys.stderr)
+        return 1
+    print(f'apienums: {count} source-linked restricted Valid methods, independent declaration policy unchanged')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/tools/formal/apienums/extract.go b/tools/formal/apienums/extract.go
new file mode 100644
index 0000000..3813e05
--- /dev/null
+++ b/tools/formal/apienums/extract.go
@@ -0,0 +1,389 @@
+// Command extract is a fail-closed Go-AST frontend for generated enum Valid.
+// The parser, type checker, and this deliberately restricted translation are TCB.
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/constant"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type node struct {
+	Kind  string  `json:"kind"`
+	Value bool    `json:"value,omitempty"`
+	Bytes []int   `json:"bytes,omitempty"`
+	Args  []*node `json:"args,omitempty"`
+}
+type declaration struct {
+	Name  string `json:"name"`
+	Bytes []int  `json:"bytes"`
+}
+type policy struct {
+	ID        string        `json:"id"`
+	File      string        `json:"file"`
+	Receiver  string        `json:"receiver"`
+	Constants []declaration `json:"constants"`
+}
+type dependency struct {
+	File string `json:"file"`
+	SHA  string `json:"source_sha256"`
+}
+type record struct {
+	ID             string       `json:"id"`
+	File           string       `json:"file"`
+	Name           string       `json:"name"`
+	Receiver       string       `json:"receiver"`
+	SHA            string       `json:"source_sha256"`
+	Law            string       `json:"law"`
+	Classification string       `json:"classification"`
+	AST            *node        `json:"ast"`
+	Dependencies   []dependency `json:"dependencies"`
+}
+type output struct {
+	Records []record `json:"records"`
+	Policy  []policy `json:"policy"`
+}
+
+func fail(f string, args ...any) { panic(fmt.Sprintf(f, args...)) }
+func safe(root, rel string) string {
+	p := filepath.Join(root, rel)
+	actual, err := filepath.EvalSymlinks(p)
+	if err != nil {
+		panic(err)
+	}
+	if actual != p {
+		fail("symlink/escape not admitted: %s", p)
+	}
+	return p
+}
+func boolNode(v bool) *node { return &node{Kind: "bool", Value: v} }
+func expr(x ast.Expr, receiver string, want types.Type, info *types.Info) *node {
+	switch n := x.(type) {
+	case *ast.ParenExpr:
+		return expr(n.X, receiver, want, info)
+	case *ast.Ident:
+		o := info.Uses[n]
+		c, ok := o.(*types.Const)
+		if !ok || c.Parent() != types.Universe || c.Val().Kind() != constant.Bool {
+			fail("return must use predeclared true/false, got %s", n.Name)
+		}
+		return boolNode(constant.BoolVal(c.Val()))
+	default:
+		fail("unsupported return expression %T", x)
+	}
+	return nil
+}
+func returned(stmts []ast.Stmt, receiver string, want types.Type, info *types.Info) *node {
+	if len(stmts) != 1 {
+		fail("case must contain exactly one return (no assignment, fallthrough, calls)")
+	}
+	r, ok := stmts[0].(*ast.ReturnStmt)
+	if !ok || len(r.Results) != 1 {
+		fail("case must contain one single-value return")
+	}
+	return expr(r.Results[0], receiver, want, info)
+}
+func method(fn *ast.FuncDecl, info *types.Info) (string, types.Type, string) {
+	if fn.Recv == nil || len(fn.Recv.List) != 1 || len(fn.Recv.List[0].Names) != 1 {
+		fail("expected one named value receiver")
+	}
+	field := fn.Recv.List[0]
+	id, ok := field.Type.(*ast.Ident)
+	if !ok {
+		fail("pointer/generic/non-name receiver unsupported")
+	}
+	recv := info.Defs[field.Names[0]]
+	if recv == nil {
+		fail("missing checked receiver")
+	}
+	typ := recv.Type()
+	named, ok := typ.(*types.Named)
+	if !ok || named.Obj().Name() != id.Name {
+		fail("receiver must be a defined named type")
+	}
+	basic, ok := typ.Underlying().(*types.Basic)
+	if !ok || basic.Kind() != types.String {
+		fail("receiver %s not string", id.Name)
+	}
+	if fn.Type.TypeParams != nil || (fn.Type.Params != nil && len(fn.Type.Params.List) != 0) || fn.Type.Results == nil || len(fn.Type.Results.List) != 1 {
+		fail("Valid signature must be () bool")
+	}
+	ret := fn.Type.Results.List[0]
+	retID, ok := ret.Type.(*ast.Ident)
+	if !ok || retID.Name != "bool" || info.Uses[retID] != types.Universe.Lookup("bool") || len(ret.Names) != 0 {
+		fail("Valid requires unnamed predeclared bool result")
+	}
+	return field.Names[0].Name, typ, id.Name
+}
+func body(fn *ast.FuncDecl, recv string, typ types.Type, info *types.Info) *node {
+	if fn.Body == nil || len(fn.Body.List) != 1 {
+		fail("Valid body must be exactly one switch")
+	}
+	sw, ok := fn.Body.List[0].(*ast.SwitchStmt)
+	if !ok || sw.Init != nil || sw.Tag == nil {
+		fail("expected tagged switch without init")
+	}
+	tag, ok := sw.Tag.(*ast.Ident)
+	if !ok || tag.Name != recv || info.Uses[tag] != info.Defs[fn.Recv.List[0].Names[0]] {
+		fail("switch tag must be the exact receiver binding")
+	}
+	var guards []*node
+	var results []*node
+	var fallback *node
+	for _, stmt := range sw.Body.List {
+		c, ok := stmt.(*ast.CaseClause)
+		if !ok {
+			fail("unsupported switch clause %T", stmt)
+		}
+		result := returned(c.Body, recv, typ, info)
+		if c.List == nil {
+			if fallback != nil {
+				fail("multiple default cases")
+			}
+			fallback = result
+			continue
+		}
+		var guard *node
+		for _, test := range c.List {
+			id, ok := test.(*ast.Ident)
+			if !ok {
+				fail("case requires declared enum constant, no calls/literals/expressions")
+			}
+			con, ok := info.Uses[id].(*types.Const)
+			if !ok || !types.Identical(con.Type(), typ) || con.Val().Kind() != constant.String {
+				fail("case constant %s not declared at receiver type", id.Name)
+			}
+			s := constant.StringVal(con.Val())
+			bytes := make([]int, len(s))
+			for i, b := range []byte(s) {
+				bytes[i] = int(b)
+			}
+			eq := &node{Kind: "eq", Bytes: bytes}
+			if guard == nil {
+				guard = eq
+			} else {
+				guard = &node{Kind: "or", Args: []*node{guard, eq}}
+			}
+		}
+		guards = append(guards, guard)
+		results = append(results, result)
+	}
+	if fallback == nil {
+		fail("switch must have explicit default return")
+	}
+	for i := len(guards) - 1; i >= 0; i-- {
+		fallback = &node{Kind: "if", Args: []*node{guards[i], results[i], fallback}}
+	}
+	return fallback
+}
+func extract(root, pkg string) ([]record, []policy) {
+	dir := safe(root, "internal/"+pkg)
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		panic(err)
+	}
+	fs := token.NewFileSet()
+	var methods []*ast.FuncDecl
+	paths := map[*ast.FuncDecl]string{}
+	typeSpecs := map[string]*ast.TypeSpec{}
+	var consts []ast.Decl
+	var allTypes []*ast.TypeSpec
+	var dependencies []dependency
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") || strings.HasSuffix(entry.Name(), "_test.go") {
+			continue
+		}
+		rel := "internal/" + pkg + "/" + entry.Name()
+		path := safe(root, rel)
+		content, err := os.ReadFile(path)
+		if err != nil {
+			panic(err)
+		}
+		sum := sha256.Sum256(content)
+		dependencies = append(dependencies, dependency{File: rel, SHA: hex.EncodeToString(sum[:])})
+		f, err := parser.ParseFile(fs, path, content, parser.ParseComments|parser.AllErrors)
+		if err != nil {
+			panic(err)
+		}
+		if f.Name.Name != pkg {
+			fail("unexpected package in %s", rel)
+		}
+		// Import bindings are file scoped but can also hide the predeclared types
+		// and literals on which this restricted bridge depends. Dot imports have
+		// unbounded unqualified bindings, so never admit them.
+		for _, im := range f.Imports {
+			path, err := strconv.Unquote(im.Path.Value)
+			if err != nil {
+				panic(err)
+			}
+			name := filepath.Base(path)
+			if im.Name != nil {
+				name = im.Name.Name
+			}
+			if name == "." || name == "bool" || name == "string" || name == "true" || name == "false" || path == "C" {
+				fail("unsupported import binding %s in %s", name, rel)
+			}
+		}
+		for _, g := range f.Comments {
+			for _, c := range g.List {
+				if strings.HasPrefix(c.Text, "//go:build") || strings.HasPrefix(c.Text, "// +build") {
+					fail("build constraints unsupported in %s", rel)
+				}
+				if strings.HasPrefix(c.Text, "//go:") && strings.Fields(c.Text)[0] != "//go:generate" {
+					fail("compiler directives unsupported in %s: %s", rel, c.Text)
+				}
+			}
+		}
+		for _, d := range f.Decls {
+			switch n := d.(type) {
+			case *ast.FuncDecl:
+				if n.Name.Name == "Valid" {
+					if entry.Name() != "types.gen.go" {
+						fail("Valid outside inventoried generated source: %s", rel)
+					}
+					methods = append(methods, n)
+					paths[n] = rel
+				}
+				if n.Recv == nil && (n.Name.Name == "bool" || n.Name.Name == "string" || n.Name.Name == "true" || n.Name.Name == "false") {
+					fail("predeclared name shadowed")
+				}
+			case *ast.GenDecl:
+				if n.Tok == token.CONST {
+					consts = append(consts, n)
+				}
+				for _, sp := range n.Specs {
+					switch s := sp.(type) {
+					case *ast.TypeSpec:
+						if typeSpecs[s.Name.Name] != nil {
+							fail("duplicate type %s", s.Name.Name)
+						}
+						typeSpecs[s.Name.Name] = s
+						allTypes = append(allTypes, s)
+						if s.Name.Name == "bool" || s.Name.Name == "string" || s.Name.Name == "true" || s.Name.Name == "false" {
+							fail("predeclared type shadowed")
+						}
+					case *ast.ValueSpec:
+						for _, id := range s.Names {
+							if id.Name == "bool" || id.Name == "string" || id.Name == "true" || id.Name == "false" {
+								fail("predeclared value shadowed")
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	// Check all constants together with exactly the named string receiver declarations.
+	// go/types resolves values, aliases, implicit const specs and Go string escapes;
+	// unresolved/nonconstant expressions and duplicate switch values fail closed.
+	selected := map[string]bool{}
+	synthetic := &ast.File{Name: ast.NewIdent(pkg)}
+	for _, fn := range methods {
+		if fn.Recv == nil || len(fn.Recv.List) != 1 {
+			fail("Valid must be method")
+		}
+		id, ok := fn.Recv.List[0].Type.(*ast.Ident)
+		if !ok {
+			fail("pointer/generic receiver unsupported")
+		}
+		t := typeSpecs[id.Name]
+		if t == nil {
+			fail("missing receiver type %s", id.Name)
+		}
+		base, ok := t.Type.(*ast.Ident)
+		if !ok || base.Name != "string" || t.Assign.IsValid() || t.TypeParams != nil {
+			fail("receiver %s must be defined directly over string, no aliases", id.Name)
+		}
+		selected[id.Name] = true
+	}
+	for _, t := range allTypes {
+		if selected[t.Name.Name] {
+			synthetic.Decls = append(synthetic.Decls, &ast.GenDecl{Tok: token.TYPE, Specs: []ast.Spec{t}})
+		}
+	}
+	synthetic.Decls = append(synthetic.Decls, consts...)
+	for _, fn := range methods {
+		synthetic.Decls = append(synthetic.Decls, fn)
+	}
+	info := &types.Info{Defs: map[*ast.Ident]types.Object{}, Uses: map[*ast.Ident]types.Object{}}
+	config := types.Config{}
+	_, err = config.Check("restricted/"+pkg, fs, []*ast.File{synthetic}, info)
+	if err != nil {
+		fail("restricted type/constant validation: %v", err)
+	}
+	var records []record
+	var policies []policy
+	for _, fn := range methods {
+		recv, typ, name := method(fn, info)
+		id := pkg + "_" + name + "_Valid"
+		rel := paths[fn]
+		content, err := os.ReadFile(safe(root, rel))
+		if err != nil {
+			panic(err)
+		}
+		sum := sha256.Sum256(content)
+		r := record{ID: id, File: rel, Name: "Valid", Receiver: name, SHA: hex.EncodeToString(sum[:]), Law: id + "_matches_policy", Classification: "source-linked-restricted-semantics", AST: body(fn, recv, typ, info), Dependencies: dependencies}
+		p := policy{ID: id, File: rel, Receiver: name, Constants: []declaration{}}
+		// Independent policy inventory: only declarations, never the method body.
+		for ident, obj := range info.Defs {
+			c, ok := obj.(*types.Const)
+			if !ok || !types.Identical(c.Type(), typ) {
+				continue
+			}
+			if c.Val().Kind() != constant.String {
+				fail("nonstring enum constant")
+			}
+			s := constant.StringVal(c.Val())
+			bytes := make([]int, len(s))
+			for i, b := range []byte(s) {
+				bytes[i] = int(b)
+			}
+			p.Constants = append(p.Constants, declaration{Name: ident.Name, Bytes: bytes})
+		}
+		// Canonical declared-name order, independent of map iteration and method bodies.
+		sort.Slice(p.Constants, func(i, j int) bool { return p.Constants[i].Name < p.Constants[j].Name })
+		if len(p.Constants) == 0 {
+			fail("enum %s has no declarations", name)
+		}
+		records = append(records, r)
+		policies = append(policies, p)
+	}
+	return records, policies
+}
+func main() {
+	defer func() {
+		if r := recover(); r != nil {
+			fmt.Fprintln(os.Stderr, "apienums extract:", r)
+			os.Exit(1)
+		}
+	}()
+	if len(os.Args) != 2 {
+		fail("usage: extract ROOT")
+	}
+	root, err := filepath.Abs(os.Args[1])
+	if err != nil {
+		panic(err)
+	}
+	out := output{Records: []record{}, Policy: []policy{}}
+	for _, pkg := range []string{"openaiapi", "anthropicapi"} {
+		r, p := extract(root, pkg)
+		out.Records = append(out.Records, r...)
+		out.Policy = append(out.Policy, p...)
+	}
+	enc := json.NewEncoder(os.Stdout)
+	enc.SetIndent("", "  ")
+	if err := enc.Encode(out); err != nil {
+		panic(err)
+	}
+}
diff --git a/tools/formal/apienums/test.py b/tools/formal/apienums/test.py
new file mode 100644
index 0000000..a8319f1
--- /dev/null
+++ b/tools/formal/apienums/test.py
@@ -0,0 +1,307 @@
+#!/usr/bin/env python3
+"""stdlib fail-closed frontend and real-Bend semantic mutation regression tests."""
+from contextlib import redirect_stderr
+import hashlib
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location('apienums_check', Path(__file__).with_name('check.py'))
+checker = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(checker)
+ROOT = checker.ROOT
+DEST = checker.DEST
+FILE = Path('internal/openaiapi/types.gen.go')
+ENV = dict(os.environ, GOTOOLCHAIN='local', GOPROXY='off', GOSUMDB='off', BEND_NO_UPDATE='1')
+
+
+class APIEnums(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.build_dir = tempfile.TemporaryDirectory(prefix='apienums binary ')
+        cls.binary = Path(cls.build_dir.name) / 'extract'
+        subprocess.run(['go', 'build', '-o', str(cls.binary), './tools/formal/apienums/extract.go'],
+                       cwd=ROOT, env=ENV, capture_output=True, text=True, check=True, timeout=120)
+        cls.bend = Path(os.environ.get('BEND', str(Path.home() / '.bend/bin/bend')))
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.build_dir.cleanup()
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='apienums mutation ')
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        shutil.copyfile(ROOT / "go.mod", self.root / "go.mod")
+        for pkg in ('openaiapi', 'anthropicapi'):
+            directory = self.root / 'internal' / pkg
+            directory.mkdir(parents=True)
+            for name in ('types.gen.go', 'generate.go'):
+                shutil.copyfile(ROOT / directory.relative_to(self.root) / name, directory / name)
+        shutil.copytree(ROOT / DEST, self.root / DEST)
+        semantics = Path('tools/formal/models/implementation/enums/semantics.bend')
+        (self.root / semantics).parent.mkdir(parents=True)
+        shutil.copyfile(ROOT / semantics, self.root / semantics)
+
+    def extract(self, root=None):
+        result = subprocess.run([str(self.binary), str(root or self.root)], env=ENV,
+                                capture_output=True, text=True, timeout=60)
+        if result.returncode:
+            raise RuntimeError(result.stderr)
+        return json.loads(result.stdout)
+
+    def check(self, refresh=False):
+        with patch.object(checker, 'extract', self.extract), redirect_stderr(io.StringIO()):
+            return checker.check(self.root, refresh)
+
+    def replace(self, old, new, count=1):
+        path = self.root / FILE
+        text = path.read_text()
+        self.assertIn(old, text)
+        path.write_text(text.replace(old, new, count))
+
+    def bend_check(self, succeeds):
+        if not self.bend.is_file():
+            self.skipTest('pinned Bend unavailable; frontend mutation checks still run')
+        result = subprocess.run([str(self.bend), str(self.root / DEST / 'PROOF.bend'), '--check-only'],
+                                env=ENV, capture_output=True, text=True, timeout=120)
+        output = result.stdout + result.stderr
+        if succeeds:
+            self.assertEqual(result.returncode, 0, output[-8000:])
+            self.assertIn('All terms check.', output)
+        else:
+            self.assertTrue(result.returncode != 0 or 'All terms check.' not in output,
+                            'semantically wrong source unexpectedly proved')
+            self.assertTrue(any(word in output.lower() for word in ('mismatch', 'fail', 'error')),
+                            output[-8000:])
+
+    def test_inventory_and_real_proof(self):
+        self.assertEqual(self.check(), 476)
+        data = self.extract()
+        self.assertEqual(len(data['policy']), 476)
+        self.assertEqual(sum(r['file'] == str(FILE) for r in data['records']), 279)
+        self.assertTrue(all(r['classification'] == 'source-linked-restricted-semantics'
+                            for r in data['records']))
+        self.bend_check(True)
+
+    def test_default_true_freshness_then_refreshed_bend_failure(self):
+        protected = {name: hashlib.sha256((self.root / DEST / name).read_bytes()).digest()
+                     for name in ('policy.json', 'POLICY.bend', 'LAWS.bend', 'PROOF.bend')}
+        self.replace('default:\n\t\treturn false', 'default:\n\t\treturn true')
+        with self.assertRaisesRegex(RuntimeError, 'source extraction drift'):
+            self.check()
+        self.assertEqual(self.check(True), 476)
+        for name, digest in protected.items():
+            self.assertEqual(hashlib.sha256((self.root / DEST / name).read_bytes()).digest(), digest)
+        self.bend_check(False)
+
+    def test_member_false_freshness_then_refreshed_bend_failure(self):
+        self.replace('case AdditionalToolsTypeAdditionalTools:\n\t\treturn true',
+                     'case AdditionalToolsTypeAdditionalTools:\n\t\treturn false')
+        with self.assertRaisesRegex(RuntimeError, 'source extraction drift'):
+            self.check()
+        self.check(True)
+        self.bend_check(False)
+
+    def test_missing_case_after_refresh_fails_bend(self):
+        self.replace('\tcase ApplyPatchCallOutputStatusCompleted:\n\t\treturn true\n', '')
+        self.check(True)
+        self.bend_check(False)
+
+    def test_changed_constant_cannot_refresh_policy(self):
+        self.replace('AdditionalToolsType = "additional_tools"', 'AdditionalToolsType = "changed"')
+        with self.assertRaisesRegex(RuntimeError, 'DECLARATION POLICY MISMATCH'):
+            self.check(True)
+
+    def test_new_declared_value_not_in_method_cannot_refresh_policy(self):
+        self.replace('AdditionalToolsTypeAdditionalTools AdditionalToolsType = "additional_tools"',
+                     'AdditionalToolsTypeAdditionalTools AdditionalToolsType = "additional_tools"\n'
+                     '\tNewIndependentValue AdditionalToolsType = "not_in_method"')
+        with self.assertRaisesRegex(RuntimeError, 'DECLARATION POLICY MISMATCH'):
+            self.check(True)
+
+    def test_removed_constant_rejected(self):
+        self.replace('AdditionalToolsTypeAdditionalTools AdditionalToolsType = "additional_tools"', '')
+        with self.assertRaisesRegex(RuntimeError, 'undefined: AdditionalToolsTypeAdditionalTools'):
+            self.check(True)
+
+    def test_case_with_wrong_named_string_type_rejected(self):
+        self.replace('case AdditionalToolsTypeAdditionalTools:',
+                     'case AdditionalToolsItemParamTypeAdditionalTools:')
+        with self.assertRaisesRegex(RuntimeError, 'mismatched types'):
+            self.extract()
+
+    def test_changed_type_rejected(self):
+        self.replace('type AdditionalToolsType string', 'type AdditionalToolsType int')
+        with self.assertRaisesRegex(RuntimeError, 'defined directly over string'):
+            self.check(True)
+
+    def test_alias_receiver_rejected(self):
+        self.replace('type AdditionalToolsType string', 'type AdditionalToolsType = string')
+        with self.assertRaisesRegex(RuntimeError, 'no aliases'):
+            self.extract()
+
+    def test_constant_expression_resolution_and_raw_bytes(self):
+        # Not text matching: equivalent constant expressions decode identically.
+        self.replace('AdditionalToolsType = "additional_tools"',
+                     'AdditionalToolsType = ("additional_" + `tools`)')
+        self.assertEqual(self.check(True), 476)
+        self.replace('AdditionalToolsType = ("additional_" + `tools`)',
+                     'AdditionalToolsType = "\\x00\\xffé"')
+        data = self.extract()
+        self.assertEqual(data['policy'][0]['constants'][0]['bytes'], [0, 255, 195, 169])
+        self.assertEqual(data['records'][0]['ast']['args'][0]['bytes'], [0, 255, 195, 169])
+        with self.assertRaisesRegex(RuntimeError, 'DECLARATION POLICY MISMATCH'):
+            self.check(True)
+
+    def test_policy_bend_tampering_rejected(self):
+        path = self.root / DEST / 'POLICY.bend'
+        path.write_text(path.read_text().replace('97n', '98n', 1))
+        with self.assertRaisesRegex(RuntimeError, 'POLICY.bend does not match'):
+            self.check(True)
+
+    def test_unsupported_go_ast_not_silently_dropped(self):
+        original = (self.root / FILE).read_text()
+        mutations = [
+            ('func (e AdditionalToolsType) Valid() bool {',
+             'func (e *AdditionalToolsType) Valid() bool {'),
+            ('func (e AdditionalToolsType) Valid() bool {',
+             'func (e AdditionalToolsType) Valid() (result bool) {'),
+            ('func (e AdditionalToolsType) Valid() bool {',
+             'func (e AdditionalToolsType) Valid() bool { e = "";'),
+            ('switch e {', 'switch e := e; e {'),
+            ('switch e {', 'switch AdditionalToolsType("") {'),
+            ('case AdditionalToolsTypeAdditionalTools:\n\t\treturn true',
+             'case AdditionalToolsTypeAdditionalTools:\n\t\tfallthrough'),
+            ('case AdditionalToolsTypeAdditionalTools:\n\t\treturn true',
+             'case AdditionalToolsTypeAdditionalTools:\n\t\treturn len(e) > 0'),
+            ('case AdditionalToolsTypeAdditionalTools:', 'case "additional_tools":'),
+            ('default:\n\t\treturn false', 'default:\n\t\tpanic("not total")'),
+            ('type AdditionalToolsType string', 'type AdditionalToolsType []byte'),
+        ]
+        for old, new in mutations:
+            with self.subTest(mutation=new):
+                (self.root / FILE).write_text(original.replace(old, new, 1))
+                with self.assertRaises(RuntimeError):
+                    self.extract()
+        (self.root / FILE).write_text(original)
+
+    def test_predeclared_shadowing_rejected_even_after_refresh(self):
+        path = self.root / FILE
+        original = path.read_text()
+        for declaration in ('var true = false', 'var false = true',
+                            'type bool = string', 'type string = int'):
+            with self.subTest(declaration=declaration):
+                path.write_text(original + '\n' + declaration + '\n')
+                with self.assertRaisesRegex(RuntimeError, 'predeclared .* shadowed'):
+                    self.check(True)
+        path.write_text(original)
+
+    def test_sibling_predeclared_shadowing_rejected_even_after_refresh(self):
+        sibling = self.root / FILE.parent / 'shadow.go'
+        for declaration in ('var true = false', 'var false = true',
+                            'type bool = string', 'type string = int',
+                            'func true() bool { return false }'):
+            with self.subTest(declaration=declaration):
+                sibling.write_text('package openaiapi\n' + declaration + '\n')
+                with self.assertRaisesRegex(RuntimeError, 'predeclared .*shadowed'):
+                    self.check(True)
+
+    def test_new_sibling_dependency_requires_freshness_review(self):
+        sibling = self.root / FILE.parent / 'harmless.go'
+        sibling.write_text('package openaiapi\nvar unimportant = 0\n')
+        with self.assertRaisesRegex(RuntimeError, 'source extraction drift'):
+            self.check()
+        self.check(True)
+        manifest = json.loads((self.root / DEST / 'source_ast.json').read_text())
+        dependencies = manifest[0]['dependencies']
+        self.assertIn(str(sibling.relative_to(self.root)), {d['file'] for d in dependencies})
+        self.assertTrue(all(len(d['source_sha256']) == 64 for d in dependencies))
+        sibling.write_text('package openaiapi\nvar unimportant = 1\n')
+        with self.assertRaisesRegex(RuntimeError, 'source extraction drift'):
+            self.check()
+
+    def test_sibling_compiler_directives_and_imports_rejected(self):
+        sibling = self.root / FILE.parent / 'extra.go'
+        for statement in ('//go:linkname danger target\nfunc danger() {}',
+                          '//go:noinline\nfunc other() {}',
+                          'import . "strings"', 'import string "strings"'):
+            with self.subTest(statement=statement):
+                sibling.write_text('package openaiapi\n' + statement + '\n')
+                with self.assertRaisesRegex(RuntimeError, 'compiler directives|unsupported import'):
+                    self.check(True)
+
+    def test_valid_in_new_file_explicitly_rejected(self):
+        (self.root / FILE.parent / 'extra.go').write_text(
+            'package openaiapi\ntype Extra string\nfunc (e Extra) Valid() bool { return true }\n')
+        with self.assertRaisesRegex(RuntimeError, 'outside inventoried'):
+            self.extract()
+
+    def test_deleted_method_inventory_explicitly_rejected(self):
+        self.replace('func (e AdditionalToolsType) Valid()', 'func (e AdditionalToolsType) Changed()')
+        # Constants for an unselected type can fail restricted typechecking first;
+        # either way no method silently disappears from the evidence.
+        with self.assertRaises(RuntimeError):
+            self.check(True)
+
+    def test_nested_module_boundaries_rejected(self):
+        for relative in ('internal/go.mod', 'internal/openaiapi/go.mod',
+                         'internal/anthropicapi/go.mod'):
+            with self.subTest(relative=relative):
+                path = self.root / relative
+                path.write_text('module attacker.invalid/submodule\ngo 1.27\n')
+                with self.assertRaisesRegex(RuntimeError, 'nested (Go )?module'):
+                    self.check(True)
+                path.unlink()
+
+    def test_noncanonical_root_module_rejected(self):
+        (self.root / 'go.mod').write_text('module attacker.invalid/root\ngo 1.27\n')
+        with self.assertRaises(RuntimeError):
+            self.check(True)
+
+    def test_root_module_metadata_requires_freshness_review(self):
+        path = self.root / 'go.mod'
+        path.write_text(path.read_text() + '\n// metadata reviewed independently\n')
+        with self.assertRaisesRegex(RuntimeError, 'source extraction drift'):
+            self.check()
+        self.check(True)
+        manifest = json.loads((self.root / DEST / 'source_ast.json').read_text())
+        self.assertEqual(manifest[0]['module_metadata_sha256']['go.mod'],
+                         hashlib.sha256(path.read_bytes()).hexdigest())
+
+    def test_overlay_workspace_environment_rejected(self):
+        for name, value in (('GOFLAGS', '-overlay=/tmp/substitution.json'),
+                            ('GOWORK', '/tmp/substitution.work')):
+            with self.subTest(name=name), patch.dict(os.environ, {name: value}):
+                with self.assertRaises(RuntimeError):
+                    self.check(True)
+
+    def test_symlink_source_rejected(self):
+        path = self.root / FILE
+        original = path.read_text()
+        target = self.root / 'outside.go'
+        target.write_text(original)
+        path.unlink()
+        path.symlink_to(target)
+        with self.assertRaisesRegex(RuntimeError, 'symlink/escape'):
+            self.extract()
+
+    def test_symlink_artifact_rejected(self):
+        path = self.root / DEST / 'source_ast.json'
+        other = self.root / 'other.json'
+        other.write_text(path.read_text())
+        path.unlink()
+        path.symlink_to(other)
+        with self.assertRaisesRegex(RuntimeError, 'symlink/escape'):
+            self.check(True)
+
+
+if __name__ == '__main__':
+    unittest.main()
