+def buildParents(es: List<&2, Edge>, ps: List<&2, Link>, +fuel: Nat) -> List<&2, Link>:
+  match es:
+    case Nil{}:
+      ps
+    case h <> t:
+      buildParents(t, addEdge(ps, h, fuel), fuel)
