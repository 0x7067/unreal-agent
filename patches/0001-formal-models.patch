+++ b/tools/formal/models/handoff/bend/reload-proof.bend
@@ -0,0 +1,148 @@
+import Base
+import ./generation.bend as G
+import ./reload.bend as R
+
+# Prove the transition for normalized independent metadata, then transport
+# along the inductive equality. This is not runtime invariant checking.
+
+def begin(+host: G.State) -> R.Inv(R.begin(R.Attempt{host, R.expected(R.phase(host)), True{}})):
+  match host:
+    case G.Host{live, cur, G.Idle{}, retired, False{}, status}: ({==}, {==})
+    case G.Host{live, cur, G.Idle{}, retired, True{}, status}: ({==}, {==})
+    case G.Host{live, cur, G.Staging{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Staged{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Fenced{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Awaiting{}, retired, failed, status}: ({==}, {==})
+
+def probeTrue(+host: G.State) -> R.Inv(R.probe(R.Attempt{host, R.expected(R.phase(host)), True{}}, True{})):
+  match host:
+    case G.Host{live, cur, G.Idle{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Staging{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Staged{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Fenced{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Awaiting{}, retired, failed, status}: ({==}, {==})
+
+def probeFalse(+host: G.State) -> R.Inv(R.probe(R.Attempt{host, R.expected(R.phase(host)), True{}}, False{})):
+  match host:
+    case G.Host{live, cur, G.Idle{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Staging{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Staged{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Fenced{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Awaiting{}, retired, failed, status}: ({==}, {==})
+
+def fence(+host: G.State) -> R.Inv(R.fence(R.Attempt{host, R.expected(R.phase(host)), True{}})):
+  match host:
+    case G.Host{live, cur, G.Idle{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Staging{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Staged{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Fenced{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, cur, G.Awaiting{}, retired, failed, status}: ({==}, {==})
+
+def quiesce(+host: G.State) -> R.Inv(R.quiesce(R.Attempt{host, R.expected(R.phase(host)), True{}})):
+  match host:
+    case G.Host{live, None{}, r, retired, failed, status}: ({==}, {==})
+    case G.Host{live, Some{pid}, G.Idle{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, Some{pid}, G.Staging{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, Some{pid}, G.Staged{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, Some{pid}, G.Fenced{}, retired, failed, status}: ({==}, {==})
+    case G.Host{live, Some{pid}, G.Awaiting{}, retired, failed, status}: ({==}, {==})
+
+def abort(+host: G.State) -> R.Inv(R.abort(R.Attempt{host, R.expected(R.phase(host)), True{}})):
+  match host:
+    case G.Host{live, cur, r, retired, failed, status}: ({==}, {==})
+
+def exit(+host: G.State) -> R.Inv(R.exit(R.Attempt{host, R.expected(R.phase(host)), True{}})):
+  match host:
+    case G.Host{live, cur, r, retired, failed, status}: ({==}, {==})
+
+def launch(+host: G.State, +id: Nat) -> R.Inv(R.launch(R.Attempt{host, R.expected(R.phase(host)), True{}}, id)):
+  match host:
+    case G.Host{Nil{}, None{}, G.Awaiting{}, True{}, False{}, status}: ({==}, {==})
+    case G.Host{Nil{}, None{}, G.Fenced{}, True{}, False{}, status}: ({==}, {==})
+    case G.Host{x <> live, cur, r, retired, failed, status}: ({==}, {==})
+    case G.Host{Nil{}, Some{pid}, r, retired, failed, status}: ({==}, {==})
+    case G.Host{Nil{}, None{}, G.Idle{}, retired, failed, status}: ({==}, {==})
+    case G.Host{Nil{}, None{}, G.Staging{}, retired, failed, status}: ({==}, {==})
+    case G.Host{Nil{}, None{}, G.Staged{}, retired, failed, status}: ({==}, {==})
+    case G.Host{Nil{}, None{}, G.Fenced{}, False{}, failed, status}: ({==}, {==})
+    case G.Host{Nil{}, None{}, G.Awaiting{}, False{}, failed, status}: ({==}, {==})
+    case G.Host{Nil{}, None{}, G.Fenced{}, True{}, True{}, status}: ({==}, {==})
+    case G.Host{Nil{}, None{}, G.Awaiting{}, True{}, True{}, status}: ({==}, {==})
+
+def normalized(+host: G.State, e: G.Event) -> R.Inv(R.step(R.Attempt{host, R.expected(R.phase(host)), True{}}, e)):
+  match e:
+    case G.Begin{}: begin(host)
+    case G.ProbeOK{}: probeTrue(host)
+    case G.ProbeBad{}: probeFalse(host)
+    case G.Fence{}: fence(host)
+    case G.Quiesce{}: quiesce(host)
+    case G.Abort{}: abort(host)
+    case G.Exit{}: exit(host)
+    case G.Launch{id}: launch(host, id)
+
+def step(+s: R.State, +e: G.Event, inv: R.Inv(s)) -> R.Inv(R.step(s, e)):
+  match s:
+    case R.Attempt{host, meta, audit}:
+      (eq, hist) = inv
+      %Equal.sym(R.Meta, meta, R.expected(R.phase(host)), eq) : R.Inv(R.step(R.Attempt{host, _, audit}, e))
+      %Equal.sym(Bool, audit, True{}, hist) : R.Inv(R.step(R.Attempt{host, R.expected(R.phase(host)), _}, e))
+      normalized(host, e)
+
+def run(+es: List<&2, G.Event>, +s: R.State, inv: R.Inv(s)) -> R.Inv(R.run(es, s)):
+  match es:
+    case Nil{}: inv
+    case e <> rest: run(rest, R.step(s, e), step(s, e, inv))
+
+def launchHistory(+s: R.State, inv: R.Inv(s)) -> {R.launchSafe(s) == True{} : Bool}:
+  match s:
+    case R.Attempt{host, meta, audit}:
+      (eq, hist) = inv
+      hist
+
+def singleFlightExpected(+host: G.State) -> {R.singleFlight(R.Attempt{host, R.expected(R.phase(host)), True{}}) == True{} : Bool}:
+  match host:
+    case G.Host{live, cur, G.Idle{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Staging{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Staged{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Fenced{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Awaiting{}, retired, failed, status}: {==}
+
+def singleFlight(+s: R.State, inv: R.Inv(s)) -> {R.singleFlight(s) == True{} : Bool}:
+  match s:
+    case R.Attempt{host, meta, audit}:
+      (eq, hist) = inv
+      %Equal.sym(R.Meta, meta, R.expected(R.phase(host)), eq) : {R.singleFlight(R.Attempt{host, _, audit}) == True{} : Bool}
+      %Equal.sym(Bool, audit, True{}, hist) : {R.singleFlight(R.Attempt{host, R.expected(R.phase(host)), _}) == True{} : Bool}
+      singleFlightExpected(host)
+
+def artifactSafeExpected(+host: G.State) -> {R.artifactSafe(R.Attempt{host, R.expected(R.phase(host)), True{}}) == True{} : Bool}:
+  match host:
+    case G.Host{live, cur, G.Idle{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Staging{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Staged{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Fenced{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Awaiting{}, retired, failed, status}: {==}
+
+def artifactSafe(+s: R.State, inv: R.Inv(s)) -> {R.artifactSafe(s) == True{} : Bool}:
+  match s:
+    case R.Attempt{host, meta, audit}:
+      (eq, hist) = inv
+      %Equal.sym(R.Meta, meta, R.expected(R.phase(host)), eq) : {R.artifactSafe(R.Attempt{host, _, audit}) == True{} : Bool}
+      %Equal.sym(Bool, audit, True{}, hist) : {R.artifactSafe(R.Attempt{host, R.expected(R.phase(host)), _}) == True{} : Bool}
+      artifactSafeExpected(host)
+
+def probeSafeExpected(+host: G.State) -> {R.probeSafe(R.Attempt{host, R.expected(R.phase(host)), True{}}) == True{} : Bool}:
+  match host:
+    case G.Host{live, cur, G.Idle{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Staging{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Staged{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Fenced{}, retired, failed, status}: {==}
+    case G.Host{live, cur, G.Awaiting{}, retired, failed, status}: {==}
+
+def probeSafe(+s: R.State, inv: R.Inv(s)) -> {R.probeSafe(s) == True{} : Bool}:
+  match s:
+    case R.Attempt{host, meta, audit}:
+      (eq, hist) = inv
+      %Equal.sym(R.Meta, meta, R.expected(R.phase(host)), eq) : {R.probeSafe(R.Attempt{host, _, audit}) == True{} : Bool}
+      %Equal.sym(Bool, audit, True{}, hist) : {R.probeSafe(R.Attempt{host, R.expected(R.phase(host)), _}) == True{} : Bool}
+      probeSafeExpected(host)
diff --git a/tools/formal/models/handoff/bend/reload.bend b/tools/formal/models/handoff/bend/reload.bend
new file mode 100644
index 0000000..b43ff2d
--- /dev/null
+++ b/tools/formal/models/handoff/bend/reload.bend
@@ -0,0 +1,182 @@
+import Base
+import ./generation.bend as G
+import ./composed.bend as C
+
+# A separate, richer lifecycle slice. Metadata is INDEPENDENT of phase; the
+# invariant is established by transitions, not by defining metadata as phase.
+# Candidate means an UNUSED staged artifact (launch transfers ownership).
+type Meta is Data:
+  Tracking{inflight: Nat, candidate: Bool, compatible: Bool}
+
+type State is Data:
+  Attempt{host: G.State, meta: Meta, launchAudit: Bool}
+
+def initial() -> State:
+  Attempt{G.initial(), Tracking{0n, False{}, False{}}, True{}}
+
+def phase(host: G.State) -> G.Reload:
+  G.Host{live, cur, r, retired, failed, status} = host
+  r
+
+def expected(r: G.Reload) -> Meta:
+  match r:
+    case G.Idle{}: Tracking{0n, False{}, False{}}
+    case G.Staging{}: Tracking{1n, False{}, False{}}
+    case G.Staged{}: Tracking{1n, True{}, True{}}
+    case G.Fenced{}: Tracking{1n, True{}, True{}}
+    case G.Awaiting{}: Tracking{1n, True{}, True{}}
+
+def count(m: Meta) -> Nat:
+  Tracking{k, cand, probe} = m
+  k
+
+def candidate(m: Meta) -> Bool:
+  Tracking{k, cand, probe} = m
+  cand
+
+def compatible(m: Meta) -> Bool:
+  Tracking{k, cand, probe} = m
+  probe
+
+def emptyLive(host: G.State) -> Bool:
+  match host:
+    case G.Host{Nil{}, cur, r, retired, failed, status}: True{}
+    case G.Host{x <> xs, cur, r, retired, failed, status}: False{}
+
+def begin(+s: State) -> State:
+  match s:
+    case Attempt{G.Host{live, cur, G.Idle{}, retired, False{}, status}, Tracking{0n, cand, probe}, audit}:
+      Attempt{G.Host{live, cur, G.Staging{}, retired, False{}, status}, Tracking{1n, False{}, False{}}, audit}
+    case other: s
+
+def probe(+s: State, ok: Bool) -> State:
+  match s ok:
+    case Attempt{G.Host{live, cur, G.Staging{}, retired, failed, status}, Tracking{k, cand, passed}, audit} True{}:
+      Attempt{G.Host{live, cur, G.Staged{}, retired, failed, status}, Tracking{k, True{}, True{}}, audit}
+    case Attempt{G.Host{live, cur, G.Staging{}, retired, failed, status}, meta, audit} False{}:
+      Attempt{G.Host{live, cur, G.Idle{}, retired, failed, status}, Tracking{0n, False{}, False{}}, audit}
+    case s b: s
+
+def fence(+s: State) -> State:
+  match s:
+    case Attempt{G.Host{live, cur, G.Staged{}, retired, failed, status}, meta, audit}:
+      Attempt{G.Host{live, cur, G.Fenced{}, retired, failed, status}, meta, audit}
+    case other: s
+
+def quiesce(s: State) -> State:
+  Attempt{host, meta, audit} = s
+  Attempt{G.quiesce(host), meta, audit}
+
+def abort(s: State) -> State:
+  Attempt{host, meta, audit} = s
+  Attempt{G.abort(host), Tracking{0n, False{}, False{}}, audit}
+
+def exit(s: State) -> State:
+  Attempt{host, meta, audit} = s
+  Attempt{G.exit(host), meta, audit}
+
+# Record an audit of the ACTUAL old live collection on each launch. Merely
+# proving a canLaunch permission would not prove the launch history safe.
+def launchIf(+s: State, +id: Nat, enabled: Bool) -> State:
+  match s enabled:
+    case Attempt{host, meta, audit} True{}:
+      Attempt{G.launch(host, id), Tracking{0n, False{}, False{}}, Bool.and(audit, emptyLive(host))}
+    case s False{}: s
+
+def launch(+s: State, +id: Nat) -> State:
+  Attempt{host, meta, audit} = s
+  launchIf(s, id, C.canLaunch(host))
+
+def step(s: State, e: G.Event) -> State:
+  match e:
+    case G.Begin{}: begin(s)
+    case G.ProbeOK{}: probe(s, True{})
+    case G.ProbeBad{}: probe(s, False{})
+    case G.Fence{}: fence(s)
+    case G.Quiesce{}: quiesce(s)
+    case G.Abort{}: abort(s)
+    case G.Exit{}: exit(s)
+    case G.Launch{id}: launch(s, id)
+
+def run(es: List<&2, G.Event>, s: State) -> State:
+  match es:
+    case Nil{}: s
+    case e <> rest: run(rest, step(s, e))
+
+def Inv(+s: State) -> Data:
+  Attempt{host, meta, audit} = s
+  Sigma<&2, &2, {meta == expected(phase(host)) : Meta}, _ => {audit == True{} : Bool}>
+
+def singleFlight(s: State) -> Bool:
+  Attempt{host, meta, audit} = s
+  Nat.is_le(count(meta), 1n)
+
+def artifactSafe(s: State) -> Bool:
+  match s:
+    case Attempt{G.Host{live, cur, G.Idle{}, retired, failed, status}, meta, audit}:
+      Bool.not(candidate(meta))
+    case other: True{}
+
+def probeSafe(+s: State) -> Bool:
+  match s:
+    case Attempt{G.Host{live, cur, G.Awaiting{}, retired, failed, status}, meta, audit}:
+      Bool.and(candidate(meta), compatible(meta))
+    case other: True{}
+
+def launchSafe(s: State) -> Bool:
+  Attempt{host, meta, audit} = s
+  audit
+
+# Four executable mutants, removing a concrete transition guard or cleanup.
+type Variant is Data:
+  NoCAS{}
+  NoDiscard{}
+  NoProbe{}
+  EarlyLaunch{}
+  OldStatus{}
+
+def noCAS(+s: State) -> State:
+  match s:
+    case Attempt{host, Tracking{k, cand, passed}, audit}:
+      Attempt{G.begin(host), Tracking{1n+k, cand, passed}, audit}
+
+def noDiscard(s: State) -> State:
+  Attempt{host, meta, audit} = s
+  Attempt{G.abort(host), meta, audit}
+
+def noProbe(+s: State) -> State:
+  match s:
+    case Attempt{G.Host{live, cur, G.Staging{}, retired, failed, status}, Tracking{k, cand, passed}, audit}:
+      Attempt{G.Host{live, cur, G.Staged{}, retired, failed, status}, Tracking{k, True{}, False{}}, audit}
+    case other: s
+
+def earlyLaunch(+s: State, +id: Nat) -> State:
+  Attempt{G.Host{live, cur, r, retired, failed, status}, meta, audit} = s
+  Attempt{G.Host{id <> live, Some{id}, G.Idle{}, False{}, False{}, G.Ready{}}, Tracking{0n, False{}, False{}}, Bool.and(audit, emptyLive(G.Host{live, cur, r, retired, failed, status}))}
+
+# Historical abandoned-retirement defect: ownership is cleared without a
+# stopped publication. Correct exit above always publishes stopped.
+def legacyExit(+s: State) -> State:
+  match s:
+    case Attempt{G.Host{live, Some{pid}, G.Idle{}, True{}, failed, status}, meta, audit}:
+      Attempt{G.Host{[], None{}, G.Idle{}, True{}, failed, status}, meta, audit}
+    case other: exit(s)
+
+def statusSafe(s: State) -> Bool:
+  match s:
+    case Attempt{G.Host{live, None{}, r, retired, failed, G.Ready{}}, meta, audit}: False{}
+    case other: True{}
+
+def mutantStep(s: State, v: Variant, e: G.Event) -> State:
+  match v e:
+    case NoCAS{} G.Begin{}: noCAS(s)
+    case NoDiscard{} G.Abort{}: noDiscard(s)
+    case NoProbe{} G.ProbeOK{}: noProbe(s)
+    case EarlyLaunch{} G.Launch{id}: earlyLaunch(s, id)
+    case OldStatus{} G.Exit{}: legacyExit(s)
+    case v e: step(s, e)
+
+def mutantRun(es: List<&2, G.Event>, +v: Variant, s: State) -> State:
+  match es:
+    case Nil{}: s
+    case e <> rest: mutantRun(rest, v, mutantStep(s, v, e))
