+#!/usr/bin/env python3
+"""Rebuild finite-core certificates; Python is NOT in the proof trust boundary.
+
+Bend checks each concrete transition equality against product.bend. A bad
+successor or omitted closure edge fails checking; completeness of this BFS is
+not assumed. No crash budget: only the crash counter is projected away.
+"""
+import argparse
+from collections import deque
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+EVENTS = ['CreateErrDone', 'ProcessExit', 'CancelFails', 'RemoteFinishes',
+          'HandlerCloses', 'Persist', 'Crash', 'Resume', 'Stutter']
+# Independent fields, in exactly product.Core order. Checkpoints=(term,phase).
+INIT = (True, 'CreateErr', 'Creating', False, True, False, False, True,
+        (), (False, 'CreateErr'), (False, 'NoPhase'), 0, 0, 0)
+
+
+def next_state(s, event, exclusive=True, skip=True):
+    up, ph, ac, err, rm, rt, ru, ho, q, sh, re, n, sw, rw = s
+    q = list(q)
+    if event == 'CreateErrDone' and up and ph == 'CreateErr' and ac == 'Creating':
+        if exclusive and err:
+            ph, ac = 'PhaseDone', 'NoActive'
+            q.append(('Shell', True, 'PhaseDone'))
+        else:
+            ph, ac, err, n = 'Process', 'Running', True, n + 1
+            q.append(('Shell', False, 'Process'))
+    elif event == 'ProcessExit' and up and ac == 'Running':
+        ph, ac = 'PhaseDone', 'NoActive'
+        q.append(('Shell', True, 'PhaseDone'))
+    elif event == 'CancelFails' and up and rm and not rt:
+        rt, ru = True, True
+        q.append(('Remote', True, 'NoPhase'))
+    elif event == 'RemoteFinishes' and up and rm and ho:
+        if not rt:
+            q.append(('Remote', True, 'NoPhase'))
+        rm, rt, ru = False, True, False
+    elif event == 'HandlerCloses' and up and ho:
+        ho = False
+        if rm and not (skip and rt):
+            rt, ru = True, True
+            q.append(('Remote', True, 'NoPhase'))
+    elif event == 'Persist' and up and q:
+        op, terminal, phase = q.pop(0)
+        if op == 'Shell':
+            sh, sw = (terminal, phase), sw + int(terminal)
+        else:
+            re, rw = (terminal, phase), rw + int(terminal)
+    elif event == 'Crash' and up:
+        up, ph, ac, rm, rt, ru, ho, q = False, 'NoPhase', 'NoActive', False, False, False, False, []
+    elif event == 'Resume' and not up:
+        up, ho, rm = True, True, not re[0]
+        if not sh[0]:
+            if sh[1] == 'Process':
+                ph, ac, q = 'PhaseDone', 'NoActive', [('Shell', True, 'PhaseDone')]
+            else:
+                ph, ac, q = sh[1], 'Creating', []
+    return up, ph, ac, err, rm, rt, ru, ho, tuple(q), sh, re, n, sw, rw
+
+
+def boolean(b):
+    return 'True{}' if b else 'False{}'
+
+
+def checkpoint(c):
+    return 'P.Checkpoint{' + boolean(c[0]) + ', P.' + c[1] + '{}}'
+
+
+def core(s):
+    up, ph, ac, err, rm, rt, ru, ho, q, sh, re, n, sw, rw = s
+    queue = '[' + ', '.join('P.Update{P.' + o + '{}, ' + checkpoint((t, p)) + '}' for o, t, p in q) + ']'
+    fields = [boolean(up), 'P.' + ph + '{}', 'P.' + ac + '{}']
+    fields += list(map(boolean, [err, rm, rt, ru, ho]))
+    fields += [queue, checkpoint(sh), checkpoint(re), f'{n}n', f'{sw}n', f'{rw}n']
+    return 'P.Core{' + ', '.join(fields) + '}'
+
+
+def emit(name, content, check):
+    target = HERE / name
+    if check:
+        if not target.exists() or target.read_text() != content:
+            raise SystemExit(f'{target}: stale certificate; regenerate and recheck Bend')
+    else:
+        target.write_text(content)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--check', action='store_true', help='check generated sources without writing')
+    args = parser.parse_args()
+    states, ids, todo = [INIT], {INIT: 0}, deque([INIT])
+    while todo:
+        s = todo.popleft()
+        for e in EVENTS:
+            t = next_state(s, e)
+            if t not in ids:
+                ids[t] = len(states)
+                states.append(t)
+                todo.append(t)
+    print(f'{len(states)} core states; {len(states) * len(EVENTS)} checked closure edges; max FIFO length {max(len(s[8]) for s in states)}')
+    # Public carrier/decode. Constructors enumerate independently stored states,
+    # not operation lifecycle variants. None restrict product.Core.
+    text = ['# Generated by generate_certificate.py; checked, not trusted.\nimport Base\nimport ./product.bend as P\n',
+            'type Index is Data:']
+    text += [f'  S{i}{{}}' for i in range(len(states))]
+    text += ['\ndef decode(i: Index) -> P.Core:', '  match i:']
+    text += [f'    case S{i}{{}}: {core(s)}' for i, s in enumerate(states)]
+    text += ['\n# A finite-cover invariant on an unrestricted independent-field core.',
+             'def Invariant(s: P.Core) -> Type:',
+             '  &i: Index -> {decode(i) == s : P.Core}\n']
+    emit('certificate.bend', '\n'.join(text), args.check)
+    # One closure lemma per event avoids big dependent matching trees.
+    text = ['# Generated transition equalities are checked against the executable reducer.',
+            'import Base\nimport ./product.bend as P\nimport ./certificate.bend as C\n']
+    for e in EVENTS:
+        text += [f'def edge{e}(i: C.Index) -> C.Invariant(P.next(P.fixed(), P.{e}{{}}, C.decode(i))):', '  match i:']
+        text += [f'    case C.S{i}{{}}: (C.S{ids[next_state(s, e)]}{{}}, {{==}})' for i, s in enumerate(states)]
+        text += ['']
+    text += ['def closure(e: P.Boundary, i: C.Index) -> C.Invariant(P.next(P.fixed(), e, C.decode(i))):', '  match e:']
+    text += [f'    case P.{e}{{}}: edge{e}(i)' for e in EVENTS]
+    text += ['\ndef indexSafe(i: C.Index) -> {P.safe(C.decode(i)) == True{} : Bool}:', '  match i:']
+    text += [f'    case C.S{i}{{}}: {{==}}' for i in range(len(states))]
+    for name in ['queueAccounting', 'durableHistory', 'queueBound']:
+        text += [f'\ndef index{name}(i: C.Index) -> {{P.{name}(C.decode(i)) == True{{}} : Bool}}:', '  match i:']
+        text += [f'    case C.S{i}{{}}: {{==}}' for i in range(len(states))]
+    text += ['\ndef indexSpawns(i: C.Index) -> {Nat.is_le(P.spawnCount(C.decode(i)), 1n) == True{} : Bool}:', '  match i:']
+    text += [f'    case C.S{i}{{}}: {{==}}' for i in range(len(states))]
+    text += ['\ndef indexWrites(o: P.Op, i: C.Index) -> {Nat.is_le(P.terminalWrites(o, C.decode(i)), 1n) == True{} : Bool}:', '  match o:']
+    for op in ['Shell', 'Remote']:
+        text += [f'    case P.{op}{{}}:', '      match i:']
+        text += [f'        case C.S{i}{{}}: {{==}}' for i in range(len(states))]
+    emit('closure.bend', '\n'.join(text) + '\n', args.check)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/formal/models/operations/bend/model.bend b/tools/formal/models/operations/bend/model.bend
new file mode 100644
index 0000000..6e38ab5
--- /dev/null
+++ b/tools/formal/models/operations/bend/model.bend
@@ -0,0 +1,136 @@
+import Base
+
+# Projection of CreateErrDone. True means an eligible create_err completion;
+# False is any non-spawning boundary (including crash/resume/persist). The file
+# bit is durable and EXCLUSIVE creation consumes it before process launch.
+# Ignoring phase/up guards admits MORE attempts than OperationCheckpoint.tla.
+def shellSpawns(+attempts: List<&2, Bool>, errFile: Bool) -> Nat:
+  match attempts:
+    case Nil{}: 0n
+    case attempt <> rest:
+      match attempt errFile:
+        case False{} True{}: shellSpawns(rest, True{})
+        case True{} True{}: shellSpawns(rest, True{})
+        case False{} False{}: shellSpawns(rest, False{})
+        case True{} False{}: 1n+shellSpawns(rest, True{})
+
+# Legacy useExistingPath reuses the file and can launch on every retry.
+def legacySpawns(attempts: List<&2, Bool>) -> Nat:
+  match attempts:
+    case Nil{}: 0n
+    case attempt <> rest:
+      match attempt:
+        case False{}: legacySpawns(rest)
+        case True{}: 1n+legacySpawns(rest)
+
+type Location is Data:
+  Retained{}
+  Released{}
+  Down{}
+
+type Remote is Data:
+  Active{}
+  UnknownQueued{}
+  ReleasedQueued{}
+  Stored{location: Location}
+  DownUnstored{}
+
+type Event is Data:
+  CancelFails{}
+  RemoteFinishes{}
+  HandlerCloses{}
+  Persist{}
+  Crash{}
+  Resume{}
+
+# UnknownQueued is a terminal remoteUnknown still in the manager map.
+# HandlerCloses must not enqueue another terminal update from that state.
+def cancel(+s: Remote) -> Remote:
+  match s:
+    case Active{}: UnknownQueued{}
+    case _: s
+
+def finish(+s: Remote) -> Remote:
+  match s:
+    case Active{}: ReleasedQueued{}
+    case UnknownQueued{}: ReleasedQueued{}
+    case Stored{Retained{}}: Stored{Released{}}
+    case _: s
+
+def close(+s: Remote) -> Remote:
+  match s:
+    case Active{}: UnknownQueued{}
+    case _: s
+
+def persist(+s: Remote) -> Remote:
+  match s:
+    case UnknownQueued{}: Stored{Retained{}}
+    case ReleasedQueued{}: Stored{Released{}}
+    case _: s
+
+def crash(s: Remote) -> Remote:
+  match s:
+    case Stored{_}: Stored{Down{}}
+    case _: DownUnstored{}
+
+def resume(+s: Remote) -> Remote:
+  match s:
+    case DownUnstored{}: Active{}
+    case Stored{Down{}}: Stored{Released{}}
+    case _: s
+
+def step(e: Event, s: Remote) -> Remote:
+  match e:
+    case CancelFails{}: cancel(s)
+    case RemoteFinishes{}: finish(s)
+    case HandlerCloses{}: close(s)
+    case Persist{}: persist(s)
+    case Crash{}: crash(s)
+    case Resume{}: resume(s)
+
+# Counts actual durable terminal writes, not merely local terminal states.
+def write(e: Event, s: Remote) -> Nat:
+  match e:
+    case Persist{}:
+      match s:
+        case UnknownQueued{}: 1n
+        case ReleasedQueued{}: 1n
+        case _: 0n
+    case _: 0n
+
+def terminalWrites(+events: List<&2, Event>, +s: Remote) -> Nat:
+  match events:
+    case Nil{}: 0n
+    case +e <> rest: Nat.add(write(e, s), terminalWrites(rest, step(e, s)))
+
+# Local negative-control queue projection. Cancellation failure retains the map
+# entry, marks terminal, and enqueues once. Legacy close enqueues it again.
+type CloseState is Data:
+  CloseState{retained: Bool, terminal: Bool, queued: Nat}
+
+def cancelQueue(s: CloseState) -> CloseState:
+  match s:
+    case CloseState{True{}, False{}, q}: CloseState{True{}, True{}, 1n+q}
+    case CloseState{r, t, q}: CloseState{r, t, q}
+
+def closeQueueGuard(skipTerminal: Bool, terminal: Bool, queued: Nat) -> Nat:
+  match skipTerminal terminal:
+    case True{} True{}: queued
+    case _ _: 1n+queued
+
+def closeQueue(skipTerminal: Bool, s: CloseState) -> CloseState:
+  match s:
+    case CloseState{True{}, +t, q}: CloseState{True{}, True{}, closeQueueGuard(skipTerminal, t, q)}
+    case CloseState{False{}, t, q}: CloseState{False{}, t, q}
+
+def queueCount(s: CloseState) -> Nat:
+  match s:
+    case CloseState{_, _, q}: q
+
+def drainTerminalQueue(n: Nat) -> Nat:
+  match n:
+    case 0n: 0n
+    case 1n+p: 1n+drainTerminalQueue(p)
+
+def cancelThenCloseWrites(skipTerminal: Bool) -> Nat:
+  drainTerminalQueue(queueCount(closeQueue(skipTerminal, cancelQueue(CloseState{True{}, False{}, 0n}))))
diff --git a/tools/formal/models/operations/bend/product.bend b/tools/formal/models/operations/bend/product.bend
new file mode 100644
index 0000000..ee71e4c
--- /dev/null
+++ b/tools/formal/models/operations/bend/product.bend
@@ -0,0 +1,249 @@
+import Base
+
+# OperationCheckpoint.tla product. Disabled actions stutter. Crash budget is
+# UNBOUNDED; crashes is an independent Nat history field in State.
+type Phase is Data:
+  NoPhase{}
+  CreateErr{}
+  Process{}
+  PhaseDone{}
+
+type Active is Data:
+  NoActive{}
+  Creating{}
+  Running{}
+
+type Op is Data:
+  Shell{}
+  Remote{}
+
+type Checkpoint is Data:
+  Checkpoint{term: Bool, phase: Phase}
+
+type Update is Data:
+  Update{op: Op, checkpoint: Checkpoint}
+
+type Core is Data:
+  Core{up: Bool, phase: Phase, active: Active, errFile: Bool,
+       rmap: Bool, rterm: Bool, runknown: Bool, hopen: Bool,
+       queue: List<&2, Update>, shell: Checkpoint, remote: Checkpoint,
+       spawns: Nat, shellWrites: Nat, remoteWrites: Nat}
+
+type State is Data:
+  State{core: Core, crashes: Nat}
+
+type Config is Data:
+  Config{exclusiveErrCreate: Bool, closeSkipsTerm: Bool}
+
+type Boundary is Data:
+  CreateErrDone{}
+  ProcessExit{}
+  CancelFails{}
+  RemoteFinishes{}
+  HandlerCloses{}
+  Persist{}
+  Crash{}
+  Resume{}
+  Stutter{}
+
+def fixed() -> Config: Config{True{}, True{}}
+
+def initial() -> Core:
+  Core{True{}, CreateErr{}, Creating{}, False{}, True{}, False{}, False{}, True{},
+       [], Checkpoint{False{}, CreateErr{}}, Checkpoint{False{}, NoPhase{}}, 0n, 0n, 0n}
+
+def append(xs: List<&2, Update>, u: Update) -> List<&2, Update>:
+  match xs:
+    case Nil{}: [u]
+    case x <> rest: x <> append(rest, u)
+
+def createResult(blocked: Bool, s: Core) -> Core:
+  match blocked s:
+    case True{} Core{up, _, _, err, rm, rt, ru, ho, q, sh, re, n, sw, rw}:
+      Core{up, PhaseDone{}, NoActive{}, err, rm, rt, ru, ho,
+           append(q, Update{Shell{}, Checkpoint{True{}, PhaseDone{}}}), sh, re, n, sw, rw}
+    case False{} Core{up, _, _, _, rm, rt, ru, ho, q, sh, re, n, sw, rw}:
+      Core{up, Process{}, Running{}, True{}, rm, rt, ru, ho,
+           append(q, Update{Shell{}, Checkpoint{False{}, Process{}}}), sh, re, 1n+n, sw, rw}
+
+def create(c: Config, +s: Core) -> Core:
+  match c s:
+    case Config{ex, _} Core{True{}, CreateErr{}, Creating{}, err, _, _, _, _, _, _, _, _, _, _}:
+      createResult(Bool.and(ex, err), s)
+    case _ _: s
+
+def process(+s: Core) -> Core:
+  match s:
+    case Core{True{}, _, Running{}, err, rm, rt, ru, ho, q, sh, re, n, sw, rw}:
+      Core{True{}, PhaseDone{}, NoActive{}, err, rm, rt, ru, ho,
+           append(q, Update{Shell{}, Checkpoint{True{}, PhaseDone{}}}), sh, re, n, sw, rw}
+    case _: s
+
+def cancel(+s: Core) -> Core:
+  match s:
+    case Core{True{}, ph, ac, err, True{}, False{}, _, ho, q, sh, re, n, sw, rw}:
+      Core{True{}, ph, ac, err, True{}, True{}, True{}, ho,
+           append(q, Update{Remote{}, Checkpoint{True{}, NoPhase{}}}), sh, re, n, sw, rw}
+    case _: s
+
+def finishQueue(terminal: Bool, q: List<&2, Update>) -> List<&2, Update>:
+  match terminal:
+    case True{}: q
+    case False{}: append(q, Update{Remote{}, Checkpoint{True{}, NoPhase{}}})
+
+def finish(+s: Core) -> Core:
+  match s:
+    case Core{True{}, ph, ac, err, True{}, rt, _, True{}, q, sh, re, n, sw, rw}:
+      Core{True{}, ph, ac, err, False{}, True{}, False{}, True{}, finishQueue(rt, q), sh, re, n, sw, rw}
+    case _: s
+
+def closeResult(emit: Bool, s: Core) -> Core:
+  match emit s:
+    case True{} Core{up, ph, ac, err, rm, _, _, _, q, sh, re, n, sw, rw}:
+      Core{up, ph, ac, err, rm, True{}, True{}, False{},
+           append(q, Update{Remote{}, Checkpoint{True{}, NoPhase{}}}), sh, re, n, sw, rw}
+    case False{} Core{up, ph, ac, err, rm, rt, ru, _, q, sh, re, n, sw, rw}:
+      Core{up, ph, ac, err, rm, rt, ru, False{}, q, sh, re, n, sw, rw}
+
+def close(c: Config, +s: Core) -> Core:
+  match c s:
+    case Config{_, skip} Core{True{}, _, _, _, rm, rt, _, True{}, _, _, _, _, _, _}:
+      closeResult(Bool.and(rm, Bool.not(Bool.and(skip, rt))), s)
+    case _ _: s
+
+def bump(terminal: Bool, n: Nat) -> Nat:
+  match terminal:
+    case True{}: 1n+n
+    case False{}: n
+
+# Every head is saved unconditionally, even a duplicate terminal. The theorem
+# must exclude duplicate enqueues; Persist itself has NO deduplication guard.
+def persist(+s: Core) -> Core:
+  match s:
+    case Core{True{}, ph, ac, err, rm, rt, ru, ho, Update{Shell{}, Checkpoint{+t, p}} <> rest, _, re, n, sw, rw}:
+      Core{True{}, ph, ac, err, rm, rt, ru, ho, rest, Checkpoint{t, p}, re, n, bump(t, sw), rw}
+    case Core{True{}, ph, ac, err, rm, rt, ru, ho, Update{Remote{}, Checkpoint{+t, p}} <> rest, sh, _, n, sw, rw}:
+      Core{True{}, ph, ac, err, rm, rt, ru, ho, rest, sh, Checkpoint{t, p}, n, sw, bump(t, rw)}
+    case _: s
+
+def crash(+s: Core) -> Core:
+  match s:
+    case Core{True{}, _, _, err, _, _, _, _, _, sh, re, n, sw, rw}:
+      Core{False{}, NoPhase{}, NoActive{}, err, False{}, False{}, False{}, False{}, [], sh, re, n, sw, rw}
+    case _: s
+
+def restoreShell(sh: Checkpoint, ph: Phase, ac: Active, q: List<&2, Update>) -> Phase & Active & List<&2, Update>:
+  match sh:
+    case Checkpoint{True{}, _}: (ph, (ac, q))
+    case Checkpoint{False{}, Process{}}:
+      (PhaseDone{}, (NoActive{}, [Update{Shell{}, Checkpoint{True{}, PhaseDone{}}}]))
+    case Checkpoint{False{}, p}: (p, (Creating{}, []))
+
+def resumeWith(s: Core, restored: Phase & Active & List<&2, Update>) -> Core:
+  match s:
+    case Core{_, _, _, err, _, rt, ru, _, _, sh, Checkpoint{+t, p}, n, sw, rw}:
+      match restored:
+        case (ph, (ac, q)):
+          Core{True{}, ph, ac, err, Bool.not(t), rt, ru, True{}, q, sh, Checkpoint{t, p}, n, sw, rw}
+
+def resume(+s: Core) -> Core:
+  match s:
+    case Core{False{}, ph, ac, _, _, _, _, _, q, sh, _, _, _, _}: resumeWith(s, restoreShell(sh, ph, ac, q))
+    case _: s
+
+def next(c: Config, e: Boundary, s: Core) -> Core:
+  match e:
+    case CreateErrDone{}: create(c, s)
+    case ProcessExit{}: process(s)
+    case CancelFails{}: cancel(s)
+    case RemoteFinishes{}: finish(s)
+    case HandlerCloses{}: close(c, s)
+    case Persist{}: persist(s)
+    case Crash{}: crash(s)
+    case Resume{}: resume(s)
+    case Stutter{}: s
+
+def crashCount(e: Boundary, up: Bool, n: Nat) -> Nat:
+  match e up:
+    case Crash{} True{}: 1n+n
+    case _ _: n
+
+def isUp(s: Core) -> Bool:
+  match s:
+    case Core{up, _, _, _, _, _, _, _, _, _, _, _, _, _}: up
+
+def step(c: Config, +e: Boundary, s: State) -> State:
+  match s:
+    case State{+x, crashes}:
+      State{next(c, e, x), crashCount(e, isUp(x), crashes)}
+
+def run(events: List<&2, Boundary>, +c: Config, s: State) -> State:
+  match events:
+    case Nil{}: s
+    case e <> rest: run(rest, c, step(c, e, s))
+
+def core(s: State) -> Core:
+  match s:
+    case State{x, _}: x
+
+def safe(s: Core) -> Bool:
+  match s:
+    case Core{_, _, _, _, _, _, _, _, _, _, _, n, sw, rw}:
+      Bool.and(Nat.is_le(n, 1n), Bool.and(Nat.is_le(sw, 1n), Nat.is_le(rw, 1n)))
+
+# Safety of every prefix, not just the last state.
+def allSafe(events: List<&2, Boundary>, +s: Core) -> Bool:
+  match events:
+    case Nil{}: safe(s)
+    case e <> rest: Bool.and(safe(s), allSafe(rest, next(fixed(), e, s)))
+
+
+def spawnCount(s: Core) -> Nat:
+  match s:
+    case Core{_, _, _, _, _, _, _, _, _, _, _, n, _, _}: n
+
+def terminalWrites(o: Op, s: Core) -> Nat:
+  match o s:
+    case Shell{} Core{_, _, _, _, _, _, _, _, _, _, _, _, sw, _}: sw
+    case Remote{} Core{_, _, _, _, _, _, _, _, _, _, _, _, _, rw}: rw
+
+def sameOp(a: Op, b: Op) -> Bool:
+  match a b:
+    case Shell{} Shell{}: True{}
+    case Remote{} Remote{}: True{}
+    case _ _: False{}
+
+def pending(+o: Op, q: List<&2, Update>) -> Nat:
+  match q:
+    case Nil{}: 0n
+    case Update{which, Checkpoint{t, _}} <> rest:
+      bump(Bool.and(sameOp(o, which), t), pending(o, rest))
+
+# Counts actual FIFO entries plus writes already committed, not an audited
+# terminal flag. A crash can discard entries; Persist transfers one entry to
+# history without increasing this sum. Manager actions must not allocate twice.
+def queueAccounting(s: Core) -> Bool:
+  match s:
+    case Core{_, _, _, _, _, _, _, _, +q, _, _, _, sw, rw}:
+      Bool.and(Nat.is_le(Nat.add(sw, pending(Shell{}, q)), 1n),
+               Nat.is_le(Nat.add(rw, pending(Remote{}, q)), 1n))
+
+def boolEq(a: Bool, b: Bool) -> Bool:
+  match a b:
+    case True{} True{}: True{}
+    case False{} False{}: True{}
+    case _ _: False{}
+
+def durableHistory(s: Core) -> Bool:
+  match s:
+    case Core{_, _, _, _, _, _, _, _, _, Checkpoint{st, _}, Checkpoint{rt, _}, _, sw, rw}:
+      Bool.and(boolEq(st, Nat.is_eq(sw, 1n)), boolEq(rt, Nat.is_eq(rw, 1n)))
+
+def queueLength(q: List<&2, Update>) -> Nat:
+  match q:
+    case Nil{}: 0n
+    case _ <> rest: 1n+queueLength(rest)
+
+def queueBound(s: Core) -> Bool:
+  match s:
+    case Core{_, _, _, _, _, _, _, _, q, _, _, _, _, _}: Nat.is_le(queueLength(q), 3n)
diff --git a/tools/formal/models/operations/bend/witnesses.bend b/tools/formal/models/operations/bend/witnesses.bend
new file mode 100644
index 0000000..fbcced0
--- /dev/null
+++ b/tools/formal/models/operations/bend/witnesses.bend
@@ -0,0 +1,45 @@
+import Base
+import ./product.bend as P
+
+# Full product executions, not the legacy projection counters.
+def spawnEvents() -> List<&2, P.Boundary>:
+  [P.CreateErrDone{}, P.Crash{}, P.Resume{}, P.CreateErrDone{}]
+
+def closeEvents() -> List<&2, P.Boundary>:
+  [P.CancelFails{}, P.HandlerCloses{}, P.Persist{}, P.Persist{}]
+
+def legacySpawn() -> P.Config: P.Config{False{}, True{}}
+def legacyClose() -> P.Config: P.Config{True{}, False{}}
+
+def replay(events: List<&2, P.Boundary>, +c: P.Config, +s: P.State) -> List<&2, P.State>:
+  match events:
+    case Nil{}: [s]
+    case e <> rest: s <> replay(rest, c, P.step(c, e, s))
+
+def spawnTrace() -> List<&2, P.State>:
+  replay(spawnEvents(), legacySpawn(), P.State{P.initial(), 0n})
+
+def closeTrace() -> List<&2, P.State>:
+  replay(closeEvents(), legacyClose(), P.State{P.initial(), 0n})
+
+def finalSpawn(c: P.Config) -> P.Core:
+  P.core(P.run(spawnEvents(), c, P.State{P.initial(), 0n}))
+
+def finalClose(c: P.Config) -> P.Core:
+  P.core(P.run(closeEvents(), c, P.State{P.initial(), 0n}))
+
+# One shared FIFO contains a shell progress checkpoint, remote terminal, and
+# shell terminal, in that order. No per-operation queue or persist guard.
+def interleaved() -> List<&2, P.Boundary>:
+  [P.CreateErrDone{}, P.CancelFails{}, P.ProcessExit{}]
+
+def afterInterleaving() -> P.Core:
+  P.core(P.run(interleaved(), P.fixed(), P.State{P.initial(), 0n}))
+
+def storedProcessResume() -> P.Core:
+  P.core(P.run([P.CreateErrDone{}, P.Persist{}, P.Crash{}, P.Resume{}, P.Persist{}],
+              P.fixed(), P.State{P.initial(), 0n}))
+
+def droppedRemoteTerminal() -> P.Core:
+  P.core(P.run([P.CancelFails{}, P.Crash{}, P.Resume{}, P.HandlerCloses{}, P.Persist{}],
+              P.fixed(), P.State{P.initial(), 0n}))
diff --git a/tools/formal/models/operations/check.sh b/tools/formal/models/operations/check.sh
new file mode 100755
index 0000000..ae4efc9
--- /dev/null
+++ b/tools/formal/models/operations/check.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Bounded TLA+/TLC check of the operation checkpoint/dispatch model.
+# Supply a local tla2tools.jar; this script never downloads or vendors binaries.
+set -euo pipefail
+: "${TLA2TOOLS_JAR:?Set TLA2TOOLS_JAR to the TLA+ tools jar}"
+jar=$(realpath "$TLA2TOOLS_JAR")
+cd "$(dirname "$0")"
+work=$(mktemp -d "${TMPDIR:-/tmp}/unreal-operations-tlc.XXXXXX")
+trap 'rm -rf "$work"' EXIT
+run_tlc() {
+  java -Xmx512m -XX:+UseParallelGC -cp "$jar" tlc2.TLC -workers 1 -seed 1 \
+    -metadir "$work/states-$1" -noGenerateSpecTE -config "$1.cfg" \
+    OperationCheckpoint.tla > "$work/$1.log" 2>&1
+}
+for pair in 'legacy-spawn AtMostOnceSpawn' 'legacy-close SingleTerminalCheckpoint'; do
+  read -r name invariant <<< "$pair"
+  rc=0
+  run_tlc "$name" || rc=$?
+  # TLC exit 12 is an invariant violation, not a parser/tool failure.
+  if [[ "$rc" != 12 ]] || ! grep -q "Invariant $invariant is violated" "$work/$name.log"; then
+    cat "$work/$name.log"
+    echo "Expected $name counterexample for $invariant; exit=$rc" >&2
+    exit 1
+  fi
+  echo "Confirmed $name counterexample: $invariant"
+done
+if ! run_tlc fixed || ! grep -q 'Model checking completed. No error has been found.' "$work/fixed.log"; then
+  cat "$work/fixed.log"
+  exit 1
+fi
+grep -o '[0-9]* distinct states found' "$work/fixed.log"
+echo 'Both fixes hold in the model.'
