+------------------------- MODULE CoordinatorDispatch -------------------------
+EXTENDS Naturals, TLC
+
+CONSTANTS MaxCrashes, SkipStatusCommit, SkipTerminalGuard, SkipLatestOverlay
+Ops == 1..2
+Statuses == {"Absent", "Ready", "Awaiting", "Terminal"}
+Empty == [o \in Ops |-> "Absent"]
+FalseMap == [o \in Ops |-> FALSE]
+
+VARIABLES pc, cursor, crashes, committed, latest, local, localStatus,
+          added, badUncommittedAdd, badCheckpointAdd
+vars == <<pc, cursor, crashes, committed, latest, local, localStatus,
+          added, badUncommittedAdd, badCheckpointAdd>>
+
+Init ==
+    /\ pc = "translate"
+    /\ cursor = 1
+    /\ crashes = 0
+    /\ committed = FALSE
+    /\ latest = Empty
+    /\ local = Empty
+    /\ localStatus = FALSE
+    /\ added = FalseMap
+    /\ badUncommittedAdd = FALSE
+    /\ badCheckpointAdd = FALSE
+
+\* Pure Translate/Submit builds two Ready values, NOT coordinator local state.
+Translate ==
+    /\ pc = "translate"
+    /\ pc' = "install"
+    /\ cursor' = 1
+    /\ UNCHANGED <<crashes, committed, latest, local, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+\* Each addOperationToLocalState is separate, before local status application.
+Install ==
+    /\ pc = "install" /\ cursor \in Ops
+    /\ local' = [local EXCEPT ![cursor] = "Ready"]
+    /\ cursor' = cursor + 1
+    /\ UNCHANGED <<pc, crashes, committed, latest, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+ApplyStatus ==
+    /\ pc = "install" /\ cursor = 3
+    /\ localStatus' = TRUE
+    /\ pc' = "appendStatus"
+    /\ UNCHANGED <<cursor, crashes, committed, latest, local, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+\* The one durable record contains BOTH the status and ALL initial operations.
+\* Return/dispatch is not part of this atomic journal abstraction.
+AppendStatus ==
+    /\ pc = "appendStatus"
+    /\ committed' = IF SkipStatusCommit THEN committed ELSE TRUE
+    /\ latest' = IF SkipStatusCommit THEN latest
+                  ELSE [o \in Ops |-> "Ready"]
+    /\ pc' = "statusReturn"
+    /\ UNCHANGED <<cursor, crashes, local, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+StatusReturn ==
+    /\ pc = "statusReturn"
+    /\ pc' = "guard"
+    /\ cursor' = 1
+    /\ UNCHANGED <<crashes, committed, latest, local, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+\* Failures stop this invocation. A full record may nevertheless be recoverable
+\* (e.g. close reports an error). No Add is possible before a new recovery.
+StatusError(visible) ==
+    /\ pc = "appendStatus"
+    /\ committed' = (committed \/ visible)
+    /\ latest' = IF visible THEN [o \in Ops |-> "Ready"] ELSE latest
+    /\ pc' = "stopped"
+    /\ UNCHANGED <<cursor, crashes, local, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+Guard ==
+    /\ pc = "guard" /\ cursor \in Ops
+    /\ IF local[cursor] = "Terminal" /\ ~SkipTerminalGuard
+       THEN /\ cursor' = cursor + 1 /\ pc' = "guard"
+       ELSE /\ cursor' = cursor /\ pc' = "add"
+    /\ UNCHANGED <<crashes, committed, latest, local, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+\* Ghost flags record bad Add events, not a restriction on the transition.
+Add ==
+    /\ pc = "add" /\ cursor \in Ops
+    /\ badUncommittedAdd' = (badUncommittedAdd \/ ~committed)
+    /\ badCheckpointAdd' = (badCheckpointAdd
+          \/ local[cursor] = "Terminal"
+          \/ latest[cursor] # local[cursor])
+    /\ added' = [added EXCEPT ![cursor] = TRUE]
+    /\ pc' = "guard"
+    /\ cursor' = cursor + 1
+    /\ UNCHANGED <<crashes, committed, latest, local, localStatus>>
+
+DispatchDone ==
+    /\ pc = "guard" /\ cursor = 3
+    /\ pc' = "idle"
+    /\ UNCHANGED <<cursor, crashes, committed, latest, local, localStatus,
+                    added, badUncommittedAdd, badCheckpointAdd>>
+
+\* Manager updates are processed only once dispatch finishes (single loop).
+\* Monotone status abstraction; terminal outcomes are collapsed to Terminal.
+LocalUpdate(o, next) ==
+    /\ pc = "idle" /\ added[o] /\ committed
+    /\ \/ /\ local[o] = "Ready" /\ next \in {"Awaiting", "Terminal"}
+       \/ /\ local[o] = "Awaiting" /\ next = "Terminal"
+    /\ local' = [local EXCEPT ![o] = next]
+    /\ cursor' = o
+    /\ pc' = "appendUpdate"
+    /\ UNCHANGED <<crashes, committed, latest, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+AppendUpdate ==
+    /\ pc = "appendUpdate"
+    /\ latest' = [latest EXCEPT ![cursor] = local[cursor]]
+    /\ pc' = "updateReturn"
+    /\ UNCHANGED <<cursor, crashes, committed, local, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+UpdateReturn ==
+    /\ pc = "updateReturn"
+    /\ pc' = "idle"
+    /\ UNCHANGED <<cursor, crashes, committed, latest, local, localStatus,
+                    added, badUncommittedAdd, badCheckpointAdd>>
+
+UpdateError(visible) ==
+    /\ pc = "appendUpdate"
+    /\ latest' = IF visible THEN [latest EXCEPT ![cursor] = local[cursor]]
+                  ELSE latest
+    /\ pc' = "stopped"
+    /\ UNCHANGED <<cursor, crashes, committed, local, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+\* Crash at any boundary, including during replay/overlay or after an error.
+Crash ==
+    /\ crashes < MaxCrashes
+    /\ crashes' = crashes + 1
+    /\ pc' = "replay"
+    /\ cursor' = 1
+    /\ local' = Empty
+    /\ localStatus' = FALSE
+    /\ added' = FalseMap
+    /\ UNCHANGED <<committed, latest, badUncommittedAdd, badCheckpointAdd>>
+
+\* loadHistory first applies the initial status's embedded Ready snapshots.
+ReplayOperation ==
+    /\ pc = "replay" /\ cursor \in Ops
+    /\ local' = IF committed THEN [local EXCEPT ![cursor] = "Ready"]
+                 ELSE local
+    /\ cursor' = cursor + 1
+    /\ UNCHANGED <<pc, crashes, committed, latest, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+ReplayStatus ==
+    /\ pc = "replay" /\ cursor = 3
+    /\ localStatus' = committed
+    /\ pc' = "overlay"
+    /\ cursor' = 1
+    /\ UNCHANGED <<crashes, committed, latest, local, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+\* Restored.Operations overlays latest SaveOperation checkpoints, INCLUDING
+\* terminal entries still pending in history (no final tool result yet).
+Overlay ==
+    /\ pc = "overlay" /\ cursor \in Ops
+    /\ local' = IF committed /\ ~SkipLatestOverlay
+                 THEN [local EXCEPT ![cursor] = latest[cursor]] ELSE local
+    /\ cursor' = cursor + 1
+    /\ UNCHANGED <<pc, crashes, committed, latest, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+ScheduleRestored ==
+    /\ pc = "overlay" /\ cursor = 3
+    /\ pc' = IF localStatus THEN "guard" ELSE "translate"
+    /\ cursor' = 1
+    /\ UNCHANGED <<crashes, committed, latest, local, localStatus, added,
+                    badUncommittedAdd, badCheckpointAdd>>
+
+Next == Translate \/ Install \/ ApplyStatus \/ AppendStatus \/ StatusReturn
+     \/ (\E visible \in BOOLEAN : StatusError(visible))
+     \/ Guard \/ Add \/ DispatchDone
+     \/ (\E o \in Ops, next \in {"Awaiting", "Terminal"} : LocalUpdate(o, next))
+     \/ AppendUpdate \/ UpdateReturn
+     \/ (\E visible \in BOOLEAN : UpdateError(visible))
+     \/ Crash \/ ReplayOperation \/ ReplayStatus \/ Overlay \/ ScheduleRestored
+
+Spec == Init /\ [][Next]_vars
+
+TypeOK ==
+    /\ pc \in {"translate", "install", "appendStatus", "statusReturn",
+               "guard", "add", "idle", "appendUpdate", "updateReturn",
+               "stopped", "replay", "overlay"}
+    /\ cursor \in 1..3 /\ crashes \in 0..MaxCrashes
+    /\ committed \in BOOLEAN /\ localStatus \in BOOLEAN
+    /\ latest \in [Ops -> Statuses] /\ local \in [Ops -> Statuses]
+    /\ added \in [Ops -> BOOLEAN]
+    /\ badUncommittedAdd \in BOOLEAN /\ badCheckpointAdd \in BOOLEAN
+CommitBeforeAdd == ~badUncommittedAdd
+NoTerminalOrStaleAdd == ~badCheckpointAdd
+=============================================================================
diff --git a/tools/formal/models/coordinator-dispatch/bend/LAWS.bend b/tools/formal/models/coordinator-dispatch/bend/LAWS.bend
new file mode 100644
index 0000000..ce62902
--- /dev/null
+++ b/tools/formal/models/coordinator-dispatch/bend/LAWS.bend
@@ -0,0 +1,133 @@
+import Base
+import ./model.bend as M
+import ./product.bend as P
+import ./certificate.bend as C
+import ./witnesses.bend as W
+
+law commit_before_every_add:
+  for +events: List<&2, M.Event>
+  for +s: M.State
+  {M.traceCommit(events, s) == True{} : Bool}
+
+law no_terminal_or_stale_add:
+  for +events: List<&2, M.Event>
+  for +s: M.State
+  {M.traceCheckpoint(events, s) == True{} : Bool}
+
+law no_add_before_status_commit:
+  {M.audit(M.Add{}, M.Append{}) == M.NoAdd{} : M.Audit}
+
+law stale_replay_snapshot_not_dispatchable:
+  for latest: M.Status
+  {M.audit(M.Add{}, M.Replay{Some{latest}}) == M.NoAdd{} : M.Audit}
+
+law terminal_recovery_not_added:
+  {M.run([M.Crash{}, M.Advance{}, M.Advance{}, M.Advance{}, M.Add{}], M.Idle{M.Terminal{}}) == M.Idle{M.Terminal{}} : M.State}
+
+law awaiting_recovery_uses_latest:
+  {M.run([M.Crash{}, M.Advance{}, M.Advance{}, M.Advance{}], M.Idle{M.Awaiting{}}) == M.Adding{M.AwaitingLive{}} : M.State}
+
+law visible_status_error_recoverable:
+  {M.run([M.ErrorVisible{}, M.Add{}, M.Crash{}, M.Advance{}, M.Advance{}, M.Advance{}], M.Append{}) == M.Adding{M.ReadyLive{}} : M.State}
+
+law invisible_status_error_retranslates:
+  {M.run([M.ErrorInvisible{}, M.Add{}, M.Crash{}, M.Advance{}], M.Append{}) == M.Translate{} : M.State}
+
+# Local audit counterexamples, NOT reachability proofs for TLA mutation traces.
+law skip_commit_audit_rejected:
+  {M.commitSafe(M.Added{False{}, M.Ready{}, M.Ready{}}) == False{} : Bool}
+
+law skip_overlay_audit_rejected:
+  {M.checkpointSafe(M.Added{True{}, M.Ready{}, M.Awaiting{}}) == False{} : Bool}
+
+law skip_terminal_guard_audit_rejected:
+  {M.checkpointSafe(M.Added{True{}, M.Terminal{}, M.Terminal{}}) == False{} : Bool}
+
+# Rich two-operation independent-field transition model. Unlike the original
+# typestate laws above, these start from Init and establish a relational
+# reachable-state invariant, not safety from every representable state.
+
+law product_initial_invariant:
+  C.Invariant(P.initial())
+
+law product_invariant_preserved:
+  for +e: P.Boundary
+  for +s: P.Core
+  for inv: C.Invariant(s)
+  C.Invariant(P.next(P.fixed(), e, s))
+
+law product_invariant_implies_safety:
+  for +s: P.Core
+  for inv: C.Invariant(s)
+  {P.safe(s) == True{} : Bool}
+
+law product_invariant_relates_partial_cursor:
+  for +s: P.Core
+  for inv: C.Invariant(s)
+  {P.consistent(s) == True{} : Bool}
+
+law product_every_prefix_safe:
+  for +events: List<&2, P.Boundary>
+  {P.allSafe(events, P.initial()) == True{} : Bool}
+
+law product_arbitrary_crash_trace_safe:
+  for +events: List<&2, P.Boundary>
+  for +crashes: Nat
+  {P.safe(P.core(P.run(events, P.fixed(), P.State{P.initial(), crashes}))) == True{} : Bool}
+
+law product_bounded_crash_trace_safe:
+  for +events: List<&2, P.Boundary>
+  for +max: Nat
+  {P.safe(P.core(P.boundedRun(events, max, P.fixed(), P.State{P.initial(), 0n}))) == True{} : Bool}
+
+# Real mutant runs from the same independent Init, not fabricated audit values.
+law product_skip_commit_execution_violates:
+  {P.safe(P.core(P.run(W.skipCommitEvents(), W.skipCommitConfig(), P.State{P.initial(), 0n}))) == False{} : Bool}
+
+law product_skip_terminal_execution_violates:
+  {P.safe(P.core(P.run(W.skipTerminalEvents(), W.skipTerminalConfig(), P.State{P.initial(), 0n}))) == False{} : Bool}
+
+law product_skip_overlay_execution_violates:
+  {P.safe(P.core(P.run(W.skipOverlayEvents(), W.skipOverlayConfig(), P.State{P.initial(), 0n}))) == False{} : Bool}
+
+# The same event lists with the correct protocol are safe (nonvacuous controls).
+law product_fixed_commit_execution_safe:
+  {P.safe(P.core(P.run(W.skipCommitEvents(), P.fixed(), P.State{P.initial(), 0n}))) == True{} : Bool}
+
+law product_fixed_terminal_execution_safe:
+  {P.safe(P.core(P.run(W.skipTerminalEvents(), P.fixed(), P.State{P.initial(), 0n}))) == True{} : Bool}
+
+law product_fixed_overlay_execution_safe:
+  {P.safe(P.core(P.run(W.skipOverlayEvents(), P.fixed(), P.State{P.initial(), 0n}))) == True{} : Bool}
+
+law product_skip_commit_records_bad_commit:
+  {P.badCommit(P.core(P.run(W.skipCommitEvents(), W.skipCommitConfig(), P.State{P.initial(), 0n}))) == True{} : Bool}
+
+law product_skip_terminal_records_bad_checkpoint:
+  {P.badCheckpoint(P.core(P.run(W.skipTerminalEvents(), W.skipTerminalConfig(), P.State{P.initial(), 0n}))) == True{} : Bool}
+
+law product_skip_overlay_records_bad_checkpoint:
+  {P.badCheckpoint(P.core(P.run(W.skipOverlayEvents(), W.skipOverlayConfig(), P.State{P.initial(), 0n}))) == True{} : Bool}
+
+law product_two_operation_recovery:
+  {P.core(P.run(W.twoOperationRecoveryEvents(), P.fixed(), P.State{P.initial(), 0n})) == W.twoOperationRecoveryExpected() : P.Core}
+
+law product_visible_status_error_recovery:
+  {P.core(P.run(W.visibleStatusRecoveryEvents(), P.fixed(), P.State{P.initial(), 0n})) == W.visibleStatusRecoveryExpected() : P.Core}
+
+law product_invisible_status_error_recovery:
+  {P.core(P.run(W.invisibleStatusRecoveryEvents(), P.fixed(), P.State{P.initial(), 0n})) == W.invisibleStatusRecoveryExpected() : P.Core}
+
+law product_visible_update_error_recovery:
+  {P.core(P.run(W.visibleUpdateRecoveryEvents(), P.fixed(), P.State{P.initial(), 0n})) == W.visibleUpdateRecoveryExpected() : P.Core}
+
+law product_invisible_update_error_recovery:
+  {P.core(P.run(W.invisibleUpdateRecoveryEvents(), P.fixed(), P.State{P.initial(), 0n})) == W.invisibleUpdateRecoveryExpected() : P.Core}
+
+law product_partial_overlay_crash_recovery:
+  {P.core(P.run(W.partialOverlayCrashEvents(), P.fixed(), P.State{P.initial(), 0n})) == W.partialOverlayCrashExpected() : P.Core}
+
+# Reachable in the unrestricted data type, but NOT in the inductive invariant:
+# Add genuinely observes an independently false committed field.
+law product_uncommitted_add_is_not_tautologically_safe:
+  {P.badCommit(P.next(P.fixed(), P.Tick{}, P.Core{P.Add{}, P.One{}, False{}, P.ready(), P.ready(), True{}, P.noneAdded(), False{}, False{}})) == True{} : Bool}
