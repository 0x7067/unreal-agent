--- /dev/null
+++ b/tools/formal/models/review/install-bend.sh
@@ -0,0 +1,31 @@
+#!/bin/sh
+# Install Bend 2.0.27 under ~/.bend for make review-prove.
+set -eu
+
+version=2.0.27
+checksum=58adc86af6605ed0c48f7d84e4c23028f78893ce4a867a20a4f004b11582687b
+bend_bin="${HOME}/.bend/bin/bend"
+base="${HOME}/.bend/bend2/base.bend"
+
+if [ -x "$bend_bin" ] && [ -f "$base" ]; then
+	if "$bend_bin" version 2>/dev/null | grep -q "$version"; then
+		exit 0
+	fi
+fi
+
+tmpdir="$(mktemp -d)"
+trap 'rm -rf "$tmpdir"' EXIT
+
+url="https://github.com/bendlang/bend/releases/download/v${version}/bend-${version}-linux-x64.tar.gz"
+curl -fsSL "$url" -o "$tmpdir/bend.tar.gz"
+printf '%s  bend.tar.gz\n' "$checksum" | (cd "$tmpdir" && sha256sum -c)
+tar -xzf "$tmpdir/bend.tar.gz" -C "$tmpdir"
+test -x "$tmpdir/bend/bin/bend"
+test -f "$tmpdir/bend/bend2/base.bend"
+
+mkdir -p "${HOME}/.bend/bin" "${HOME}/.bend/bend2"
+cp "$tmpdir/bend/bin/bend" "$bend_bin"
+rm -rf "${HOME}/.bend/bend2"
+cp -a "$tmpdir/bend/bend2" "${HOME}/.bend/"
+
+echo "installed bend $version at $bend_bin"
diff --git a/tools/formal/models/review/prove.sh b/tools/formal/models/review/prove.sh
new file mode 100755
index 0000000..b09f989
--- /dev/null
+++ b/tools/formal/models/review/prove.sh
@@ -0,0 +1,27 @@
+#!/bin/sh
+# Review-only compatibility gate. The authoritative whole-project gate is make prove.
+# No unsafe/foreign exceptions are permitted, even if Bend exits zero.
+set -u
+export BEND_NO_TELEMETRY=1
+cd "$(dirname "$0")" || exit 1
+
+bend_bin="${BEND:-bend}"
+if ! command -v "$bend_bin" >/dev/null 2>&1 && [ -x "$HOME/.bend/bin/bend" ]; then
+  bend_bin="$HOME/.bend/bin/bend"
+fi
+
+out="$("$bend_bin" PROOF.bend --check-only 2>&1)"
+status=$?
+printf '%s\n' "$out"
+[ "$status" -eq 0 ] || exit 1
+[ "$out" = "All terms check." ] || {
+  echo "prove: bend did not report an untainted checked proof" >&2
+  exit 1
+}
+
+allowed="$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' spec/unsafe-allow.txt)"
+[ -z "$allowed" ] || {
+  echo "prove: unsafe/foreign exceptions are prohibited" >&2
+  exit 1
+}
+echo "prove: ok (review models only; use make prove for all indexed laws)"
