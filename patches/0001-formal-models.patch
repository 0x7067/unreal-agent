+#!/usr/bin/env python3
+"""Emit UNTRUSTED finite-cover proof terms, checked against product.bend.
+No Python result is assumed: decode, initial, every edge, and safety normalize
+in Bend. Even a buggy/incomplete enumerator cannot prove a missing reducer edge.
+"""
+import argparse
+from pathlib import Path
+
+EVENTS = ('Tick', 'StatusInvisible', 'StatusVisible', 'UpdateOneAwaiting',
+          'UpdateOneTerminal', 'UpdateTwoAwaiting', 'UpdateTwoTerminal',
+          'UpdateInvisible', 'UpdateVisible', 'Crash', 'Stutter')
+EMPTY = ('Absent', 'Absent')
+READY = ('Ready', 'Ready')
+INITIAL = ('Translate', 0, False, EMPTY, EMPTY, False, (False, False), False, False)
+FIXED = (False, False, False)
+
+
+def put(xs, i, v):
+    return tuple(v if k == i else x for k, x in enumerate(xs))
+
+
+def step(s, e, cfg=FIXED):
+    pc, i, co, la, lo, ls, added, bc, bk = s
+    sc, st, so = cfg
+    if e == 'Crash':
+        return ('Replay', 0, co, la, EMPTY, False, (False, False), bc, bk)
+    if e == 'Tick':
+        if pc == 'Translate': pc, i = 'Install', 0
+        elif pc == 'Install':
+            if i == 2: pc, ls = 'AppendStatus', True
+            else: lo, i = put(lo, i, 'Ready'), i + 1
+        elif pc == 'AppendStatus':
+            co, la, pc = co or not sc, la if sc else READY, 'StatusReturn'
+        elif pc == 'StatusReturn': pc, i = 'Guard', 0
+        elif pc == 'Guard':
+            if i == 2: pc = 'Idle'
+            elif lo[i] == 'Terminal' and not st: i += 1
+            else: pc = 'Add'
+        elif pc == 'Add' and i < 2:
+            bc, bk = bc or not co, bk or lo[i] == 'Terminal' or lo[i] != la[i]
+            added, pc, i = put(added, i, True), 'Guard', i + 1
+        elif pc == 'AppendUpdate': la, pc = put(la, i, lo[i]), 'UpdateReturn'
+        elif pc == 'UpdateReturn': pc = 'Idle'
+        elif pc == 'Replay':
+            if i == 2: pc, i, ls = 'Overlay', 0, co
+            else: lo, i = put(lo, i, 'Ready') if co else lo, i + 1
+        elif pc == 'Overlay':
+            if i == 2: pc, i = 'Guard' if ls else 'Translate', 0
+            else: lo, i = put(lo, i, la[i]) if co and not so else lo, i + 1
+    elif e.startswith('Status') and pc == 'AppendStatus':
+        visible = e == 'StatusVisible'
+        co, la, pc = co or visible, READY if visible else la, 'Stopped'
+    elif e.startswith('UpdateOne') or e.startswith('UpdateTwo'):
+        o = 0 if e.startswith('UpdateOne') else 1
+        v = 'Awaiting' if e.endswith('Awaiting') else 'Terminal'
+        if pc == 'Idle' and co and added[o] and (lo[o], v) in {
+                ('Ready', 'Awaiting'), ('Ready', 'Terminal'), ('Awaiting', 'Terminal')}:
+            pc, i, lo = 'AppendUpdate', o, put(lo, o, v)
+    elif e in ('UpdateInvisible', 'UpdateVisible') and pc == 'AppendUpdate':
+        la, pc = put(la, i, lo[i]) if e == 'UpdateVisible' else la, 'Stopped'
+    return pc, i, co, la, lo, ls, added, bc, bk
+
+
+def explore(cfg=FIXED, stop_bad=False):
+    states, ids, paths = [INITIAL], {INITIAL: 0}, {INITIAL: []}
+    for s in states:
+        for e in EVENTS:
+            t = step(s, e, cfg)
+            if t not in ids:
+                ids[t] = len(states)
+                states.append(t)
+                paths[t] = paths[s] + [e]
+                if stop_bad and (t[-1] or t[-2]): return paths[t], t
+    return states, ids
+
+
+def b(v): return 'True{}' if v else 'False{}'
+def core(s):
+    pc, i, co, la, lo, ls, added, bc, bk = s
+    snap = lambda p: 'P.Snapshots{' + ', '.join('P.' + x + '{}' for x in p) + '}'
+    return ('P.Core{P.' + pc + '{}, P.' + ('One', 'Two', 'End')[i] + '{}, '
+            + ', '.join((b(co), snap(la), snap(lo), b(ls),
+                         'P.Flags{' + ', '.join(map(b, added)) + '}', b(bc), b(bk))) + '}')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--check', action='store_true', help='fail if checked artifacts are stale; do not write')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent
+    def emit(name, content):
+        path = root / name
+        if args.check:
+            if not path.exists() or path.read_text() != content:
+                raise SystemExit(f"Stale generated artifact: {path}; run {Path(__file__).name}")
+        else:
+            path.write_text(content)
+    states, ids = explore()
+    assert all(not s[-1] and not s[-2] for s in states)
+    cert = ['# Generated by generate_certificate.py; checked, not trusted.',
+            'import Base', 'import ./product.bend as P', '', 'type Index is Data:']
+    cert += [f'  S{k}{{}}' for k in range(len(states))]
+    cert += ['', 'def decode(i: Index) -> P.Core:', '  match i:']
+    cert += [f'    case S{k}{{}}: {core(s)}' for k, s in enumerate(states)]
+    cert += ['', '# Explicit finite relational invariant on unrestricted Core records.',
+             'def Invariant(s: P.Core) -> Type:',
+             '  &i: Index -> {decode(i) == s : P.Core}', '']
+    emit('certificate.bend', '\n'.join(cert))
+    proof = ['# Every concrete edge is checked against the independent-field reducer.',
+             'import Base', 'import ./product.bend as P',
+             'import ./certificate.bend as C', '']
+    for e in EVENTS:
+        proof += [f'def edge{e}(i: C.Index) -> C.Invariant(P.next(P.fixed(), P.{e}{{}}, C.decode(i))):', '  match i:']
+        proof += [f'    case C.S{k}{{}}: (C.S{ids[step(s, e)]}{{}}, {{==}})' for k, s in enumerate(states)]
+        proof += ['']
+    proof += ['def closure(e: P.Boundary, i: C.Index) -> C.Invariant(P.next(P.fixed(), e, C.decode(i))):', '  match e:']
+    proof += [f'    case P.{e}{{}}: edge{e}(i)' for e in EVENTS]
+    proof += ['', 'def indexSafe(i: C.Index) -> {P.safe(C.decode(i)) == True{} : Bool}:', '  match i:']
+    proof += [f'    case C.S{k}{{}}: {{==}}' for k in range(len(states))]
+    proof += ['', 'def indexConsistent(i: C.Index) -> {P.consistent(C.decode(i)) == True{} : Bool}:', '  match i:']
+    proof += [f'    case C.S{k}{{}}: {{==}}' for k in range(len(states))]
+    emit('closure.bend', '\n'.join(proof) + '\n')
+    # Genuine mutant execution witnesses from initial(), not supplied audits.
+    wit = ['# Generated finite execution witnesses; all computations rechecked in Bend.',
+           'import Base', 'import ./product.bend as P', '']
+    for name, cfg in [('skipCommit', (True, False, False)),
+                      ('skipTerminal', (False, True, False)),
+                      ('skipOverlay', (False, False, True))]:
+        events, final = explore(cfg, True)
+        print(name, len(events), events)
+        wit += [f'def {name}Config() -> P.Config: P.Config{{' + ', '.join(map(b, cfg)) + '}',
+                f'def {name}Events() -> List<&2, P.Boundary>:',
+                '  [' + ', '.join('P.' + e + '{}' for e in events) + ']', '']
+    positive = {
+        'twoOperationRecovery': ['Tick'] * 11 + ['UpdateOneAwaiting', 'Tick', 'Tick', 'UpdateTwoTerminal', 'Tick', 'Tick', 'Crash'] + ['Tick'] * 10,
+        'visibleStatusRecovery': ['Tick'] * 4 + ['StatusVisible', 'Crash'] + ['Tick'] * 6,
+        'invisibleStatusRecovery': ['Tick'] * 4 + ['StatusInvisible', 'Crash'] + ['Tick'] * 6,
+        'visibleUpdateRecovery': ['Tick'] * 11 + ['UpdateTwoAwaiting', 'UpdateVisible', 'Crash'] + ['Tick'] * 6,
+        'invisibleUpdateRecovery': ['Tick'] * 11 + ['UpdateTwoAwaiting', 'UpdateInvisible', 'Crash'] + ['Tick'] * 6,
+        'partialOverlayCrash': ['Tick'] * 11 + ['UpdateTwoTerminal', 'Tick', 'Tick', 'Crash'] + ['Tick'] * 4 + ['Crash'] + ['Tick'] * 6,
+    }
+    for name, events in positive.items():
+        final = INITIAL
+        for e in events: final = step(final, e)
+        wit += [f'def {name}Events() -> List<&2, P.Boundary>:',
+                '  [' + ', '.join('P.' + e + '{}' for e in events) + ']',
+                f'def {name}Expected() -> P.Core:', '  ' + core(final), '']
+    emit('witnesses.bend', '\n'.join(wit))
+    print(f'{len(states)} core states, {len(states) * len(EVENTS)} checked action edges')
+
+if __name__ == '__main__': main()
diff --git a/tools/formal/models/coordinator-dispatch/bend/model.bend b/tools/formal/models/coordinator-dispatch/bend/model.bend
new file mode 100644
index 0000000..2ab2365
--- /dev/null
+++ b/tools/formal/models/coordinator-dispatch/bend/model.bend
@@ -0,0 +1,173 @@
+import Base
+
+# One-operation projection; the TLA model has two independent operations.
+type Status is Data:
+  Ready{}
+  Awaiting{}
+  Terminal{}
+
+type Live is Data:
+  ReadyLive{}
+  AwaitingLive{}
+
+def status(s: Live) -> Status:
+  match s:
+    case ReadyLive{}: Ready{}
+    case AwaitingLive{}: Awaiting{}
+
+def same(a: Status, b: Status) -> Bool:
+  match a b:
+    case Ready{} Ready{}: True{}
+    case Awaiting{} Awaiting{}: True{}
+    case Terminal{} Terminal{}: True{}
+    case _ _: False{}
+
+def nonterminal(s: Status) -> Bool:
+  match s:
+    case Terminal{}: False{}
+    case _: True{}
+
+# Typestate strengthening: dispatchable states have a single shared latest/local
+# checkpoint. Replay's initial Ready snapshot is NOT a dispatchable state.
+type State is Data:
+  Translate{}
+  Install{}
+  Apply{}
+  Append{}
+  StatusReturn{latest: Status}
+  Guard{latest: Status}
+  Adding{latest: Live}
+  Idle{latest: Status}
+  UpdatePending{latest: Status, local: Status}
+  UpdateReturn{latest: Status}
+  Stopped{durable: Maybe<&2, Status>}
+  Replay{durable: Maybe<&2, Status>}
+  Overlay{latest: Status}
+
+type Event is Data:
+  Advance{}
+  Add{}
+  ToAwaiting{}
+  ToTerminal{}
+  ErrorInvisible{}
+  ErrorVisible{}
+  Crash{}
+
+# The absence of a durable checkpoint is explicit, not a boolean assertion.
+def durable(s: State) -> Maybe<&2, Status>:
+  match s:
+    case Translate{}: None{}
+    case Install{}: None{}
+    case Apply{}: None{}
+    case Append{}: None{}
+    case StatusReturn{latest}: Some{latest}
+    case Guard{latest}: Some{latest}
+    case Adding{latest}: Some{status(latest)}
+    case Idle{latest}: Some{latest}
+    case UpdatePending{latest, _}: Some{latest}
+    case UpdateReturn{latest}: Some{latest}
+    case Stopped{d}: d
+    case Replay{d}: d
+    case Overlay{latest}: Some{latest}
+
+def guard(s: Status) -> State:
+  match s:
+    case Ready{}: Adding{ReadyLive{}}
+    case Awaiting{}: Adding{AwaitingLive{}}
+    case Terminal{}: Idle{Terminal{}}
+
+def replay(d: Maybe<&2, Status>) -> State:
+  match d:
+    case None{}: Translate{}
+    case Some{s}: Overlay{s}
+
+def advance(+s: State) -> State:
+  match s:
+    case Translate{}: Install{}
+    case Install{}: Apply{}
+    case Apply{}: Append{}
+    case Append{}: StatusReturn{Ready{}}
+    case StatusReturn{latest}: Guard{latest}
+    case Guard{latest}: guard(latest)
+    case UpdatePending{_, local}: UpdateReturn{local}
+    case UpdateReturn{latest}: Idle{latest}
+    case Replay{d}: replay(d)
+    case Overlay{latest}: Guard{latest}
+    case _: s
+
+def add(+s: State) -> State:
+  match s:
+    case Adding{latest}: Idle{status(latest)}
+    case _: s
+
+def awaiting(+s: State) -> State:
+  match s:
+    case Idle{Ready{}}: UpdatePending{Ready{}, Awaiting{}}
+    case _: s
+
+def terminal(+s: State) -> State:
+  match s:
+    case Idle{Ready{}}: UpdatePending{Ready{}, Terminal{}}
+    case Idle{Awaiting{}}: UpdatePending{Awaiting{}, Terminal{}}
+    case _: s
+
+def invisible(+s: State) -> State:
+  match s:
+    case Append{}: Stopped{None{}}
+    case UpdatePending{latest, _}: Stopped{Some{latest}}
+    case _: s
+
+def visible(+s: State) -> State:
+  match s:
+    case Append{}: Stopped{Some{Ready{}}}
+    case UpdatePending{_, local}: Stopped{Some{local}}
+    case _: s
+
+def step(e: Event, s: State) -> State:
+  match e:
+    case Advance{}: advance(s)
+    case Add{}: add(s)
+    case ToAwaiting{}: awaiting(s)
+    case ToTerminal{}: terminal(s)
+    case ErrorInvisible{}: invisible(s)
+    case ErrorVisible{}: visible(s)
+    case Crash{}: Replay{durable(s)}
+
+type Audit is Data:
+  NoAdd{}
+  Added{committed: Bool, local: Status, latest: Status}
+
+def addAudit(s: State) -> Audit:
+  match s:
+    case Adding{+latest}: Added{True{}, status(latest), status(latest)}
+    case _: NoAdd{}
+
+def audit(e: Event, s: State) -> Audit:
+  match e:
+    case Add{}: addAudit(s)
+    case _: NoAdd{}
+
+def commitSafe(a: Audit) -> Bool:
+  match a:
+    case NoAdd{}: True{}
+    case Added{committed, _, _}: committed
+
+def checkpointSafe(a: Audit) -> Bool:
+  match a:
+    case NoAdd{}: True{}
+    case Added{_, +local, latest}: Bool.and(nonterminal(local), same(local, latest))
+
+def traceCommit(+events: List<&2, Event>, +s: State) -> Bool:
+  match events:
+    case Nil{}: True{}
+    case +e <> rest: Bool.and(commitSafe(audit(e, s)), traceCommit(rest, step(e, s)))
+
+def traceCheckpoint(+events: List<&2, Event>, +s: State) -> Bool:
+  match events:
+    case Nil{}: True{}
+    case +e <> rest: Bool.and(checkpointSafe(audit(e, s)), traceCheckpoint(rest, step(e, s)))
+
+def run(events: List<&2, Event>, s: State) -> State:
+  match events:
+    case Nil{}: s
+    case e <> rest: run(rest, step(e, s))
diff --git a/tools/formal/models/coordinator-dispatch/bend/product.bend b/tools/formal/models/coordinator-dispatch/bend/product.bend
new file mode 100644
index 0000000..a41b34d
--- /dev/null
+++ b/tools/formal/models/coordinator-dispatch/bend/product.bend
@@ -0,0 +1,343 @@
+import Base
+
+# Independent two-operation record port of CoordinatorDispatch.tla. Tick chooses
+# the unique ordinary action enabled by pc/cursor; error/update/crash choices
+# are separate events. Disabled events stutter, as in [Next]_vars.
+type Status is Data:
+  Absent{}
+  Ready{}
+  Awaiting{}
+  Terminal{}
+
+type Snapshots is Data:
+  Snapshots{one: Status, two: Status}
+
+type Flags is Data:
+  Flags{one: Bool, two: Bool}
+
+type Cursor is Data:
+  One{}
+  Two{}
+  End{}
+
+type PC is Data:
+  Translate{}
+  Install{}
+  AppendStatus{}
+  StatusReturn{}
+  Guard{}
+  Add{}
+  Idle{}
+  AppendUpdate{}
+  UpdateReturn{}
+  Stopped{}
+  Replay{}
+  Overlay{}
+
+type Core is Data:
+  Core{pc: PC, cursor: Cursor, committed: Bool, latest: Snapshots, local: Snapshots,
+       localStatus: Bool, added: Flags, badCommit: Bool, badCheckpoint: Bool}
+
+type State is Data:
+  State{core: Core, crashes: Nat}
+
+type Config is Data:
+  Config{skipCommit: Bool, skipTerminal: Bool, skipOverlay: Bool}
+
+type Boundary is Data:
+  Tick{}
+  StatusInvisible{}
+  StatusVisible{}
+  UpdateOneAwaiting{}
+  UpdateOneTerminal{}
+  UpdateTwoAwaiting{}
+  UpdateTwoTerminal{}
+  UpdateInvisible{}
+  UpdateVisible{}
+  Crash{}
+  Stutter{}
+
+def fixed() -> Config: Config{False{}, False{}, False{}}
+def empty() -> Snapshots: Snapshots{Absent{}, Absent{}}
+def ready() -> Snapshots: Snapshots{Ready{}, Ready{}}
+def noneAdded() -> Flags: Flags{False{}, False{}}
+def initial() -> Core:
+  Core{Translate{}, One{}, False{}, empty(), empty(), False{}, noneAdded(), False{}, False{}}
+
+def get(p: Snapshots, i: Cursor) -> Status:
+  match p i:
+    case Snapshots{a, _} One{}: a
+    case Snapshots{_, b} Two{}: b
+    case _ End{}: Absent{}
+
+def put(p: Snapshots, i: Cursor, v: Status) -> Snapshots:
+  match p i:
+    case Snapshots{_, b} One{}: Snapshots{v, b}
+    case Snapshots{a, _} Two{}: Snapshots{a, v}
+    case Snapshots{a, b} End{}: Snapshots{a, b}
+
+def marked(p: Flags, i: Cursor) -> Bool:
+  match p i:
+    case Flags{a, _} One{}: a
+    case Flags{_, b} Two{}: b
+    case _ End{}: False{}
+
+def mark(p: Flags, i: Cursor) -> Flags:
+  match p i:
+    case Flags{_, b} One{}: Flags{True{}, b}
+    case Flags{a, _} Two{}: Flags{a, True{}}
+    case Flags{a, b} End{}: Flags{a, b}
+
+def succ(i: Cursor) -> Cursor:
+  match i:
+    case One{}: Two{}
+    case Two{}: End{}
+    case End{}: End{}
+
+def same(a: Status, b: Status) -> Bool:
+  match a b:
+    case Absent{} Absent{}: True{}
+    case Ready{} Ready{}: True{}
+    case Awaiting{} Awaiting{}: True{}
+    case Terminal{} Terminal{}: True{}
+    case _ _: False{}
+
+def terminal(a: Status) -> Bool:
+  match a:
+    case Terminal{}: True{}
+    case _: False{}
+
+def progresses(a: Status, b: Status) -> Bool:
+  match a b:
+    case Ready{} Awaiting{}: True{}
+    case Ready{} Terminal{}: True{}
+    case Awaiting{} Terminal{}: True{}
+    case _ _: False{}
+
+def choosePair(b: Bool, yes: Snapshots, no: Snapshots) -> Snapshots:
+  match b:
+    case True{}: yes
+    case False{}: no
+
+def guardPC(skip: Bool, v: Status) -> PC:
+  match skip v:
+    case False{} Terminal{}: Guard{}
+    case _ _: Add{}
+
+def guardCursor(skip: Bool, v: Status, i: Cursor) -> Cursor:
+  match skip v:
+    case False{} Terminal{}: succ(i)
+    case _ _: i
+
+def schedule(b: Bool) -> PC:
+  match b:
+    case True{}: Guard{}
+    case False{}: Translate{}
+
+# This is an actual transition, not an audit assembled with committed=True.
+# In particular Add copies the independent committed/local/latest fields.
+def tick(c: Config, +s: Core) -> Core:
+  match c s:
+    case Config{+sc, +st, so} Core{pc, +i, +co, +la, +lo, ls, a, bc, bk}:
+      match pc i:
+        case Translate{} _:
+          Core{Install{}, One{}, co, la, lo, ls, a, bc, bk}
+        case Install{} End{}:
+          Core{AppendStatus{}, End{}, co, la, lo, True{}, a, bc, bk}
+        case Install{} _:
+          Core{Install{}, succ(i), co, la, put(lo, i, Ready{}), ls, a, bc, bk}
+        case AppendStatus{} _:
+          Core{StatusReturn{}, i, Bool.or(co, Bool.not(sc)), choosePair(sc, la, ready()), lo, ls, a, bc, bk}
+        case StatusReturn{} _:
+          Core{Guard{}, One{}, co, la, lo, ls, a, bc, bk}
+        case Guard{} End{}:
+          Core{Idle{}, End{}, co, la, lo, ls, a, bc, bk}
+        case Guard{} _:
+          Core{guardPC(st, get(lo, i)), guardCursor(st, get(lo, i), i), co, la, lo, ls, a, bc, bk}
+        case Add{} End{}: s
+        case Add{} _:
+          Core{Guard{}, succ(i), co, la, lo, ls, mark(a, i), Bool.or(bc, Bool.not(co)),
+               Bool.or(bk, Bool.or(terminal(get(lo, i)), Bool.not(same(get(la, i), get(lo, i)))))}
+        case AppendUpdate{} _:
+          Core{UpdateReturn{}, i, co, put(la, i, get(lo, i)), lo, ls, a, bc, bk}
+        case UpdateReturn{} _:
+          Core{Idle{}, i, co, la, lo, ls, a, bc, bk}
+        case Replay{} End{}:
+          Core{Overlay{}, One{}, co, la, lo, co, a, bc, bk}
+        case Replay{} _:
+          Core{Replay{}, succ(i), co, la, choosePair(co, put(lo, i, Ready{}), lo), ls, a, bc, bk}
+        case Overlay{} End{}:
+          Core{schedule(ls), One{}, co, la, lo, ls, a, bc, bk}
+        case Overlay{} _:
+          Core{Overlay{}, succ(i), co, la, choosePair(Bool.and(co, Bool.not(so)), put(lo, i, get(la, i)), lo), ls, a, bc, bk}
+        case _ _: s
+
+def statusError(+visible: Bool, +s: Core) -> Core:
+  match s:
+    case Core{AppendStatus{}, i, co, la, lo, ls, a, bc, bk}:
+      Core{Stopped{}, i, Bool.or(co, visible), choosePair(visible, ready(), la), lo, ls, a, bc, bk}
+    case _: s
+
+def updateResult(enabled: Bool, +i: Cursor, v: Status, +s: Core) -> Core:
+  match enabled s:
+    case True{} Core{_, _, co, la, lo, ls, a, bc, bk}:
+      Core{AppendUpdate{}, i, co, la, put(lo, i, v), ls, a, bc, bk}
+    case False{} _: s
+
+def update(+i: Cursor, +v: Status, +s: Core) -> Core:
+  match s:
+    case Core{Idle{}, _, +co, _, +lo, _, +a, _, _}:
+      updateResult(Bool.and(co, Bool.and(marked(a, i), progresses(get(lo, i), v))), i, v, s)
+    case _: s
+
+def updateError(visible: Bool, +s: Core) -> Core:
+  match s:
+    case Core{AppendUpdate{}, +i, co, +la, +lo, ls, a, bc, bk}:
+      Core{Stopped{}, i, co, choosePair(visible, put(la, i, get(lo, i)), la), lo, ls, a, bc, bk}
+    case _: s
+
+def crash(s: Core) -> Core:
+  match s:
+    case Core{_, _, co, la, _, _, _, bc, bk}:
+      Core{Replay{}, One{}, co, la, empty(), False{}, noneAdded(), bc, bk}
+
+def next(c: Config, e: Boundary, s: Core) -> Core:
+  match e:
+    case Tick{}: tick(c, s)
+    case StatusInvisible{}: statusError(False{}, s)
+    case StatusVisible{}: statusError(True{}, s)
+    case UpdateOneAwaiting{}: update(One{}, Awaiting{}, s)
+    case UpdateOneTerminal{}: update(One{}, Terminal{}, s)
+    case UpdateTwoAwaiting{}: update(Two{}, Awaiting{}, s)
+    case UpdateTwoTerminal{}: update(Two{}, Terminal{}, s)
+    case UpdateInvisible{}: updateError(False{}, s)
+    case UpdateVisible{}: updateError(True{}, s)
+    case Crash{}: crash(s)
+    case Stutter{}: s
+
+def safe(s: Core) -> Bool:
+  match s:
+    case Core{_, _, _, _, _, _, _, bc, bk}: Bool.and(Bool.not(bc), Bool.not(bk))
+
+def crashCount(e: Boundary, n: Nat) -> Nat:
+  match e:
+    case Crash{}: 1n+n
+    case _: n
+
+def step(c: Config, +e: Boundary, s: State) -> State:
+  match s:
+    case State{x, n}: State{next(c, e, x), crashCount(e, n)}
+
+def core(s: State) -> Core:
+  match s:
+    case State{x, _}: x
+
+def run(events: List<&2, Boundary>, +c: Config, s: State) -> State:
+  match events:
+    case Nil{}: s
+    case e <> rest: run(rest, c, step(c, e, s))
+
+def allSafe(events: List<&2, Boundary>, +s: Core) -> Bool:
+  match events:
+    case Nil{}: safe(s)
+    case e <> rest: Bool.and(safe(s), allSafe(rest, next(fixed(), e, s)))
+
+# Readable companion to the finite relational invariant. These predicates refer
+# to independent fields, and explicitly describe partial replay/overlay.
+def sameSnapshots(a: Snapshots, b: Snapshots) -> Bool:
+  match a b:
+    case Snapshots{x, y} Snapshots{u, v}: Bool.and(same(x, u), same(y, v))
+
+def noAdded(a: Flags) -> Bool:
+  match a:
+    case Flags{x, y}: Bool.and(Bool.not(x), Bool.not(y))
+
+def durableShape(co: Bool, p: Snapshots) -> Bool:
+  match co p:
+    case False{} Snapshots{Absent{}, Absent{}}: True{}
+    case True{} Snapshots{Absent{}, _}: False{}
+    case True{} Snapshots{_, Absent{}}: False{}
+    case True{} _: True{}
+    case _ _: False{}
+
+def replayPrefix(co: Bool, i: Cursor) -> Snapshots:
+  match co i:
+    case False{} _: empty()
+    case True{} One{}: empty()
+    case True{} Two{}: Snapshots{Ready{}, Absent{}}
+    case True{} End{}: ready()
+
+def overlayPrefix(co: Bool, i: Cursor, la: Snapshots) -> Snapshots:
+  match co i la:
+    case False{} _ _: empty()
+    case True{} One{} _: ready()
+    case True{} Two{} Snapshots{x, _}: Snapshots{x, Ready{}}
+    case True{} End{} p: p
+
+def validCursor(i: Cursor) -> Bool:
+  match i:
+    case End{}: False{}
+    case _: True{}
+
+def dispatchRelation(+i: Cursor, co: Bool, +la: Snapshots, +lo: Snapshots, ls: Bool) -> Bool:
+  Bool.and(validCursor(i), Bool.and(co, Bool.and(ls,
+    Bool.and(sameSnapshots(la, lo), Bool.not(terminal(get(lo, i)))))))
+
+def sameBool(a: Bool, b: Bool) -> Bool:
+  match a b:
+    case True{} True{}: True{}
+    case False{} False{}: True{}
+    case _ _: False{}
+
+def phaseRelation(s: Core) -> Bool:
+  match s:
+    case Core{pc, +i, +co, +la, +lo, +ls, a, _, _}:
+      match pc:
+        case Translate{}:
+          Bool.and(Bool.not(co), Bool.and(Bool.not(ls), Bool.and(noAdded(a), sameSnapshots(lo, empty()))))
+        case Install{}:
+          Bool.and(Bool.not(co), Bool.and(Bool.not(ls), Bool.and(noAdded(a), sameSnapshots(lo, replayPrefix(True{}, i)))))
+        case AppendStatus{}:
+          Bool.and(Bool.not(co), Bool.and(ls, Bool.and(noAdded(a), sameSnapshots(lo, ready()))))
+        case StatusReturn{}:
+          Bool.and(co, Bool.and(ls, Bool.and(sameSnapshots(la, ready()), sameSnapshots(lo, ready()))))
+        case Guard{}: Bool.and(co, Bool.and(ls, sameSnapshots(lo, la)))
+        case Add{}: dispatchRelation(i, co, la, lo, ls)
+        case Idle{}: Bool.and(co, Bool.and(ls, sameSnapshots(lo, la)))
+        case AppendUpdate{}:
+          Bool.and(co, Bool.and(ls, Bool.and(validCursor(i), Bool.and(marked(a, i), sameSnapshots(put(la, i, get(lo, i)), lo)))))
+        case UpdateReturn{}: Bool.and(co, Bool.and(ls, sameSnapshots(lo, la)))
+        case Stopped{}: True{}
+        case Replay{}:
+          Bool.and(Bool.not(ls), Bool.and(noAdded(a), sameSnapshots(lo, replayPrefix(co, i))))
+        case Overlay{}:
+          Bool.and(sameBool(ls, co), Bool.and(noAdded(a), sameSnapshots(lo, overlayPrefix(co, i, la))))
+
+def consistent(+s: Core) -> Bool:
+  match s:
+    case Core{_, _, co, la, _, _, _, _, _}: Bool.and(durableShape(co, la), phaseRelation(s))
+
+# Exact MaxCrashes guard is available as well as the unbounded generalization.
+# Only Crash is gated; the budget never bounds event-list induction.
+def budgetEvent(allowed: Bool, +e: Boundary) -> Boundary:
+  match allowed e:
+    case False{} Crash{}: Stutter{}
+    case _ _: e
+
+def boundedStep(+max: Nat, c: Config, e: Boundary, s: State) -> State:
+  match s:
+    case State{x, +n}: step(c, budgetEvent(Nat.is_lt(n, max), e), State{x, n})
+
+def boundedRun(events: List<&2, Boundary>, +max: Nat, +c: Config, s: State) -> State:
+  match events:
+    case Nil{}: s
+    case e <> rest: boundedRun(rest, max, c, boundedStep(max, c, e, s))
+
+# Direct field projections for named safety and reachability statements.
+def badCommit(s: Core) -> Bool:
+  match s:
+    case Core{_, _, _, _, _, _, _, bc, _}: bc
+
+def badCheckpoint(s: Core) -> Bool:
+  match s:
+    case Core{_, _, _, _, _, _, _, _, bk}: bk
