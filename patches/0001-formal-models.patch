diff --git a/tools/formal/models/operations/OperationCheckpoint.tla b/tools/formal/models/operations/OperationCheckpoint.tla
new file mode 100644
index 0000000..98261d2
--- /dev/null
+++ b/tools/formal/models/operations/OperationCheckpoint.tla
@@ -0,0 +1,186 @@
+---------------------------- MODULE OperationCheckpoint ----------------------------
+(***************************************************************************)
+(* Abstract model of the operation manager actor (harness/operation/        *)
+(* local_manager.go), the coordinator that persists its updates            *)
+(* (harness/coordinator/loop.go handleOperationUpdate -> SaveOperation),    *)
+(* and crash/resume (Run -> dispatchOperationsToManager).                   *)
+(*                                                                         *)
+(* Two operations:                                                         *)
+(*   "shell"  - a local shell operation from its create_err phase on.      *)
+(*              Shell.resume (shell.go) fails a restored phase=process     *)
+(*              checkpoint instead of re-running the command, and re-runs  *)
+(*              any earlier phase; file creation is idempotent             *)
+(*              (useExistingPath), so create_err always succeeds again.    *)
+(*   "remote" - a remote job whose cancellation can fail                   *)
+(*              (remoteUnknown: terminal, but retained in the map) and     *)
+(*              whose handler update stream can close.                     *)
+(*                                                                         *)
+(* Fix toggles (FALSE = code as of 9700570):                               *)
+(*   ExclusiveErrCreate - the err-file create, the last step before the    *)
+(*                    process starts, fails if the file exists; a resumed  *)
+(*                    shell then fails as "outcome unknown".               *)
+(*   CloseSkipsTerm - the handler-closed branch skips operations that are  *)
+(*                    already terminal (as every other remote branch does).*)
+(***************************************************************************)
+EXTENDS Naturals, Sequences
+
+CONSTANTS ExclusiveErrCreate, CloseSkipsTerm, MaxCrashes
+
+Ops == {"shell", "remote"}
+NoUpdate == [op |-> "none", term |-> FALSE, phase |-> "none"]
+
+VARIABLES
+  up,          \* runtime (manager + coordinator) alive
+  crashes,
+  \* manager-local, volatile
+  phase,       \* shell phase in the manager: "none" (not admitted), "create_err", "process", "done"
+  active,      \* shell primitive in flight: "none", "create", "process"
+  errFile,     \* the shell's err file exists (filesystem: survives crashes)
+  rmap,        \* remote op retained in the manager map
+  rterm,       \* remote op terminal in the manager
+  runknown,    \* remote outcome unknown (retained after terminal)
+  hopen,       \* remote handler update stream open
+  queue,       \* pendingUpdates + Updates channel, FIFO, volatile
+  \* durable (session store)
+  stored,      \* op -> [term, phase]
+  \* ghost history, survives crashes
+  spawns,      \* number of times the shell command process was started
+  termWrites   \* op -> number of terminal checkpoints written
+
+vars == <<up, crashes, phase, active, errFile, rmap, rterm, runknown, hopen,
+          queue, stored, spawns, termWrites>>
+
+Upd(o, t, p) == [op |-> o, term |-> t, phase |-> p]
+
+Init ==
+  /\ up = TRUE
+  /\ crashes = 0
+  \* The shell op is mid-flight: create_err is durable and its create runs.
+  /\ phase = "create_err"
+  /\ active = "create"
+  /\ errFile = FALSE
+  /\ rmap = TRUE
+  /\ rterm = FALSE
+  /\ runknown = FALSE
+  /\ hopen = TRUE
+  /\ queue = <<>>
+  /\ stored = [o \in Ops |-> IF o = "shell"
+                             THEN [term |-> FALSE, phase |-> "create_err"]
+                             ELSE [term |-> FALSE, phase |-> "none"]]
+  /\ spawns = 0
+  /\ termWrites = [o \in Ops |-> 0]
+
+------------------------------------------------------------------------------
+(* Shell operation, acceptLocalStep: appendLocalUpdate then startLocalPrimitive *)
+
+CreateErrDone ==
+  /\ up /\ phase = "create_err" /\ active = "create"
+  /\ IF ExclusiveErrCreate /\ errFile
+       \* Exclusive create fails: the shell fails as outcome unknown.
+       THEN /\ phase' = "done" /\ active' = "none"
+            /\ queue' = Append(queue, Upd("shell", TRUE, "done"))
+            /\ UNCHANGED <<spawns, errFile>>
+       \* useExistingPath (or a fresh create) succeeds, then process starts.
+       ELSE /\ phase' = "process" /\ active' = "process" /\ errFile' = TRUE
+            /\ queue' = Append(queue, Upd("shell", FALSE, "process"))
+            /\ spawns' = spawns + 1
+  /\ UNCHANGED <<up, crashes, rmap, rterm, runknown, hopen, stored, termWrites>>
+
+ProcessExit ==
+  /\ up /\ active = "process"
+  /\ active' = "none"
+  /\ phase' = "done"
+  /\ queue' = Append(queue, Upd("shell", TRUE, "done"))
+  /\ UNCHANGED <<up, crashes, errFile, rmap, rterm, runknown, hopen, stored, spawns, termWrites>>
+
+------------------------------------------------------------------------------
+(* Remote job *)
+
+\* requestCancellation error: remoteUnknown, failLocalOperation emits Failed,
+\* finishOwned keeps the op because remoteUnknown.
+CancelFails ==
+  /\ up /\ rmap /\ ~rterm
+  /\ rterm' = TRUE /\ runknown' = TRUE
+  /\ queue' = Append(queue, Upd("remote", TRUE, "none"))
+  /\ UNCHANGED <<up, crashes, phase, active, errFile, rmap, hopen, stored, spawns, termWrites>>
+
+\* A handler terminal update. For a retained unknown op it only releases it.
+RemoteFinishes ==
+  /\ up /\ rmap /\ hopen
+  /\ IF rterm
+       THEN UNCHANGED queue
+       ELSE queue' = Append(queue, Upd("remote", TRUE, "none"))
+  /\ rmap' = FALSE /\ rterm' = TRUE /\ runknown' = FALSE
+  /\ UNCHANGED <<up, crashes, phase, active, errFile, hopen, stored, spawns, termWrites>>
+
+\* update.closed: every op of the handler is failed via failLocalOperation.
+HandlerCloses ==
+  /\ up /\ hopen
+  /\ hopen' = FALSE
+  /\ IF rmap /\ ~(CloseSkipsTerm /\ rterm)
+       THEN /\ queue' = Append(queue, Upd("remote", TRUE, "none"))
+            /\ rterm' = TRUE /\ runknown' = TRUE
+       ELSE UNCHANGED <<queue, rterm, runknown>>
+  /\ UNCHANGED <<up, crashes, phase, active, errFile, rmap, stored, spawns, termWrites>>
+
+------------------------------------------------------------------------------
+(* Coordinator: handleOperationUpdate stores every update unconditionally. *)
+
+Persist ==
+  /\ up /\ queue /= <<>>
+  /\ LET u == Head(queue) IN
+       /\ stored' = [stored EXCEPT ![u.op] = [term |-> u.term, phase |-> u.phase]]
+       /\ termWrites' = IF u.term THEN [termWrites EXCEPT ![u.op] = @ + 1] ELSE termWrites
+  /\ queue' = Tail(queue)
+  /\ UNCHANGED <<up, crashes, phase, active, errFile, rmap, rterm, runknown, hopen, spawns>>
+
+------------------------------------------------------------------------------
+(* Crash and resume.  A crash loses all volatile state; resume re-adds every  *)
+(* stored nonterminal operation (dispatchOperationsToManager).               *)
+
+Crash ==
+  /\ up /\ crashes < MaxCrashes
+  /\ up' = FALSE /\ crashes' = crashes + 1
+  /\ queue' = <<>>
+  /\ phase' = "none" /\ active' = "none"
+  /\ rmap' = FALSE /\ rterm' = FALSE /\ runknown' = FALSE /\ hopen' = FALSE
+  /\ UNCHANGED <<errFile, stored, spawns, termWrites>>
+
+Resume ==
+  /\ ~up
+  /\ up' = TRUE /\ hopen' = TRUE
+  /\ IF stored["shell"].term
+       THEN UNCHANGED <<phase, active, queue>>
+       ELSE IF stored["shell"].phase = "process"
+         \* Shell.resume: a restored process phase fails, never re-runs.
+         THEN /\ phase' = "done" /\ active' = "none"
+              /\ queue' = <<Upd("shell", TRUE, "done")>>
+         \* Any earlier phase is re-dispatched (create_err stands for the lagging phases).
+         ELSE /\ phase' = stored["shell"].phase /\ active' = "create"
+              /\ queue' = <<>>
+  /\ rmap' = ~stored["remote"].term
+  /\ UNCHANGED <<crashes, errFile, rterm, runknown, stored, spawns, termWrites>>
+
+Next ==
+  \/ CreateErrDone \/ ProcessExit
+  \/ CancelFails \/ RemoteFinishes \/ HandlerCloses
+  \/ Persist \/ Crash \/ Resume
+
+Spec == Init /\ [][Next]_vars
+
+------------------------------------------------------------------------------
+TypeOK ==
+  /\ up \in BOOLEAN /\ crashes \in 0..MaxCrashes
+  /\ phase \in {"none", "create_err", "process", "done"}
+  /\ active \in {"none", "create", "process"}
+  /\ spawns \in Nat
+  /\ termWrites \in [Ops -> Nat]
+
+\* The shell command must run at most once (Shell.resume refuses to re-run a
+\* recorded process phase precisely to guarantee this).
+AtMostOnceSpawn == spawns <= 1
+
+\* An operation reaches exactly one durable terminal checkpoint: the result the
+\* model was shown must not be silently rewritten.
+SingleTerminalCheckpoint == \A o \in Ops : termWrites[o] <= 1
+==============================================================================
diff --git a/tools/formal/models/operations/bend/LAWS.bend b/tools/formal/models/operations/bend/LAWS.bend
new file mode 100644
index 0000000..63287ed
--- /dev/null
+++ b/tools/formal/models/operations/bend/LAWS.bend
@@ -0,0 +1,156 @@
+import Base
+import ./model.bend as M
+import ./product.bend as P
+import ./certificate.bend as C
+import ./witnesses.bend as W
+
+law exclusive_file_prevents_respawn:
+  for +attempts: List<&2, Bool>
+  {M.shellSpawns(attempts, True{}) == 0n : Nat}
+
+law at_most_once_shell_spawn:
+  for +attempts: List<&2, Bool>
+  {Nat.is_le(M.shellSpawns(attempts, False{}), 1n) == True{} : Bool}
+
+law stored_terminal_never_rewritten:
+  for +events: List<&2, M.Event>
+  for +location: M.Location
+  {M.terminalWrites(events, M.Stored{location}) == 0n : Nat}
+
+law single_remote_terminal_checkpoint:
+  for +events: List<&2, M.Event>
+  for +s: M.Remote
+  {Nat.is_le(M.terminalWrites(events, s), 1n) == True{} : Bool}
+
+law legacy_spawn_retries_twice:
+  {M.legacySpawns([True{}, False{}, True{}]) == 2n : Nat}
+
+law fixed_spawn_retries_once:
+  {M.shellSpawns([True{}, False{}, True{}], False{}) == 1n : Nat}
+
+law close_skips_retained_terminal:
+  {M.close(M.UnknownQueued{}) == M.UnknownQueued{} : M.Remote}
+
+law legacy_duplicate_queue_writes_twice:
+  {M.cancelThenCloseWrites(False{}) == 2n : Nat}
+
+law queued_terminal_lost_on_crash:
+  {M.terminalWrites([M.CancelFails{}, M.Crash{}, M.Resume{}, M.HandlerCloses{}, M.Persist{}], M.Active{}) == 1n : Nat}
+
+
+law fixed_cancel_then_close_writes_once:
+  {M.cancelThenCloseWrites(True{}) == 1n : Nat}
+
+
+# Full shared-FIFO product. The crash counter is unbounded and not used as fuel.
+# The finite cover constrains independent fields by reachable-state relations;
+# Persist remains unconditional and can violate safety outside this invariant.
+law product_initial_invariant:
+  C.Invariant(P.initial())
+
+law product_invariant_preserved:
+  for +e: P.Boundary
+  for +s: P.Core
+  for inv: C.Invariant(s)
+  C.Invariant(P.next(P.fixed(), e, s))
+
+law product_invariant_implies_safety:
+  for +s: P.Core
+  for inv: C.Invariant(s)
+  {P.safe(s) == True{} : Bool}
+
+law product_every_prefix_safe:
+  for +events: List<&2, P.Boundary>
+  {P.allSafe(events, P.initial()) == True{} : Bool}
+
+law product_arbitrary_crash_trace_safe:
+  for +events: List<&2, P.Boundary>
+  for +crashes: Nat
+  {P.safe(P.core(P.run(events, P.fixed(), P.State{P.initial(), crashes}))) == True{} : Bool}
+
+law product_invariant_queue_accounting:
+  for +s: P.Core
+  for inv: C.Invariant(s)
+  {P.queueAccounting(s) == True{} : Bool}
+
+law product_invariant_durable_history:
+  for +s: P.Core
+  for inv: C.Invariant(s)
+  {P.durableHistory(s) == True{} : Bool}
+
+law product_invariant_queue_bound:
+  for +s: P.Core
+  for inv: C.Invariant(s)
+  {P.queueBound(s) == True{} : Bool}
+
+law product_at_most_once_spawn:
+  for +events: List<&2, P.Boundary>
+  for +crashes: Nat
+  {Nat.is_le(P.spawnCount(P.core(P.run(events, P.fixed(), P.State{P.initial(), crashes}))), 1n) == True{} : Bool}
+
+# o ranges over BOTH Shell and Remote, not just the old remote projection.
+law product_single_terminal_checkpoint:
+  for +o: P.Op
+  for +events: List<&2, P.Boundary>
+  for +crashes: Nat
+  {Nat.is_le(P.terminalWrites(o, P.core(P.run(events, P.fixed(), P.State{P.initial(), crashes}))), 1n) == True{} : Bool}
+
+law product_trace_queue_accounting:
+  for +events: List<&2, P.Boundary>
+  for +crashes: Nat
+  {P.queueAccounting(P.core(P.run(events, P.fixed(), P.State{P.initial(), crashes}))) == True{} : Bool}
+
+# Every intermediate independent-field state of the failing execution.
+law legacy_product_spawn_execution:
+  {W.spawnTrace() == [
+    P.State{P.Core{True{}, P.CreateErr{}, P.Creating{}, False{}, True{}, False{}, False{}, True{}, [], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 0n, 0n, 0n}, 0n},
+    P.State{P.Core{True{}, P.Process{}, P.Running{}, True{}, True{}, False{}, False{}, True{}, [P.Update{P.Shell{}, P.Checkpoint{False{}, P.Process{}}}], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 1n, 0n, 0n}, 0n},
+    P.State{P.Core{False{}, P.NoPhase{}, P.NoActive{}, True{}, False{}, False{}, False{}, False{}, [], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 1n, 0n, 0n}, 1n},
+    P.State{P.Core{True{}, P.CreateErr{}, P.Creating{}, True{}, True{}, False{}, False{}, True{}, [], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 1n, 0n, 0n}, 1n},
+    P.State{P.Core{True{}, P.Process{}, P.Running{}, True{}, True{}, False{}, False{}, True{}, [P.Update{P.Shell{}, P.Checkpoint{False{}, P.Process{}}}], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 2n, 0n, 0n}, 1n}
+  ] : List<&2, P.State>}
+
+# Every intermediate independent-field state of the failing execution.
+law legacy_product_close_execution:
+  {W.closeTrace() == [
+    P.State{P.Core{True{}, P.CreateErr{}, P.Creating{}, False{}, True{}, False{}, False{}, True{}, [], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 0n, 0n, 0n}, 0n},
+    P.State{P.Core{True{}, P.CreateErr{}, P.Creating{}, False{}, True{}, True{}, True{}, True{}, [P.Update{P.Remote{}, P.Checkpoint{True{}, P.NoPhase{}}}], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 0n, 0n, 0n}, 0n},
+    P.State{P.Core{True{}, P.CreateErr{}, P.Creating{}, False{}, True{}, True{}, True{}, False{}, [P.Update{P.Remote{}, P.Checkpoint{True{}, P.NoPhase{}}}, P.Update{P.Remote{}, P.Checkpoint{True{}, P.NoPhase{}}}], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 0n, 0n, 0n}, 0n},
+    P.State{P.Core{True{}, P.CreateErr{}, P.Creating{}, False{}, True{}, True{}, True{}, False{}, [P.Update{P.Remote{}, P.Checkpoint{True{}, P.NoPhase{}}}], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{True{}, P.NoPhase{}}, 0n, 0n, 1n}, 0n},
+    P.State{P.Core{True{}, P.CreateErr{}, P.Creating{}, False{}, True{}, True{}, True{}, False{}, [], P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{True{}, P.NoPhase{}}, 0n, 0n, 2n}, 0n}
+  ] : List<&2, P.State>}
+
+
+law legacy_product_spawn_violates_safety:
+  {P.safe(W.finalSpawn(W.legacySpawn())) == False{} : Bool}
+
+law legacy_product_spawn_count_two:
+  {P.spawnCount(W.finalSpawn(W.legacySpawn())) == 2n : Nat}
+
+law legacy_product_close_violates_safety:
+  {P.safe(W.finalClose(W.legacyClose())) == False{} : Bool}
+
+law legacy_product_close_writes_two:
+  {P.terminalWrites(P.Remote{}, W.finalClose(W.legacyClose())) == 2n : Nat}
+
+law fixed_product_same_spawn_trace_safe:
+  {P.safe(W.finalSpawn(P.fixed())) == True{} : Bool}
+
+law fixed_product_same_close_trace_safe:
+  {P.terminalWrites(P.Remote{}, W.finalClose(P.fixed())) == 1n : Nat}
+
+law product_shared_fifo_interleaving:
+  {W.afterInterleaving() == P.Core{True{}, P.PhaseDone{}, P.NoActive{}, True{}, True{}, True{}, True{}, True{},
+    [P.Update{P.Shell{}, P.Checkpoint{False{}, P.Process{}}},
+     P.Update{P.Remote{}, P.Checkpoint{True{}, P.NoPhase{}}},
+     P.Update{P.Shell{}, P.Checkpoint{True{}, P.PhaseDone{}}}],
+    P.Checkpoint{False{}, P.CreateErr{}}, P.Checkpoint{False{}, P.NoPhase{}}, 1n, 0n, 0n} : P.Core}
+
+law product_restored_process_never_respawns:
+  {P.spawnCount(W.storedProcessResume()) == 1n : Nat}
+
+law product_restored_process_writes_terminal:
+  {P.terminalWrites(P.Shell{}, W.storedProcessResume()) == 1n : Nat}
+
+law product_dropped_remote_terminal_regenerated_once:
+  {P.terminalWrites(P.Remote{}, W.droppedRemoteTerminal()) == 1n : Nat}
diff --git a/tools/formal/models/operations/bend/PROOF.bend b/tools/formal/models/operations/bend/PROOF.bend
