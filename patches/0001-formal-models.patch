diff --git a/tools/formal/models/taskgraph/Checkpoint.tla b/tools/formal/models/taskgraph/Checkpoint.tla
new file mode 100644
index 0000000..365f44a
--- /dev/null
+++ b/tools/formal/models/taskgraph/Checkpoint.tla
@@ -0,0 +1,63 @@
+--------------------------- MODULE Checkpoint ---------------------------
+EXTENDS Naturals, FiniteSets
+
+\* Finite abstraction of Graph.Validate + validateAttempts at runtime.add's
+\* restore boundary. Declarations are canonical and valid, versions/generations
+\* are valid, accepted evidence is nonblank, and required shell children and
+\* fingerprints are well-formed. Only the cross-node checks vary here.
+CONSTANT Fixed
+Tasks == {"A", "B"}
+Statuses == {"pending", "running", "canceling", "completed",
+             "accepted", "failed", "canceled"}
+Active(s) == s \in {"running", "canceling"}
+Reserved(s) == Active(s) \/ s = "completed"
+NeedsChild(s) == Reserved(s) \/ s = "accepted"
+
+VARIABLES status, stale, dependent, conflicting, cap, childID, restored
+vars == <<status, stale, dependent, conflicting, cap, childID, restored>>
+
+\* A can write "shared" while B only reads it (legal one-way interference),
+\* or both have empty claims. dependent means B depends on A (acyclic).
+\* childID abstracts CURRENT attempts only; obsolete attempts do not match
+\* runtime.child's generation guard. Pending/failed/canceled attempts are
+\* omitted here. Go regressions additionally cover optional current attempts.
+TypeOK == /\ status \in [Tasks -> Statuses]
+          /\ stale \in [Tasks -> BOOLEAN]
+          /\ dependent \in BOOLEAN
+          /\ conflicting \in BOOLEAN
+          /\ cap \in {1, 2}
+          /\ childID \in [Tasks -> {1, 2}]
+          /\ restored \in BOOLEAN
+
+PrerequisitesOK(t) == t # "B" \/ ~dependent \/
+                       (status["A"] = "accepted" /\ ~stale["A"])
+LegacyValid == /\ \A t \in Tasks : stale[t] => Active(status[t])
+               /\ \A t \in Tasks : status[t] = "accepted" => PrerequisitesOK(t)
+
+ClaimExclusion == ~(conflicting /\ Reserved(status["A"]) /\
+                                    Reserved(status["B"]))
+ConcurrencyBound == Cardinality({t \in Tasks : Active(status[t])}) <= cap
+DependencyGating == \A t \in Tasks :
+    ((Active(status[t]) /\ ~stale[t]) \/
+     status[t] \in {"completed", "accepted"}) => PrerequisitesOK(t)
+UniqueChildren == \A a, b \in Tasks :
+    (a # b /\ NeedsChild(status[a]) /\ NeedsChild(status[b])) =>
+       childID[a] # childID[b]
+CrossNodeSafety == ClaimExclusion /\ ConcurrencyBound /\
+                   DependencyGating /\ UniqueChildren
+Valid == LegacyValid /\ (IF Fixed THEN CrossNodeSafety ELSE TRUE)
+
+\* Enumerate supplied checkpoints, not just states produced by legal reducer
+\* events: Start already enforces these checks, which hid the restore gap.
+Init == /\ TypeOK /\ ~restored
+Restore == /\ ~restored /\ Valid /\ restored' = TRUE
+           /\ UNCHANGED <<status, stale, dependent, conflicting, cap, childID>>
+Next == Restore \/ UNCHANGED vars
+Spec == Init /\ [][Next]_vars
+
+SafeClaims == restored => ClaimExclusion
+SafeConcurrency == restored => ConcurrencyBound
+SafeDependencies == restored => DependencyGating
+SafeChildIdentity == restored => UniqueChildren
+SafeRestore == restored => CrossNodeSafety
+=============================================================================
diff --git a/tools/formal/models/taskgraph/ChildRouting.tla b/tools/formal/models/taskgraph/ChildRouting.tla
new file mode 100644
index 0000000..f41fbc7
--- /dev/null
+++ b/tools/formal/models/taskgraph/ChildRouting.tla
@@ -0,0 +1,33 @@
+-------------------------- MODULE ChildRouting --------------------------
+EXTENDS Naturals
+CONSTANT Fixed
+VARIABLES ids, status, phase, delivered
+vars == <<ids, status, phase, delivered>>
+
+\* Two independent running tasks, current generation 1, empty claims,
+\* concurrency 2. Both persisted shell children are already terminal.
+\* readOnlyFingerprint and output Fingerprint succeed, so completion succeeds.
+Init == /\ ids \in [1..2 -> {1, 2}]
+        /\ status = [t \in 1..2 |-> "running"]
+        /\ phase = "disk" /\ delivered = 0
+Restore == /\ phase = "disk"
+           /\ phase' = IF Fixed /\ ids[1] = ids[2] THEN "rejected" ELSE "resume"
+           /\ UNCHANGED <<ids, status, delivered>>
+
+\* runtime.add iterates nodes and calls child(a.ChildOperation) for each
+\* terminal child. runtime.child scans nodes in order and RETURNS on its first
+\* ID/current-generation match, even if that node is already Completed.
+Deliver == /\ phase = "resume" /\ delivered < 2
+           /\ LET incoming == ids[delivered + 1]
+                  target == IF ids[1] = incoming THEN 1 ELSE 2
+              IN status' = IF status[target] = "running"
+                           THEN [status EXCEPT ![target] = "completed"]
+                           ELSE status
+           /\ delivered' = delivered + 1
+           /\ phase' = IF delivered' = 2 THEN "done" ELSE "resume"
+           /\ UNCHANGED ids
+Next == Restore \/ Deliver \/ UNCHANGED vars
+Spec == Init /\ [][Next]_vars
+AllTerminalChildrenRetired == phase = "done" =>
+                             (\A t \in 1..2 : status[t] = "completed")
+=============================================================================
diff --git a/tools/formal/models/taskgraph/bend/LAWS.bend b/tools/formal/models/taskgraph/bend/LAWS.bend
new file mode 100644
index 0000000..abf84cc
--- /dev/null
+++ b/tools/formal/models/taskgraph/bend/LAWS.bend
@@ -0,0 +1,55 @@
+import Base
+import ./model.bend as M
+
+law restored_cross_node_safety:
+  for +c: M.Checkpoint
+  for ok: {M.restore(c) == True{} : Bool}
+  {M.cross(c) == True{} : Bool}
+
+law restored_claim_exclusion:
+  for +c: M.Checkpoint
+  for ok: {M.restore(c) == True{} : Bool}
+  {M.claims(c) == True{} : Bool}
+
+law restored_concurrency_bound:
+  for +c: M.Checkpoint
+  for ok: {M.restore(c) == True{} : Bool}
+  {M.concurrency(c) == True{} : Bool}
+
+law restored_dependency_gating:
+  for +c: M.Checkpoint
+  for ok: {M.restore(c) == True{} : Bool}
+  {M.dependencies(c) == True{} : Bool}
+
+law restored_unique_children:
+  for +c: M.Checkpoint
+  for ok: {M.restore(c) == True{} : Bool}
+  {M.identity(c) == True{} : Bool}
+
+law every_restore_attempt_safe:
+  for +cs: List<&2, M.Checkpoint>
+  {M.historySafe(cs) == True{} : Bool}
+
+law terminal_children_retired:
+  for a: Bool
+  for b: Bool
+  {M.routing(a, b) == True{} : Bool}
+
+law legacy_duplicate_children_rejected:
+  {M.valid(M.Checkpoint{M.Node{M.Running{}, False{}, False{}}, M.Node{M.Running{}, False{}, False{}}, False{}, False{}, True{}}) == False{} : Bool}
+
+law legacy_routing_loses_second_child:
+  {M.deliverSecond(False{}, False{}, M.deliver(False{}, False{}, False{}, False{}, False{})) == False{} : Bool}
+
+# Each checkpoint is LegacyValid but fails precisely the named cross-node check.
+law legacy_claims_counterexample:
+  {(M.legacy(M.Checkpoint{M.Node{M.Completed{}, False{}, False{}}, M.Node{M.Completed{}, False{}, True{}}, False{}, True{}, True{}}), M.claims(M.Checkpoint{M.Node{M.Completed{}, False{}, False{}}, M.Node{M.Completed{}, False{}, True{}}, False{}, True{}, True{}})) == (True{}, False{}) : Bool & Bool}
+
+law legacy_concurrency_counterexample:
+  {(M.legacy(M.Checkpoint{M.Node{M.Running{}, False{}, False{}}, M.Node{M.Running{}, False{}, True{}}, False{}, False{}, False{}}), M.concurrency(M.Checkpoint{M.Node{M.Running{}, False{}, False{}}, M.Node{M.Running{}, False{}, True{}}, False{}, False{}, False{}})) == (True{}, False{}) : Bool & Bool}
+
+law legacy_dependencies_counterexample:
+  {(M.legacy(M.Checkpoint{M.Node{M.Pending{}, False{}, False{}}, M.Node{M.Running{}, False{}, True{}}, True{}, False{}, True{}}), M.dependencies(M.Checkpoint{M.Node{M.Pending{}, False{}, False{}}, M.Node{M.Running{}, False{}, True{}}, True{}, False{}, True{}})) == (True{}, False{}) : Bool & Bool}
+
+law legacy_identity_counterexample:
+  {(M.legacy(M.Checkpoint{M.Node{M.Running{}, False{}, False{}}, M.Node{M.Running{}, False{}, False{}}, False{}, False{}, True{}}), M.identity(M.Checkpoint{M.Node{M.Running{}, False{}, False{}}, M.Node{M.Running{}, False{}, False{}}, False{}, False{}, True{}})) == (True{}, False{}) : Bool & Bool}
diff --git a/tools/formal/models/taskgraph/bend/PROOF.bend b/tools/formal/models/taskgraph/bend/PROOF.bend
new file mode 100644
index 0000000..279b120
--- /dev/null
+++ b/tools/formal/models/taskgraph/bend/PROOF.bend
@@ -0,0 +1,58 @@
+import Base
+import ./model.bend as M
+import ./LAWS.bend as Laws
+
+def left(a: Bool, b: Bool, ok: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
+  match a:
+    case True{}: {==}
+    case False{}: ok
+
+def right(a: Bool, b: Bool, ok: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
+  match a b:
+    case True{} b: ok
+    case False{} True{}: {==}
+    case False{} False{}: ok
+
+def admissionSafe(a: Bool, b: Bool) -> {Bool.or(Bool.not(Bool.and(a, b)), b) == True{} : Bool}:
+  match a b:
+    case False{} _: {==}
+    case True{} False{}: {==}
+    case True{} True{}: {==}
+
+def Laws.restored_cross_node_safety(c, ok):
+  right(M.legacy(c), M.cross(c), ok)
+
+def Laws.restored_claim_exclusion(c, ok):
+  left(M.claims(c), Bool.and(M.concurrency(c), Bool.and(M.dependencies(c), M.identity(c))), Laws.restored_cross_node_safety(c, ok))
+
+def Laws.restored_concurrency_bound(c, ok):
+  left(M.concurrency(c), Bool.and(M.dependencies(c), M.identity(c)), right(M.claims(c), Bool.and(M.concurrency(c), Bool.and(M.dependencies(c), M.identity(c))), Laws.restored_cross_node_safety(c, ok)))
+
+def Laws.restored_dependency_gating(c, ok):
+  left(M.dependencies(c), M.identity(c), right(M.concurrency(c), Bool.and(M.dependencies(c), M.identity(c)), right(M.claims(c), Bool.and(M.concurrency(c), Bool.and(M.dependencies(c), M.identity(c))), Laws.restored_cross_node_safety(c, ok))))
+
+def Laws.restored_unique_children(c, ok):
+  right(M.dependencies(c), M.identity(c), right(M.concurrency(c), Bool.and(M.dependencies(c), M.identity(c)), right(M.claims(c), Bool.and(M.concurrency(c), Bool.and(M.dependencies(c), M.identity(c))), Laws.restored_cross_node_safety(c, ok))))
+
+def Laws.every_restore_attempt_safe(cs):
+  match cs:
+    case Nil{}: {==}
+    case +c <> rest:
+      %Equal.sym(Bool, M.acceptedSafe(c), True{}, admissionSafe(M.legacy(c), M.cross(c))) : {Bool.and(_, M.historySafe(rest)) == True{} : Bool}
+      Laws.every_restore_attempt_safe(rest)
+
+def Laws.terminal_children_retired(a, b):
+  match a b:
+    case False{} False{}: {==}
+    case False{} True{}: {==}
+    case True{} False{}: {==}
+    case True{} True{}: {==}
+
+def Laws.legacy_duplicate_children_rejected(): {==}
+
+def Laws.legacy_routing_loses_second_child(): {==}
+
+def Laws.legacy_claims_counterexample(): {==}
+def Laws.legacy_concurrency_counterexample(): {==}
+def Laws.legacy_dependencies_counterexample(): {==}
+def Laws.legacy_identity_counterexample(): {==}
diff --git a/tools/formal/models/taskgraph/bend/model.bend b/tools/formal/models/taskgraph/bend/model.bend
new file mode 100644
index 0000000..d7fc719
--- /dev/null
+++ b/tools/formal/models/taskgraph/bend/model.bend
@@ -0,0 +1,131 @@
+import Base
+
+def eq(a: Bool, b: Bool) -> Bool:
+  match a b:
+    case False{} False{}: True{}
+    case True{} True{}: True{}
+    case _ _: False{}
+
+type Status is Data:
+  Pending{}
+  Running{}
+  Canceling{}
+  Completed{}
+  Accepted{}
+  Failed{}
+  Canceled{}
+
+type Node is Data:
+  Node{status: Status, stale: Bool, child: Bool}
+
+type Checkpoint is Data:
+  Checkpoint{a: Node, b: Node, dependent: Bool, conflicting: Bool, capTwo: Bool}
+
+def active(s: Status) -> Bool:
+  match s:
+    case Running{}: True{}
+    case Canceling{}: True{}
+    case _: False{}
+
+def reserved(+s: Status) -> Bool:
+  match s:
+    case Completed{}: True{}
+    case _: active(s)
+
+def needsChild(+s: Status) -> Bool:
+  match s:
+    case Accepted{}: True{}
+    case _: reserved(s)
+
+def accepted(s: Status) -> Bool:
+  match s:
+    case Accepted{}: True{}
+    case _: False{}
+
+def needsPrereq(+s: Status, stale: Bool) -> Bool:
+  match s:
+    case Completed{}: True{}
+    case Accepted{}: True{}
+    case _: Bool.and(active(s), Bool.not(stale))
+
+def claims(c: Checkpoint) -> Bool:
+  match c:
+    case Checkpoint{Node{a, _, _}, Node{b, _, _}, _, conflict, _}:
+      Bool.not(Bool.and(conflict, Bool.and(reserved(a), reserved(b))))
+
+def concurrency(c: Checkpoint) -> Bool:
+  match c:
+    case Checkpoint{Node{a, _, _}, Node{b, _, _}, _, _, capTwo}:
+      Bool.or(capTwo, Bool.not(Bool.and(active(a), active(b))))
+
+def dependencies(c: Checkpoint) -> Bool:
+  match c:
+    case Checkpoint{Node{a, staleA, _}, Node{b, staleB, _}, dependent, _, _}:
+      Bool.or(Bool.not(Bool.and(dependent, needsPrereq(b, staleB))), Bool.and(accepted(a), Bool.not(staleA)))
+
+def identity(c: Checkpoint) -> Bool:
+  match c:
+    case Checkpoint{Node{a, _, idA}, Node{b, _, idB}, _, _, _}:
+      Bool.not(Bool.and(Bool.and(needsChild(a), needsChild(b)), eq(idA, idB)))
+
+def legacyNode(n: Node) -> Bool:
+  match n:
+    case Node{s, stale, _}:
+      Bool.or(Bool.not(stale), active(s))
+
+def legacyAccepted(a: Node, b: Node, dep: Bool) -> Bool:
+  match a b:
+    case Node{sa, staleA, _} Node{sb, _, _}:
+      Bool.or(Bool.not(Bool.and(dep, accepted(sb))), Bool.and(accepted(sa), Bool.not(staleA)))
+
+def legacy(+c: Checkpoint) -> Bool:
+  match c:
+    case Checkpoint{+a, +b, dep, conflict, cap}:
+      Bool.and(legacyNode(a), Bool.and(legacyNode(b), legacyAccepted(a, b, dep)))
+
+def cross(+c: Checkpoint) -> Bool:
+  Bool.and(claims(c), Bool.and(concurrency(c), Bool.and(dependencies(c), identity(c))))
+
+def valid(+c: Checkpoint) -> Bool:
+  Bool.and(legacy(c), cross(c))
+
+# Restore only changes the restored marker; invalid candidates leave it false.
+def restore(c: Checkpoint) -> Bool:
+  valid(c)
+
+# All attempts in a finite restore history satisfy safety on acceptance.
+def acceptedSafe(+c: Checkpoint) -> Bool:
+  Bool.or(Bool.not(restore(c)), cross(c))
+
+def historySafe(cs: List<&2, Checkpoint>) -> Bool:
+  match cs:
+    case Nil{}: True{}
+    case c <> rest: Bool.and(acceptedSafe(c), historySafe(rest))
+
+# Exact ChildRouting fixed.cfg universe: IDs 1/2 represented by False/True.
+# Running=False, Completed=True. The first-ID match wins even if completed.
+def route(first: Bool, sa: Bool, sb: Bool) -> Bool & Bool:
+  match first:
+    case True{}: (True{}, sb)
+    case False{}: (sa, True{})
+
+def deliver(+a: Bool, b: Bool, incoming: Bool, sa: Bool, sb: Bool) -> Bool & Bool:
+  route(eq(a, incoming), sa, sb)
+
+def retired(states: Bool & Bool) -> Bool:
+  match states:
+    case (sa, sb): Bool.and(sa, sb)
+
+# Rejected duplicate-ID checkpoints satisfy the done=>all-completed implication
+# vacuously; accepted unique IDs actually run both delivery steps.
+def deliverSecond(a: Bool, +b: Bool, states: Bool & Bool) -> Bool:
+  match states:
+    case (sa, sb): retired(deliver(a, b, b, sa, sb))
+
+def routingGuard(duplicate: Bool, +a: Bool, +b: Bool) -> Bool:
+  match duplicate:
+    case True{}: True{}
+    case False{}: deliverSecond(a, b, deliver(a, b, a, False{}, False{}))
+
+def routing(+a: Bool, +b: Bool) -> Bool:
+  routingGuard(eq(a, b), a, b)
diff --git a/tools/formal/models/taskgraph/check.sh b/tools/formal/models/taskgraph/check.sh
new file mode 100755
index 0000000..ad75558
--- /dev/null
+++ b/tools/formal/models/taskgraph/check.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# Supply a local tla2tools.jar; this script never downloads or vendors binaries.
+set -euo pipefail
+: "${TLA2TOOLS_JAR:?Set TLA2TOOLS_JAR to the TLA+ tools v1.8.0 jar}"
+jar=$(realpath "$TLA2TOOLS_JAR")
+cd "$(dirname "$0")"
+work=$(mktemp -d "${TMPDIR:-/tmp}/unreal-checkpoint-tlc.XXXXXX")
+trap 'rm -rf "$work"' EXIT
+run_tlc() {
+  java -Xmx512m -XX:+UseParallelGC -cp "$jar" tlc2.TLC -workers 1 -seed 1 \
+    -metadir "$work/states-$1" -noGenerateSpecTE -config "$1.cfg" \
+    "${2:-Checkpoint}.tla" > "$work/$1.log" 2>&1
+}
+for pair in 'claims SafeClaims' 'concurrency SafeConcurrency' \
+            'dependencies SafeDependencies' 'identity SafeChildIdentity'; do
+  read -r name invariant <<< "$pair"
+  rc=0
+  run_tlc "legacy-$name" || rc=$?
+  # TLC exit 12 is an invariant violation, not a parser/tool failure.
+  if [[ "$rc" != 12 ]] || ! grep -q "Invariant $invariant is violated" "$work/legacy-$name.log"; then
+    cat "$work/legacy-$name.log"
+    echo "Expected legacy counterexample for $invariant; exit=$rc" >&2
+    exit 1
+  fi
+  echo "Confirmed legacy counterexample: $invariant"
+  cat "$work/legacy-$name.log"
+done
+if ! run_tlc fixed; then
+  cat "$work/fixed.log"
+  exit 1
+fi
+cat "$work/fixed.log"
+grep -q 'Model checking completed. No error has been found.' "$work/fixed.log"
+rc=0
+run_tlc routing-legacy ChildRouting || rc=$?
+if [[ "$rc" != 12 ]] || ! grep -q 'Invariant AllTerminalChildrenRetired is violated' "$work/routing-legacy.log"; then
+  cat "$work/routing-legacy.log"
+  echo "Expected duplicate-ID completion counterexample; exit=$rc" >&2
+  exit 1
+fi
+cat "$work/routing-legacy.log"
+if ! run_tlc routing-fixed ChildRouting; then
+  cat "$work/routing-fixed.log"
+  exit 1
+fi
+cat "$work/routing-fixed.log"
+grep -q 'Model checking completed. No error has been found.' "$work/routing-fixed.log"
+echo 'All expected legacy failures and fixed restore/routing invariants verified.'
