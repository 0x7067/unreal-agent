index 0000000..2c7f72b
--- /dev/null
+++ b/tools/formal/models/handoff/bend/generation.bend
@@ -0,0 +1,146 @@
+import Base
+
+# Independent live-process collection and current pointer, not one field
+# derived from the other. Unbounded generation IDs, at most one process per
+# reachable state. A process remains live during admitted retirement.
+type Reload is Data:
+  Idle{}
+  Staging{}
+  Staged{}
+  Fenced{}
+  Awaiting{}
+
+type Status is Data:
+  Ready{}
+  Stopped{}
+
+type State is Data:
+  Host{live: List<&2, Nat>, current: Maybe<&2, Nat>, reload: Reload, retired: Bool, failed: Bool, status: Status}
+
+type Event is Data:
+  Begin{}
+  ProbeOK{}
+  ProbeBad{}
+  Fence{}
+  Quiesce{}
+  Abort{}
+  Exit{}
+  Launch{id: Nat}
+
+def initial() -> State:
+  Host{[0n], Some{0n}, Idle{}, False{}, False{}, Ready{}}
+
+def ownerList(owner: Maybe<&2, Nat>) -> List<&2, Nat>:
+  match owner:
+    case None{}:
+      []
+    case Some{pid}:
+      [pid]
+
+def Own(s: State) -> Data:
+  Host{live, current, r, retired, failed, status} = s
+  {live == ownerList(current) : List<&2, Nat>}
+
+def statusSafeCur(cur: Maybe<&2, Nat>, status: Status) -> Data:
+  match cur:
+    case None{}:
+      {status == Stopped{} : Status}
+    case Some{pid}:
+      Unit
+
+def StatusSafe(s: State) -> Data:
+  Host{live, cur, r, retired, failed, status} = s
+  statusSafeCur(cur, status)
+
+# A reload remains single-flight through every phase. Stage acceptance stands
+# for a successful compatible identity probe, not a proof of the probe IO.
+def begin(+s: State) -> State:
+  match s:
+    case Host{live, cur, Idle{}, retired, False{}, status}:
+      Host{live, cur, Staging{}, retired, False{}, status}
+    case other:
+      s
+
+def probe(+s: State, ok: Bool) -> State:
+  match s ok:
+    case Host{live, cur, Staging{}, retired, failed, status} True{}:
+      Host{live, cur, Staged{}, retired, failed, status}
+    case Host{live, cur, Staging{}, retired, failed, status} False{}:
+      Host{live, cur, Idle{}, retired, failed, status}
+    case other b:
+      s
+
+def fence(+s: State) -> State:
+  match s:
+    case Host{live, cur, Staged{}, retired, failed, status}:
+      Host{live, cur, Fenced{}, retired, failed, status}
+    case other:
+      s
+
+def quiesce(+s: State) -> State:
+  match s:
+    case Host{live, Some{pid}, Fenced{}, retired, failed, status}:
+      Host{live, Some{pid}, Awaiting{}, True{}, failed, status}
+    case other:
+      s
+
+def abort(s: State) -> State:
+  Host{live, cur, r, retired, failed, status} = s
+  Host{live, cur, Idle{}, retired, failed, status}
+
+# Reap the current generation, including after a caller abandoned its reload.
+# Corrected publication is explicit: stopped is published even after Abort.
+# Crashes latch failure, so they cannot enable a later Launch.
+def exit(+s: State) -> State:
+  Host{live, cur, r, retired, failed, status} = s
+  Host{[], None{}, r, retired, Bool.or(failed, Bool.not(retired)), Stopped{}}
+
+# A replacement cannot start until the independently tracked live collection
+# is empty. No worker + proven retirement also permits explicit recovery after
+# an abandoned handoff. As in the Lean model, hello/ready is abstract here.
+def launch(+s: State, +id: Nat) -> State:
+  match s:
+    case Host{Nil{}, None{}, Awaiting{}, True{}, False{}, status}:
+      Host{[id], Some{id}, Idle{}, False{}, False{}, Ready{}}
+    case Host{Nil{}, None{}, Fenced{}, True{}, False{}, status}:
+      Host{[id], Some{id}, Idle{}, False{}, False{}, Ready{}}
+    case other:
+      s
+
+def step(s: State, e: Event) -> State:
+  match e:
+    case Begin{}:
+      begin(s)
+    case ProbeOK{}:
+      probe(s, True{})
+    case ProbeBad{}:
+      probe(s, False{})
+    case Fence{}:
+      fence(s)
+    case Quiesce{}:
+      quiesce(s)
+    case Abort{}:
+      abort(s)
+    case Exit{}:
+      exit(s)
+    case Launch{id}:
+      launch(s, id)
+
+def run(es: List<&2, Event>, s: State) -> State:
+  match es:
+    case Nil{}:
+      s
+    case e <> rest:
+      run(rest, step(s, e))
+
+# These projections make one case analysis suffice for every lifecycle event.
+def current(s: State) -> Maybe<&2, Nat>:
+  Host{live, cur, r, retired, failed, status} = s
+  cur
+
+def live(s: State) -> List<&2, Nat>:
+  Host{live, cur, r, retired, failed, status} = s
+  live
+
+def Safe(+s: State) -> Data:
+  Sigma<&2, &2, Own(s), _ => StatusSafe(s)>
diff --git a/tools/formal/models/handoff/bend/inbox.bend b/tools/formal/models/handoff/bend/inbox.bend
new file mode 100644
index 0000000..b5e5add
--- /dev/null
+++ b/tools/formal/models/handoff/bend/inbox.bend
@@ -0,0 +1,106 @@
+import Base
+import ./lists.bend as L
+
+# One actor, arbitrary Nat input identities, unbounded FIFOs and traces.
+# seen is in reverse first-admission order, not a bounded ID set.
+type Phase is Data:
+  Open{}
+  Frozen{}
+
+type Box is Data:
+  Inbox{phase: Phase, seen: List<&2, Nat>, queue: List<&2, Nat>, handed: List<&2, Nat>, delivered: List<&2, Nat>}
+
+type Event is Data:
+  Admit{id: Nat}
+  Emit{}
+  Freeze{}
+  ProcessHanded{}
+  Thaw{}
+
+def initial() -> Box:
+  Inbox{Open{}, [], [], [], []}
+
+# Disabled commands stutter. Admit abstracts successful actor receipt;
+# blocked caller submissions and duplicate receipts need no extra queue.
+def admitOpen(+s: Box, +id: Nat, dup: Bool) -> Box:
+  match s dup:
+    case Inbox{p, seen, q, h, d} True{}:
+      s
+    case Inbox{p, seen, q, h, d} False{}:
+      Inbox{p, id <> seen, L.append(q, [id]), h, d}
+
+def admit(+s: Box, +id: Nat) -> Box:
+  match s:
+    case Inbox{Frozen{}, seen, q, h, d}:
+      s
+    case Inbox{Open{}, seen, q, h, d}:
+      admitOpen(s, id, L.contains(id, seen))
+
+def emit(+s: Box) -> Box:
+  match s:
+    case Inbox{Open{}, seen, x <> q, h, d}:
+      Inbox{Open{}, seen, q, h, L.append(d, [x])}
+    case other:
+      s
+
+def freeze(+s: Box) -> Box:
+  match s:
+    case Inbox{Open{}, seen, q, h, d}:
+      Inbox{Frozen{}, seen, [], L.append(h, q), d}
+    case other:
+      s
+
+def process(+s: Box) -> Box:
+  match s:
+    case Inbox{Frozen{}, seen, q, x <> h, d}:
+      Inbox{Frozen{}, seen, q, h, L.append(d, [x])}
+    case other:
+      s
+
+def thaw(+s: Box) -> Box:
+  match s:
+    case Inbox{Frozen{}, seen, q, Nil{}, d}:
+      Inbox{Open{}, seen, q, [], d}
+    case other:
+      s
+
+def step(s: Box, e: Event) -> Box:
+  match e:
+    case Admit{id}:
+      admit(s, id)
+    case Emit{}:
+      emit(s)
+    case Freeze{}:
+      freeze(s)
+    case ProcessHanded{}:
+      process(s)
+    case Thaw{}:
+      thaw(s)
+
+def run(es: List<&2, Event>, s: Box) -> Box:
+  match es:
+    case Nil{}:
+      s
+    case e <> rest:
+      run(rest, step(s, e))
+
+def order(+s: Box) -> List<&2, Nat>:
+  Inbox{p, seen, q, h, d} = s
+  L.reverse(seen)
+
+def accounted(+s: Box) -> List<&2, Nat>:
+  Inbox{p, seen, q, h, d} = s
+  L.append(d, L.append(h, q))
+
+def phaseSafe(s: Box) -> Data:
+  match s:
+    case Inbox{Open{}, seen, q, h, d}:
+      {h == [] : List<&2, Nat>}
+    case Inbox{Frozen{}, seen, q, h, d}:
+      {q == [] : List<&2, Nat>}
+
+# Conservation is an equality of entire ordered sequences, not just membership:
+# every admitted ID is delivered, held by Freeze's caller, or still queued.
+def Safe(+s: Box) -> Data:
+  Inbox{p, seen, q, h, d} = s
+  Sigma<&2, &2, {order(s) == accounted(s) : List<&2, Nat>}, _ => Sigma<&2, &2, {L.unique(seen) == True{} : Bool}, _ => phaseSafe(s)>>
diff --git a/tools/formal/models/handoff/bend/journal.bend b/tools/formal/models/handoff/bend/journal.bend
