+++ b/tools/formal/models/review/spec/witnesses.txt
@@ -0,0 +1,121 @@
+# Law-to-Go-test witness manifest.
+#
+# Every law in LAWS.bend must appear in exactly one section. A law is
+# `witnessed` when a named Go test asserts the same rule against the real
+# implementation; otherwise it is `model-only`, meaning the Bend proof is the
+# only check and the Go code is covered only by its own behavioral tests.
+#
+# Adding a law without classifying it here fails TestLawsClassified. A
+# witnessed name must match a `func <Name>(` in the repo; renames break loudly.
+[witnessed]
+cluster_perm	TestClusterFilesHoldsBendInvariants
+cluster_caps	TestClusterFilesHoldsBendInvariants
+cap_is_fifty	TestBendModelInlineCapMatchesGo
+planned_direct_threshold	TestBendPlanCapsMatchGo
+planned_prompt_cap	TestBendPlanCapsMatchGo
+omitted_status_complete	TestReportComplete
+running_not_complete	TestReportComplete
+normalize_end_omitted	TestAppendFindingNormalizesLikeParse
+normalize_anchor_omitted	TestAppendFindingNormalizesLikeParse
+clean_summary_without_findings	TestCheckSummaryMatchesVerdictToFindings
+clean_summary_with_findings_rejected	TestCheckSummaryMatchesVerdictToFindings
+verdict_summary_with_findings	TestCheckSummaryMatchesVerdictToFindings
+verdict_summary_without_findings_rejected	TestCheckSummaryMatchesVerdictToFindings
+new_is_right	TestHistoryReportedReadsBackWhatWasPosted
+old_is_left	TestHistoryReportedReadsBackWhatWasPosted
