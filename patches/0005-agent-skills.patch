Subject: [PATCH] agent skills: add TUI verification scripts

Adds the agent-facing scripts used to drive and inspect the TUI during verification.
---
 .../scripts/fake_model.py                     | 54 ++++++++++++++++++
 .../verify-unreal-agent-tui/scripts/tui.sh    | 56 +++++++++++++++++++
 2 files changed, 110 insertions(+)
 create mode 100644 .claude/skills/verify-unreal-agent-tui/scripts/fake_model.py
 create mode 100755 .claude/skills/verify-unreal-agent-tui/scripts/tui.sh

diff --git a/.claude/skills/verify-unreal-agent-tui/scripts/fake_model.py b/.claude/skills/verify-unreal-agent-tui/scripts/fake_model.py
new file mode 100644
index 0000000..f66d18a
--- /dev/null
+++ b/.claude/skills/verify-unreal-agent-tui/scripts/fake_model.py
@@ -0,0 +1,54 @@
+"""Fake OpenAI Responses endpoint for driving the TUI without credentials.
+
+Usage: python3 -I fake_model.py PORT TOOL_CALLS MESSAGES
+
+The first request in a turn gets TOOL_CALLS Bash calls (`echo N`); the
+request carrying their outputs gets MESSAGES markdown paragraphs back.
+"""
+
+import json
+import sys
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+port, tool_calls, messages = (int(arg) for arg in sys.argv[1:4])
+counter = 0
+
+
+def response(output):
+    global counter
+    counter += 1
+    return {
+        "id": f"resp-{counter}",
+        "status": "completed",
+        "output": output,
+        "usage": {"input_tokens": 1, "output_tokens": 1},
+    }
+
+
+def message(text):
+    return {"id": f"msg-{counter}", "type": "message", "role": "assistant", "status": "completed",
+            "content": [{"type": "output_text", "text": text}]}
+
+
+class Handler(BaseHTTPRequestHandler):
+    def do_POST(self):
+        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+        last = body["input"][-1] if body.get("input") else {}
+        if last.get("type") == "function_call_output":
+            paragraphs = [f"## Result {i}\n\nCommand {i} **finished**; output is in the Tools pane." for i in range(messages)]
+            payload = response([message("\n\n".join(paragraphs))])
+        else:
+            calls = [{"id": f"fc-{counter}-{i}", "type": "function_call", "call_id": f"call-{counter}-{i}", "name": "Bash",
+                      "arguments": json.dumps({"command": f"echo {i}"}), "status": "completed"} for i in range(tool_calls)]
+            payload = response([message(f"Running {tool_calls} commands.")] + calls)
+        data = json.dumps({"type": "response.completed", "response": payload})
+        self.send_response(200)
+        self.send_header("Content-Type", "text/event-stream")
+        self.end_headers()
+        self.wfile.write(f"data: {data}\n\n".encode())
+
+    def log_message(self, *_):
+        pass
+
+
+ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
diff --git a/.claude/skills/verify-unreal-agent-tui/scripts/tui.sh b/.claude/skills/verify-unreal-agent-tui/scripts/tui.sh
new file mode 100755
index 0000000..3b544b2
--- /dev/null
+++ b/.claude/skills/verify-unreal-agent-tui/scripts/tui.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+# Drive bin/unreal-agent-tui in an isolated tmux session against the fake model.
+# Usage: tui.sh start RUN_DIR [TOOL_CALLS] [MESSAGES] [COLS] [ROWS]
+#        tui.sh doctor RUN_DIR
+#        tui.sh keys RUN_DIR KEY...          (tmux send-keys syntax)
+#        tui.sh click RUN_DIR COL ROW        (1-based, left button, SGR mouse)
+#        tui.sh wheel RUN_DIR COL ROW up|down
+#        tui.sh snap RUN_DIR NAME            (writes RUN_DIR/evidence/NAME.txt)
+#        tui.sh stop RUN_DIR
+set -euo pipefail
+cmd=$1 run=$2
+shift 2
+session="tui-$(basename "$run" | tr '.:' '__')"
+repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
+
+case $cmd in
+start)
+  calls=${1:-120} messages=${2:-3} cols=${3:-160} rows=${4:-50}
+  mkdir -p "$run"/{workspace,state,config,evidence}
+  port=$(python3 -I -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
+  python3 -I "$repo/.claude/skills/verify-unreal-agent-tui/scripts/fake_model.py" "$port" "$calls" "$messages" &
+  echo $! >"$run/fake.pid"
+  echo "$port" >"$run/port"
+  tmux new-session -d -s "$session" -x "$cols" -y "$rows" -c "$run/workspace" \
+    "env XDG_STATE_HOME=$run/state XDG_CONFIG_HOME=$run/config OPENAI_API_KEY=fake \
+     $repo/bin/unreal-agent-tui -provider openai -model fake -base-url http://127.0.0.1:$port 2>$run/stderr.txt"
+  for _ in $(seq 50); do
+    tmux capture-pane -p -t "$session" | grep -q "Send a message" && exit 0
+    sleep 0.2
+  done
+  echo "TUI not ready; see $run/stderr.txt" >&2
+  exit 1
+  ;;
+doctor)
+  tmux has-session -t "$session" && echo "tmux session $session: up"
+  kill -0 "$(cat "$run/fake.pid")" && echo "fake model pid $(cat "$run/fake.pid") on port $(cat "$run/port"): up"
+  echo "binary: $(git -C "$repo" rev-parse --short HEAD) $(stat "$repo/bin/unreal-agent-tui")"
+  ;;
+keys) tmux send-keys -t "$session" "$@" ;;
+click)
+  tmux send-keys -t "$session" -l $'\e[<0;'"$1;$2"'M'
+  tmux send-keys -t "$session" -l $'\e[<0;'"$1;$2"'m'
+  ;;
+wheel)
+  button=64
+  [ "$3" = down ] && button=65
+  tmux send-keys -t "$session" -l $'\e[<'"$button;$1;$2"'M'
+  ;;
+snap) tmux capture-pane -p -t "$session" >"$run/evidence/$1.txt" && cat "$run/evidence/$1.txt" ;;
+stop)
+  tmux kill-session -t "$session" 2>/dev/null || true
+  kill "$(cat "$run/fake.pid")" 2>/dev/null || true
+  rm -rf "$run"/{workspace,state,config}
+  ;;
+*) echo "unknown command $cmd" >&2; exit 2 ;;
+esac
