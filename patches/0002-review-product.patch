+workspace_run_lines() {
+	local file=$1
+	python3 - "$file" <<'PY'
+import sys
+text = open(sys.argv[1]).read()
+runs = [line for line in text.splitlines() if "unreal-agent-runner review run" in line]
+if not runs:
+    sys.exit("no run line")
+for line in runs:
+    for flag in ("--from", "--to", "--commit", "--branch"):
+        if flag in line.split():
+            sys.exit(f"{flag} in {line}")
+if "working tree" not in text or "hello.txt" not in text or "extra.txt" not in text:
+    sys.exit(text)
+PY
+}
