new file mode 100644
index 0000000..eab0e41
--- /dev/null
+++ b/cmd/internal/reviewcli/render.go
@@ -0,0 +1,238 @@
+package reviewcli
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/unreallabsai/unreal-agent/cmd/internal/review/diffmap"
+	"github.com/unreallabsai/unreal-agent/cmd/internal/review/github"
+	"github.com/unreallabsai/unreal-agent/cmd/internal/review/render"
+	"github.com/unreallabsai/unreal-agent/review/findings"
+)
+
+func cmdRender(args []string) error {
+	if len(args) == 0 {
+		return fmt.Errorf("render target required: github or markdown")
+	}
+	switch args[0] {
+	case "github":
+		return renderGitHub(args[1:])
+	case "markdown":
+		return renderMarkdown(args[1:])
+	case "-h", "--help", "help":
+		return printUsage(os.Stdout)
+	default:
+		return fmt.Errorf("unknown render target %q", args[0])
+	}
+}
+
+func registerMarkdownFlags(fs *flag.FlagSet) *string {
+	return fs.String("out", "-", "output path, or - for stdout")
+}
+
+func renderMarkdown(args []string) (err error) {
+	fs := flag.NewFlagSet("render markdown", flag.ContinueOnError)
+	fs.SetOutput(os.Stderr)
+	outPath := registerMarkdownFlags(fs)
+	if err := fs.Parse(args); err != nil {
+		return successOnHelp(err)
+	}
+	report, err := loadReport(fs.Arg(0))
+	if err != nil {
+		return err
+	}
+	out, err := openOut(*outPath)
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, out.Close()) }()
+	return render.Markdown(out, report)
+}
+
+type githubFlags struct {
+	pr, repo, commit *string
+	dryRun           *bool
+}
+
+func registerGitHubFlags(fs *flag.FlagSet) githubFlags {
+	return githubFlags{
+		pr:     fs.String("pr", "", "pull request: owner/repo#n, a URL, or a number"),
+		repo:   fs.String("repo", os.Getenv("GITHUB_REPOSITORY"), "owner/repo when --pr is a number"),
+		commit: fs.String("commit", "", "commit SHA for inline comments (default: PR head)"),
+		dryRun: fs.Bool("dry-run", false, "print the review payload instead of posting"),
+	}
+}
+
+func renderGitHub(args []string) error {
+	fs := flag.NewFlagSet("render github", flag.ContinueOnError)
+	fs.SetOutput(os.Stderr)
+	f := registerGitHubFlags(fs)
+	if err := fs.Parse(args); err != nil {
+		return successOnHelp(err)
+	}
+	report, err := loadReport(fs.Arg(0))
+	if err != nil {
+		return err
+	}
+	if !*f.dryRun && !report.Complete() {
+		status := findings.StatusRunning
+		if report.Run != nil && report.Run.Status != "" {
+			status = report.Run.Status
+		}
+		return fmt.Errorf("findings are %s; resume the review before posting", status)
+	}
+	owner, name, number, err := resolvePR(*f.pr, *f.repo)
+	if err != nil {
+		return err
+	}
+	token := secret("GH_TOKEN")
+	client, err := githubClient(token)
+	if err != nil {
+		return err
+	}
+	opts := render.GitHubOptions{
+		Owner:      owner,
+		Repo:       name,
+		PullNumber: number,
+		CommitID:   *f.commit,
+	}
+	var (
+		state           github.PullState
+		priorStatus     github.Status
+		statusCommentID int64
+	)
+	if token != "" {
+		ctx := context.Background()
+		pullState, err := client.PullState(ctx, owner, name, number)
+		if err != nil {
+			return err
+		}
+		state = pullState
+		priorStatus, statusCommentID, err = client.LatestStatusComment(ctx, owner, name, number)
+		if err != nil {
+			return err
+		}
+		if opts.CommitID == "" {
+			opts.CommitID = state.HeadSHA
+		}
+		if report.Run != nil && report.Run.Source.HeadSHA != "" && opts.CommitID != report.Run.Source.HeadSHA {
+			return fmt.Errorf("findings review %s but the pull request head is %s; rerun the review before posting", report.Run.Source.HeadSHA, opts.CommitID)
+		}
+		files, err := client.ListPullFiles(ctx, owner, name, number)
+		if err != nil {
+			return err
+		}
+		lines := diffmap.New()
+		for _, file := range files {
+			if file.Patch == "" {
+				continue
+			}
+			if err := diffmap.MergePatch(lines, file.Path, file.Patch); err != nil {
+				return fmt.Errorf("parse patch for %s: %w", file.Path, err)
+			}
+		}
+		opts.Lines = lines
+		opts.HasLines = true
+		opts.History = render.HistoryOf(state)
+	}
+	result := render.GitHub(report, opts)
+	if *f.dryRun {
+		enc := json.NewEncoder(os.Stdout)
+		enc.SetEscapeHTML(false)
+		enc.SetIndent("", "  ")
+		return enc.Encode(result.Payload)
+	}
+	if token == "" {
+		return fmt.Errorf("set GH_TOKEN to post a review")
+	}
+	ctx := context.Background()
+	if result.PostReview() {
+		if err := client.CreateReview(ctx, result.Payload); err != nil {
+			return err
+		}
+	}
+	cost := runCost(report)
+	status := render.StatusBody(render.RunSummary{
+		HeadSHA: opts.CommitID,
+		Runs:    priorStatus.Runs + 1,
+		Cost:    cost,
+		Total:   priorStatus.CostUSD + cost.AmountUSD,
+		Result:  result,
+		Summary: report.Summary,
+	})
+	if err := client.UpsertStatusComment(ctx, owner, name, number, statusCommentID, status); err != nil {
+		return err
+	}
+	receipted, err := client.HasSuccessfulCheck(ctx, owner, name, opts.CommitID, checkName)
+	if err != nil {
+		return err
+	}
+	if !receipted && result.Receipt() {
+		if err := client.CreateCheckRun(ctx, owner, name, opts.CommitID, checkName, "unreal-review", "Review posted."); err != nil {
+			return err
+		}
+	}
+	reportPosted(result, cost)
+	return nil
+}
+
+func runCost(report findings.Report) findings.Cost {
+	if report.Run == nil {
+		return findings.Cost{Currency: "USD"}
+	}
+	return report.Run.Cost
+}
+
+func reportPosted(result render.GitHubResult, cost findings.Cost) {
+	if len(result.Payload.Review.Comments) > 0 {
+		fmt.Fprintf(os.Stderr, "posted %d inline comment(s)", len(result.Payload.Review.Comments))
+	} else if result.LGTM && result.LGTMPosted {
+		fmt.Fprint(os.Stderr, "LGTM already posted")
+	} else if result.LGTM {
+		fmt.Fprint(os.Stderr, "posted LGTM")
+	} else {
+		fmt.Fprint(os.Stderr, "posted no review")
+	}
+	if len(result.Duplicates) > 0 {
+		fmt.Fprintf(os.Stderr, ", %d already reported", len(result.Duplicates))
+	}
+	if len(result.Dropped) > 0 {
+		fmt.Fprintf(os.Stderr, ", dropped %d", len(result.Dropped))
+	}
+	fmt.Fprintln(os.Stderr)
+	fmt.Fprintf(os.Stderr, "cost: %s\n", cost.Format())
+}
+
+func loadReport(path string) (report findings.Report, err error) {
+	var r io.ReadCloser
+	if path == "" || path == "-" {
+		r = io.NopCloser(os.Stdin)
+	} else {
+		r, err = os.Open(path)
+		if err != nil {
+			return findings.Report{}, fmt.Errorf("open %s: %w", path, err)
+		}
+	}
+	defer func() { _ = r.Close() }() //nolint:errcheck // closing the findings file must not fail a successful parse
+	return findings.Parse(r)
+}
+
+func resolvePR(spec, repo string) (string, string, int, error) {
+	defaultOwner, defaultRepo := "", ""
+	if repo != "" {
+		var err error
+		defaultOwner, defaultRepo, err = github.SplitRepo(repo)
+		if err != nil {
+			return "", "", 0, err
+		}
+	}
+	if spec == "" {
+		return "", "", 0, fmt.Errorf("set --pr")
+	}
+	return github.ParsePR(spec, defaultOwner, defaultRepo)
+}
diff --git a/cmd/internal/reviewcli/run.go b/cmd/internal/reviewcli/run.go
new file mode 100644
index 0000000..fa05137
--- /dev/null
+++ b/cmd/internal/reviewcli/run.go
@@ -0,0 +1,210 @@
+package reviewcli
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/unreallabsai/unreal-agent/cmd/internal/providers"
+	"github.com/unreallabsai/unreal-agent/cmd/internal/review/agent"
+	review "github.com/unreallabsai/unreal-agent/cmd/internal/review/core"
+	"github.com/unreallabsai/unreal-agent/review/findings"
+)
+
+type runFlags struct {
+	workspace, pr, repo, outPath, model, thinking, strategy, agentLog *string
+	fresh, decompose                                                  *bool
+	timeout                                                           *time.Duration
+	spec                                                              specFlags
+	exclude                                                           *stringList
+}
+
+func registerRunFlags(fs *flag.FlagSet) runFlags {
+	var f runFlags
+	f.workspace = fs.String("workspace", ".", "git repository to review")
+	f.spec = addSpecFlags(fs)
+	f.pr = fs.String("pr", "", "pull request to review: owner/repo#n, a URL, or a number")
+	f.repo = fs.String("repo", os.Getenv("GITHUB_REPOSITORY"), "owner/repo when --pr is a number")
+	// Heap-allocate so Parse updates the returned flags, not a discarded copy.
+	f.exclude = &stringList{}
+	fs.Var(f.exclude, "exclude", "git glob to omit from the diff; repeatable")
+	f.outPath = fs.String("out", "findings.jsonl", "findings JSONL path, or - for stdout")
+	f.fresh = fs.Bool("fresh", false, "start a new review even if --out already exists")
+	f.decompose = fs.Bool("decompose", false, "use bounded scopes and aggregate coverage even below the automatic large-diff threshold")
+	f.model = fs.String("model", os.Getenv("UNREAL_HARNESS_LLM_MODEL"), "model id for the selected provider (UNREAL_HARNESS_LLM_PROVIDER, default openai)")
+	f.thinking = fs.String("thinking-level", "high", "low, medium, high, xhigh, or max")
+	f.strategy = fs.String("strategy", "single", "single or focused (four discovery passes plus verification)")
+	f.timeout = fs.Duration("timeout", 20*time.Minute, "timeout for the whole review")
+	f.agentLog = fs.String("agent-log", "", "optional path for the harness session JSONL log")
+	return f
+}
+
+func cmdRun(args []string) (err error) {
+	fs := flag.NewFlagSet("run", flag.ContinueOnError)
+	fs.SetOutput(os.Stderr)
+	f := registerRunFlags(fs)
+	if err := fs.Parse(args); err != nil {
+		return successOnHelp(err)
+	}
+	if *f.model == "" {
+		return fmt.Errorf("set --model or UNREAL_HARNESS_LLM_MODEL")
+	}
+	selection, err := providers.Select(providers.Default(), reviewGetenv)
+	if err != nil {
+		return err
+	}
+	openRouterAPI := os.Getenv("UNREAL_REVIEW_OPENROUTER_API")
+	if err := agent.RejectOpenRouterOverride(selection.Provider.Name, openRouterAPI); err != nil {
+		return err
+	}
+	level, err := agent.SanitizeLevel(*f.thinking)
+	if err != nil {
+		return err
+	}
+	selected := f.spec.spec()
+	selected.Pull = *f.pr
+	var resolver review.PullResolver
+	if *f.pr != "" {
+		resolver, err = newPullResolver(secret("GH_TOKEN"), *f.repo)
+		if err != nil {
+			return err
+		}
+	}
+	// The harness writes session JSONL only after it starts. Opening the file
+	// here would truncate an existing log when --strategy, the git range, or
+	// an empty diff fails first.
+	var logWriter io.Writer
+	if *f.agentLog != "" {
+		logFile := &agentLogFile{path: *f.agentLog}
+		defer func() { _ = logFile.Close() }() //nolint:errcheck // closing the agent log must not fail a successful review
+		logWriter = logFile
+	}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	reviewer, err := agent.ReviewPipeline(*f.strategy, agent.Harness{
+		APIKey: selection.APIKey, ThinkingLevel: level, Log: logWriter, Timeout: *f.timeout,
+		Provider: selection.Provider.Name, BaseURL: selection.BaseURL, Getenv: reviewGetenv,
+	})
+	if err != nil {
+		return err
+	}
+	sessionDir, err := defaultSessionDir()
+	if err != nil {
+		return err
+	}
+	report, err := review.Run(ctx, review.Options{
+		Workspace:     *f.workspace,
+		Spec:          selected,
+		Paths:         fs.Args(),
+		Exclude:       *f.exclude,
+		Out:           *f.outPath,
+		Fresh:         *f.fresh,
+		Decompose:     *f.decompose,
+		Model:         *f.model,
+		Pull:          resolver,
+		Agent:         reviewer,
+		SessionDir:    sessionDir,
+		OpenRouterAPI: openRouterAPI,
+	})
+	if (*f.outPath == "" || *f.outPath == "-") && report.Run != nil {
+		out, writeErr := openOut(*f.outPath)
+		if writeErr != nil {
+			return writeErr
+		}
+		defer func() { err = errors.Join(err, out.Close()) }()
+		if writeErr := findings.Write(out, report); writeErr != nil {
+			return writeErr
+		}
+	}
+	if report.Run != nil {
+		fmt.Fprintf(os.Stderr, "%s\n", formatRunCost(selection.Provider.Name, report.Run.Cost))
+		if report.Run.Status != "" && report.Run.Status != findings.StatusComplete {
+			fmt.Fprintf(os.Stderr, "status: %s\n", report.Run.Status)
+		}
+	}
+	return err
+}
+
+// formatRunCost prints a dollar amount only for OpenRouter. Other providers
+// leave amount_usd at 0 because they do not report a charge; the findings
+// schema is unchanged.
+func formatRunCost(providerName string, cost findings.Cost) string {
+	if providerName != "openrouter" {
+		return fmt.Sprintf("cost: unknown (provider %s does not report cost)", providerName)
+	}
+	return "cost: " + cost.Format()
+}
+
+const defaultSessionDirRel = ".local/state/unreal-agent/sessions"
+
+func defaultSessionDir() (string, error) {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return "", fmt.Errorf("find home directory: %w", err)
+	}
+	return filepath.Join(home, defaultSessionDirRel), nil
+}
+
+type stringList []string
+
+func (s *stringList) String() string {
+	return strings.Join(*s, ", ")
+}
+
+func (s *stringList) Set(value string) error {
+	if value == "" {
+		return fmt.Errorf("empty --exclude")
+	}
+	*s = append(*s, value)
+	return nil
+}
+
+// agentLogFile creates path on the first Write so a run that returns
+// before the harness leaves an existing log untouched.
+type agentLogFile struct {
+	path string
+	file *os.File
+}
+
+func (f *agentLogFile) Write(p []byte) (int, error) {
+	if f.file == nil {
+		file, err := os.Create(f.path)
+		if err != nil {
+			return 0, fmt.Errorf("agent log: %w", err)
+		}
+		f.file = file
+	}
+	return f.file.Write(p)
+}
+
+func (f *agentLogFile) Close() error {
+	if f.file == nil {
+		return nil
+	}
+	return f.file.Close()
+}
+
+func openOut(path string) (io.WriteCloser, error) {
+	if path == "" || path == "-" {
+		return nopWriteCloser{os.Stdout}, nil
+	}
+	file, err := os.Create(path)
+	if err != nil {
+		return nil, fmt.Errorf("create %s: %w", path, err)
+	}
+	return file, nil
+}
+
+type nopWriteCloser struct {
+	io.Writer
+}
+
+func (nopWriteCloser) Close() error { return nil }
