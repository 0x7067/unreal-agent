--- /dev/null
+++ b/cmd/internal/review/agent/shell.go
@@ -0,0 +1,35 @@
+package agent
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// confinedShell writes a /bin/sh wrapper in dir that gives the review shell an
+// empty HOME and XDG directories under dir, and drops the variables that point
+// tools at credentials. git's ssh loads no keys, because ssh finds them through
+// the passwd home, not HOME. gh, git and codex then find none of the user's
+// credentials. This is not a sandbox: the shell still runs as the user, a
+// direct ssh still loads the user's keys, and absolute paths stay readable.
+func confinedShell(dir string) (string, error) {
+	home := filepath.Join(dir, "home")
+	if err := os.MkdirAll(home, 0o700); err != nil {
+		return "", fmt.Errorf("create review shell home: %w", err)
+	}
+	script := "#!/bin/sh\n" +
+		"HOME='" + strings.ReplaceAll(home, "'", `'\''`) + "'\n" +
+		`XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share" XDG_STATE_HOME="$HOME/.local/state" XDG_CACHE_HOME="$HOME/.cache"` + "\n" +
+		"export HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME\n" +
+		"unset CODEX_HOME GH_CONFIG_DIR GNUPGHOME SSH_AUTH_SOCK GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_ASKPASS SSH_ASKPASS\n" +
+		"GIT_SSH_COMMAND='ssh -F /dev/null -o IdentityFile=none -o IdentitiesOnly=yes'\n" +
+		"GIT_CONFIG_NOSYSTEM=1\n" +
+		"export GIT_SSH_COMMAND GIT_CONFIG_NOSYSTEM\n" +
+		`exec /bin/sh "$@"` + "\n"
+	path := filepath.Join(dir, "sh")
+	if err := os.WriteFile(path, []byte(script), 0o700); err != nil {
+		return "", fmt.Errorf("write review shell: %w", err)
+	}
+	return path, nil
+}
diff --git a/cmd/internal/review/agent/strategy.go b/cmd/internal/review/agent/strategy.go
new file mode 100644
index 0000000..dc93f0d
--- /dev/null
+++ b/cmd/internal/review/agent/strategy.go
@@ -0,0 +1,71 @@
+package agent
+
+import (
+	"fmt"
+	"io"
+	"strings"
+	"sync"
+
+	review "github.com/unreallabsai/unreal-agent/cmd/internal/review/core"
+)
+
+// plannedMaxBashCalls bounds evidence gathering in each planned discovery or
+// verification Run while leaving direct reviews unlimited. Consolidation only
+// compares confirmed records and has Bash disabled.
+const plannedMaxBashCalls = 32
+
+// Reviewer selects an adapter strategy without changing the review product.
+func Reviewer(strategy string, harness Harness) (review.Agent, error) {
+	switch strings.TrimSpace(strategy) {
+	case "single":
+		return harness, nil
+	case "focused":
+		return Focused{Agent: harness, Config: harness.ThinkingLevel}, nil
+	default:
+		return nil, fmt.Errorf("strategy %q: want single or focused", strategy)
+	}
+}
+
+// ReviewPipeline adds automatic coverage-gated execution when Review supplies
+// a source plan. Ordinary inputs still use the selected strategy unchanged.
+func ReviewPipeline(strategy string, harness Harness) (review.Agent, error) {
+	if harness.Log != nil {
+		harness.Log = &serializedWriter{writer: harness.Log}
+	}
+	harness.MaxBashCalls = 0
+	direct, err := Reviewer(strategy, harness)
+	if err != nil {
+		return nil, err
+	}
+	budgeted := harness
+	budgeted.MaxBashCalls = plannedMaxBashCalls
+	consolidator := harness
+	consolidator.MaxBashCalls = -1
+	plannedDiscovery, err := Reviewer(strategy, budgeted)
+	if err != nil {
+		return nil, err
+	}
+	parallel := 4
+	if focused, ok := plannedDiscovery.(Focused); ok {
+		focused.DiscoveryOnly = true
+		plannedDiscovery = focused
+		parallel = 2 // Each focused child already fans out across four lenses.
+	}
+	return Planned{
+		Direct: direct, Agent: plannedDiscovery, Verifier: budgeted, Consolidator: consolidator, Timeout: harness.Timeout,
+		Config: fmt.Sprintf("%s/%s/bash=%d", strings.TrimSpace(strategy), harness.ThinkingLevel, plannedMaxBashCalls), Parallel: parallel,
+	}, nil
+}
+
+// Focused runs and parallel passes may share one log. Keep each observer
+// write intact rather than interleaving JSON lines from independent sessions.
+type serializedWriter struct {
+	mu     sync.Mutex
+	writer io.Writer
+}
+
+func (w *serializedWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.writer.Write(p)
+}
