+func runReviewOut(t *testing.T, logPath string, args ...string) (string, error) {
+	t.Helper()
+	out := filepath.Join(t.TempDir(), "findings.jsonl")
+	err := run(append([]string{
+		"run",
+		"--model", "test-model",
+		"--thinking-level", "low",
+		"--agent-log", logPath,
+		"--timeout", "45s",
+		"--out", out,
+	}, args...))
+	return out, err
+}
