+		}
+		i += n
+	}
+	return len(value)
+}
+
+func safeSGR(sequence string) bool {
+	return strings.HasPrefix(sequence, "\x1b[") && strings.HasSuffix(sequence, "m") &&
+		strings.Trim(sequence[2:len(sequence)-1], "0123456789;:") == ""
