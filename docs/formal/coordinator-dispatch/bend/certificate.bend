    case S205{}: P.Core{P.Idle{}, P.One{}, True{}, P.Snapshots{P.Awaiting{}, P.Terminal{}}, P.Snapshots{P.Awaiting{}, P.Terminal{}}, True{}, P.Flags{True{}, False{}}, False{}, False{}}
    case S206{}: P.Core{P.Idle{}, P.One{}, True{}, P.Snapshots{P.Terminal{}, P.Terminal{}}, P.Snapshots{P.Terminal{}, P.Terminal{}}, True{}, P.Flags{True{}, False{}}, False{}, False{}}
    case S207{}: P.Core{P.Idle{}, P.End{}, True{}, P.Snapshots{P.Awaiting{}, P.Awaiting{}}, P.Snapshots{P.Awaiting{}, P.Awaiting{}}, True{}, P.Flags{True{}, True{}}, False{}, False{}}
    case S208{}: P.Core{P.AppendUpdate{}, P.One{}, True{}, P.Snapshots{P.Awaiting{}, P.Terminal{}}, P.Snapshots{P.Terminal{}, P.Terminal{}}, True{}, P.Flags{True{}, False{}}, False{}, False{}}
    case S209{}: P.Core{P.AppendUpdate{}, P.Two{}, True{}, P.Snapshots{P.Terminal{}, P.Awaiting{}}, P.Snapshots{P.Terminal{}, P.Terminal{}}, True{}, P.Flags{False{}, True{}}, False{}, False{}}
    case S210{}: P.Core{P.Stopped{}, P.One{}, True{}, P.Snapshots{P.Awaiting{}, P.Terminal{}}, P.Snapshots{P.Terminal{}, P.Terminal{}}, True{}, P.Flags{True{}, False{}}, False{}, False{}}
    case S211{}: P.Core{P.Stopped{}, P.Two{}, True{}, P.Snapshots{P.Terminal{}, P.Awaiting{}}, P.Snapshots{P.Terminal{}, P.Terminal{}}, True{}, P.Flags{False{}, True{}}, False{}, False{}}

# Explicit finite relational invariant on unrestricted Core records.
def Invariant(s: P.Core) -> Type:
  &i: Index -> {decode(i) == s : P.Core}
