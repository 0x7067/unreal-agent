def closure(e: P.Boundary, i: C.Index) -> C.Invariant(P.next(P.fixed(), e, C.decode(i))):
  match e:
    case P.Tick{}: edgeTick(i)
    case P.StatusInvisible{}: edgeStatusInvisible(i)
    case P.StatusVisible{}: edgeStatusVisible(i)
    case P.UpdateOneAwaiting{}: edgeUpdateOneAwaiting(i)
    case P.UpdateOneTerminal{}: edgeUpdateOneTerminal(i)
    case P.UpdateTwoAwaiting{}: edgeUpdateTwoAwaiting(i)
    case P.UpdateTwoTerminal{}: edgeUpdateTwoTerminal(i)
    case P.UpdateInvisible{}: edgeUpdateInvisible(i)
    case P.UpdateVisible{}: edgeUpdateVisible(i)
    case P.Crash{}: edgeCrash(i)
    case P.Stutter{}: edgeStutter(i)

